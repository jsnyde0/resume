#!/usr/bin/env bash
# drive — run one mapped feature drive and capture its evidence.
#
# Usage: scripts/drive [file-tree]
#
# Resolves the shared engine, then hands off. The drive itself is JS because it
# compares structured before/after state; the shell's job is resolution.

source "$(dirname "${BASH_SOURCE[0]}")/_common"

feature="${1:-file-tree}"

VR_ENGINE="$(vr_engine_or_die)" || exit 1
export VR_ENGINE VR_URL VR_EVIDENCE

if ! curl -sf -o /dev/null "$VR_URL/"; then
  echo "FAIL: nothing answering at $VR_URL — run scripts/launch first." >&2
  exit 1
fi

mkdir -p "$VR_EVIDENCE"

case "$feature" in
  file-tree) exec node "$VR_SCRIPT_DIR/drive-file-tree.mjs" ;;
  *)
    echo "FAIL: unknown feature '$feature'. Mapped drives: file-tree" >&2
    echo "      Features documented but not yet driven are listed in references/README.md." >&2
    exit 1
    ;;
esac
