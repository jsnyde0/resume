#!/usr/bin/env bash
# cleanup — stop only what launch started. Evidence survives.
#
# Nothing here deletes $VR_EVIDENCE. A cleanup that removes the artifact
# defeats the point of capturing it: the run's whole claim is that the evidence
# is still at its named path afterwards.

source "$(dirname "${BASH_SOURCE[0]}")/_common"

if [ ! -f "$VR_STATE" ]; then
  echo "cleanup: no launch state at $VR_STATE — nothing was started by this skill."
  exit 0
fi

# shellcheck disable=SC1090
pid="$(sed -n 's/^pid=//p' "$VR_STATE")"
port="$(sed -n 's/^port=//p' "$VR_STATE")"

if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
  kill "$pid" 2>/dev/null || true
  echo "cleanup: stopped preview server pid $pid"
else
  echo "cleanup: pid ${pid:-unknown} was not running"
fi

# Backstop: npm spawns a child node process, so killing the npm pid can orphan
# the actual listener. The port is this skill's own (non-default, recorded at
# launch), so whatever still holds it is ours.
if [ -n "${port:-}" ] && command -v lsof >/dev/null 2>&1; then
  for p in $(lsof -ti "tcp:$port" 2>/dev/null || true); do
    kill "$p" 2>/dev/null || true
    echo "cleanup: stopped orphaned listener pid $p on port $port"
  done
fi

rm -f "$VR_STATE"
echo "cleanup: done. Evidence left in place at $VR_EVIDENCE"
