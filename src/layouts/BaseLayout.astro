---
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jonatan Snyders' Resume",
  description = "Jonatan Snyders' Resume Website",
} = Astro.props;

const year = new Date().getFullYear();
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en" data-theme="retro">
  <head>
    <meta charset="utf-8" />
    <!-- deploy: github-actions (resume-cs5) -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="keywords"
      content="Jonatan, Snyders, Resume, Website, Software, Developer, Python, Django, HTML, CSS, JavaScript, React, Machine Learning, AI, Data Science"
    />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/png" href="/img/avatar_jonatan_tongue.png" />
    <title>{title}</title>
    {/* Display font (Schibsted Grotesk, self-hosted; @font-face in tokens.css). Preloaded on every page
         so the gate below settles fast. Pages opt in to the gate with [data-font-gate]. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/schibsted-grotesk-latin-wght.woff2" crossorigin />
    {/* Font gate. Contract: docs/design-system.md "Font gate". html gets `fonts-ready` once
         document.fonts.load() resolves a loaded face for weights 400 and 900 (one variable file), or
         `fonts-failed` if the load rejects, no face is declared by `load`, or the timeout passes first.
         The timeout is exposed as html[data-font-gate-timeout] so the verify drive reads one source. */}
    <script is:inline>
      (function () {
        var GATE_TIMEOUT_MS = 3000;
        var html = document.documentElement;
        html.setAttribute('data-font-gate-timeout', String(GATE_TIMEOUT_MS));
        var settled = false;
        function settle(cls) {
          if (settled) return;
          settled = true;
          html.classList.add(cls);
        }
        setTimeout(function () { settle('fonts-failed'); }, GATE_TIMEOUT_MS);
        if (!document.fonts || !document.fonts.load) { settle('fonts-failed'); return; }
        // The @font-face rule lives in a stylesheet that may be parsed after this script, and
        // load() on a not-yet-declared family resolves to []. So try now, again once the document
        // is parsed, and once more at `load`; an empty result only counts as failure at `load`.
        function attempt(final) {
          Promise.all([
            document.fonts.load('400 1em "Schibsted Grotesk"'),
            document.fonts.load('900 1em "Schibsted Grotesk"')
          ]).then(function (faces) {
            if (faces[0].length && faces[1].length) settle('fonts-ready');
            else if (final) settle('fonts-failed');
          }, function () { settle('fonts-failed'); });
        }
        attempt(false);
        document.addEventListener('DOMContentLoaded', function () { attempt(false); });
        window.addEventListener('load', function () { attempt(true); });
      })();
    </script>
    <style is:global>
      /* Font gate: opted-in elements stay hidden until the face is loaded or the gate gives up. */
      html:not(.fonts-ready):not(.fonts-failed) [data-font-gate] { visibility: hidden; }
    </style>
    <noscript><style>html [data-font-gate] { visibility: visible !important; }</style></noscript>
    <style is:global>
      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        background: var(--base-100);
        color: var(--base-content);
        font-family: var(--font-body);
        line-height: var(--line-height-body);
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; text-decoration: none; }

      .site-shell {
        width: min(100% - var(--space-8), var(--container-site));
        margin: var(--space-4) auto 0;
      }

      .navbar {
        background: var(--base-100);
      }

      .navbar-inner {
        max-width: var(--container-site);
        margin: 0 auto;
        padding: var(--space-4);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        flex-wrap: wrap;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        font-size: var(--text-xl);
        font-weight: 600;
        white-space: nowrap;
      }

      .brand img {
        width: 3rem;
        height: 3rem;
        object-fit: contain;
      }

      .menu-button {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        padding: var(--space-2);
        border: 0;
        border-radius: var(--radius-sm);
        color: var(--base-content);
        background: transparent;
      }

      .menu-button svg {
        width: 1.25rem;
        height: 1.25rem;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: var(--space-8);
        margin: 0;
        padding: 0;
        list-style: none;
        font-weight: 500;
      }

      .nav-links a {
        display: block;
        border-radius: var(--radius-sm);
        padding: var(--space-2) var(--space-3);
        transition: color var(--transition-base), background var(--transition-base);
      }

      .nav-links a:hover {
        color: var(--primary);
      }

      main {
        min-height: calc(100vh - 10rem);
        padding: var(--space-10) var(--space-4) var(--space-4);
      }

      .page-section {
        background: var(--base-100);
      }

      .content-container {
        width: min(100%, var(--container-site));
        margin: 0 auto;
        padding: var(--space-8) 0;
      }

      .home-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-content: center;
        max-width: var(--container-site);
        min-height: calc(100svh - 14 * var(--space-4));
        margin: 0 auto;
      }

      .hero-grid {
        display: grid;
        width: 100%;
        margin: 0 auto;
        padding: var(--space-4) 0 var(--space-8);
        gap: var(--space-6);
        align-items: center;
      }

      .hero-copy h1 {
        max-width: var(--container-prose);
        margin: 0 0 var(--space-5);
        color: var(--content-bright);
        font-size: var(--text-hero);
        line-height: 0.95;
        letter-spacing: -0.045em;
        font-weight: 800;
        text-wrap: balance;
      }

      .hero-copy p {
        max-width: 28ch;
        margin: 0 0 var(--space-10);
        color: var(--base-content);
        font-size: var(--text-hero-lead);
        line-height: var(--line-height-body);
        font-weight: 400;
        text-wrap: balance;
      }

      .hero-actions {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        border-radius: var(--radius-sm);
        padding: var(--space-3) var(--space-5);
        font-size: var(--text-base);
        font-weight: 500;
        text-align: center;
        transition: background var(--transition-base), border-color var(--transition-base);
      }

      .button-primary {
        background: var(--primary);
        color: var(--primary-content);
      }

      .button-primary:hover { background: var(--primary-focus); }

      .button-secondary {
        background: var(--base-200);
        border: 1px solid var(--tooltip-bg);
      }

      .button-secondary:hover { background: var(--base-300); }

      .button svg {
        width: 1.25rem;
        height: 1.25rem;
      }

      .hero-actions .button {
        min-height: 3rem;
        padding: var(--space-3) var(--space-6);
        border-radius: var(--radius-button);
        font-weight: 600;
        letter-spacing: -0.005em;
        transition:
          background var(--transition-base),
          border-color var(--transition-base),
          color var(--transition-base),
          transform var(--transition-base);
      }

      .hero-actions .button-secondary {
        border-color: var(--border-subtle);
        background: transparent;
        color: var(--base-content);
        font-weight: 500;
      }

      .hero-actions .button-secondary:hover {
        border-color: var(--base-content);
        background: var(--surface-subtle);
        color: var(--content-bright);
      }

      .hero-actions .button svg {
        transition: transform var(--transition-base);
      }

      .hero-actions .button:hover svg { transform: translateX(var(--space-1)); }
      .hero-actions .button:active { transform: translateY(1px); }

      .hero-actions .button:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: var(--space-1);
      }

      .hero-image {
        display: flex;
        justify-content: center;
      }

      .hero-image img {
        width: 100%;
        max-width: 22rem;
        height: auto;
        display: block;
      }

      .site-footer {
        background: var(--base-100);
      }

      .footer-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding: var(--space-6);
      }

      .footer-social {
        display: flex;
        align-items: center;
        gap: var(--space-4);
      }

      .footer-social p {
        margin: 0;
        padding-right: var(--space-2);
        font-size: var(--text-sm);
      }

      .social-link {
        display: inline-flex;
        color: var(--base-content);
        opacity: 0.95;
        transition: color var(--transition-base);
      }

      .social-link:hover { color: var(--primary); }

      .social-link svg {
        width: 1.25rem;
        height: 1.25rem;
        fill: currentColor;
      }

      @media (max-width: 767px) {
        .menu-button { display: inline-flex; }
        .nav-links { display: none; }
        .nav-links.is-open {
          display: flex;
          width: 100%;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          margin-top: var(--space-4);
          padding: var(--space-4);
          border: 1px solid var(--base-300);
          border-radius: var(--radius-sm);
          background: var(--base-200);
        }
        .nav-links.is-open a:hover { background: var(--base-100); }
      }

      @media (min-width: 640px) {
        .hero-actions { flex-direction: row; }
        .footer-inner { flex-direction: row; }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-actions .button,
        .hero-actions .button svg { transition: none; }
        .hero-actions .button:hover svg,
        .hero-actions .button:active { transform: none; }
      }

      @media (min-width: 1024px) {
        .hero-grid {
          grid-template-columns: repeat(12, minmax(0, 1fr));
          padding: var(--space-8) var(--space-8);
          gap: var(--space-8);
        }
        .hero-copy { grid-column: span 6 / span 6; }
        .hero-image {
          grid-column: span 6 / span 6;
          justify-content: flex-start;
        }
        .hero-image img { max-width: 30rem; }
      }
    </style>
  </head>
  <body>
    <div class="site-shell">
      <nav class="navbar" aria-label="Primary navigation">
        <div class="navbar-inner">
          <a href="/" class="brand">
            <img src="/img/avatar_jonatan_tongue.png" alt="Jonatan Snyders avatar" />
            <span>Jonatan Snyders</span>
          </a>
          <button class="menu-button" type="button" aria-label="Open main menu" aria-controls="navbar-default" aria-expanded="false" data-menu-button>
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"></path>
            </svg>
          </button>
          <ul class="nav-links" id="navbar-default" data-nav-links>
            <li><a href="/resume/">Resume</a></li>
            <li><a href="/readme/">README</a></li>
            <li><a href="/projects/">Building</a></li>
          </ul>
        </div>
      </nav>

      <main>
        <section class="page-section">
          <div class="content-container">
            <slot />
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <span class="footer-spacer" aria-hidden="true"></span>
          <div class="footer-social">
            <p>© Copyright {year}. All Rights Reserved.</p>
            <a href="https://www.linkedin.com/in/jonatan-snyders/" class="social-link" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"></path>
              </svg>
            </a>
            <a href="https://github.com/jsnyde0/" class="social-link" aria-label="Github">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12.026 2C7.13295 1.99937 2.96183 5.54799 2.17842 10.3779C1.395 15.2079 4.23061 19.893 8.87302 21.439C9.37302 21.529 9.55202 21.222 9.55202 20.958C9.55202 20.721 9.54402 20.093 9.54102 19.258C6.76602 19.858 6.18002 17.92 6.18002 17.92C5.99733 17.317 5.60459 16.7993 5.07302 16.461C4.17302 15.842 5.14202 15.856 5.14202 15.856C5.78269 15.9438 6.34657 16.3235 6.66902 16.884C6.94195 17.3803 7.40177 17.747 7.94632 17.9026C8.49087 18.0583 9.07503 17.99 9.56902 17.713C9.61544 17.207 9.84055 16.7341 10.204 16.379C7.99002 16.128 5.66202 15.272 5.66202 11.449C5.64973 10.4602 6.01691 9.5043 6.68802 8.778C6.38437 7.91731 6.42013 6.97325 6.78802 6.138C6.78802 6.138 7.62502 5.869 9.53002 7.159C11.1639 6.71101 12.8882 6.71101 14.522 7.159C16.428 5.868 17.264 6.138 17.264 6.138C17.6336 6.97286 17.6694 7.91757 17.364 8.778C18.0376 9.50423 18.4045 10.4626 18.388 11.453C18.388 15.286 16.058 16.128 13.836 16.375C14.3153 16.8651 14.5612 17.5373 14.511 18.221C14.511 19.555 14.499 20.631 14.499 20.958C14.499 21.225 14.677 21.535 15.186 21.437C19.8265 19.8884 22.6591 15.203 21.874 10.3743C21.089 5.54565 16.9181 1.99888 12.026 2Z"></path>
              </svg>
            </a>
          </div>
        </div>
      </footer>
    </div>
    <script>
      const button = document.querySelector('[data-menu-button]');
      const navLinks = document.querySelector('[data-nav-links]');

      button?.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isExpanded));
        navLinks?.classList.toggle('is-open', !isExpanded);
      });
    </script>
  </body>
</html>
