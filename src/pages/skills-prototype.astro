---
import BaseLayout from '../layouts/BaseLayout.astro';

// --- prototype-local data ---
const agentSkills = [
  { name: 'Product', icon: '🎯', color: '#ff7f50', desc: 'Vision → MVP → iteration loops' },
  { name: 'Code', icon: '⚡', color: '#8b5cf6', desc: 'Full-stack + AI-assisted velocity' },
  { name: 'Data', icon: '📊', color: '#22c55e', desc: 'Pipelines, models, decisions' },
  { name: 'Learning', icon: '🧠', color: '#38bdf8', desc: 'Autodidact, fast skill transfer' },
  { name: 'Growth', icon: '🚀', color: '#f472b6', desc: 'Experiments, CRO, scale' },
];

const cockpitModules = [
  { label: 'Product', status: 'active', value: '3 MVPs shipped' },
  { label: 'Code', status: 'active', value: 'Async/Django/HTMX' },
  { label: 'Data', status: 'active', value: 'Bayesian MMM live' },
  { label: 'Learning', status: 'idle', value: 'Next: Rust' },
  { label: 'Growth', status: 'active', value: '6-fig rev engine' },
];



const repoTree = [
  {
    folder: 'agentic-engineering',
    files: [
      { name: 'harness-factory.md', selected: true, count: '6 refs' },
      { name: 'parallel-agent-loops.md', selected: false, count: '4 refs' },
      { name: 'codebase-design.md', selected: false, count: '5 refs' },
    ],
  },
  {
    folder: 'growth-loops',
    files: [
      { name: 'product-wedges.md', selected: false, count: '3 refs' },
      { name: 'experiment-cadence.md', selected: false, count: '7 refs' },
      { name: 'bayesian-mmm.md', selected: false, count: '4 refs' },
    ],
  },
  {
    folder: 'learning-frontier',
    files: [
      { name: 'rapid-skill-transfer.md', selected: false, count: '5 refs' },
      { name: 'frontier-tools.md', selected: false, count: '8 refs' },
    ],
  },
  {
    folder: 'proof',
    files: [
      { name: 'meshmonk.md', selected: false, count: '140+ citations' },
      { name: 'moonbird-revenue-engine.md', selected: false, count: '6-fig rev' },
      { name: 'humainly-ops.md', selected: false, count: '30 people' },
    ],
  },
];

const repoLinks = [
  'agentic-engineering/codebase-design.md',
  'growth-loops/bayesian-mmm.md',
  'growth-loops/product-wedges.md',
  'learning-frontier/frontier-tools.md',
  'proof/moonbird-revenue-engine.md',
  'proof/meshmonk.md',
];

const finderItems = [
  { name: 'Agentic Engineering', type: 'folder', children: [
    { name: 'Self-built harnesses', type: 'file' },
    { name: 'Substrate architecture', type: 'file' },
    { name: 'Parallel agents', type: 'file' },
  ]},
  { name: 'Multipliers', type: 'folder', children: [
    { name: 'Product velocity', type: 'file' },
    { name: 'Code throughput', type: 'file' },
    { name: 'Data leverage', type: 'file' },
    { name: 'Learning loops', type: 'file' },
    { name: 'Growth experiments', type: 'file' },
  ]},
  { name: 'Outcomes', type: 'folder', children: [
    { name: '3 web apps in 3 months', type: 'file' },
    { name: 'MeshMonk: 140+ citations', type: 'file' },
    { name: 'Humainly: 30 people supported', type: 'file' },
  ]},
];
---

<BaseLayout title="Skills Prototype (throwaway)" description="Local prototype for Skills section concepts.">
  <div class="proto-page">
    <div class="proto-banner">
      <span class="proto-badge">🚧 THROWAWAY / LOCAL PROTOTYPE ONLY</span>
      <p class="proto-subtitle">Exploring a Skills section that communicates agentic engineering as a force-multiplier across product, code, data, learning, and growth.</p>
    </div>

    <!-- === CONCEPT 1: FLYWHEEL === -->
    <section class="proto-section">
      <div class="proto-section__header">
        <h2 class="proto-section__title">Concept 1: Flywheel</h2>
        <p class="proto-section__blurb">Each capability feeds the next. Agentic engineering accelerates the loop.</p>
      </div>
      <div class="flywheel">
        <div class="flywheel__ring">
          {agentSkills.map((skill, i) => (
            <div class="flywheel__node" style={`--i:${i};--n:${agentSkills.length};--hue:${skill.color}`}>
              <div class="flywheel__icon">{skill.icon}</div>
              <div class="flywheel__name">{skill.name}</div>
            </div>
          ))}
        </div>
        <div class="flywheel__center">
          <div class="flywheel__center-label">Agentic<br/>Engineering</div>
        </div>
      </div>
      <div class="flywheel__caption">
        Self-built agent harnesses multiply capability across every domain — not additive, <strong>multiplicative</strong>.
      </div>
    </section>

    <!-- === CONCEPT 2: COCKPIT / CONTROL PANEL === -->
    <section class="proto-section">
      <div class="proto-section__header">
        <h2 class="proto-section__title">Concept 2: Cockpit / Control Panel</h2>
        <p class="proto-section__blurb">A live dashboard view of capability status across all domains.</p>
      </div>
      <div class="cockpit">
        {cockpitModules.map((mod) => (
          <div class:list={['cockpit__module', `cockpit__module--${mod.status}`]}>
            <div class="cockpit__status-dot"></div>
            <div class="cockpit__label">{mod.label}</div>
            <div class="cockpit__value">{mod.value}</div>
          </div>
        ))}
      </div>
      <div class="cockpit__legend">
        <span class="cockpit__legend-dot cockpit__legend-dot--active"></span> Active
        <span class="cockpit__legend-dot cockpit__legend-dot--idle"></span> Standby
      </div>
      <div class="cockpit__caption">
        Every module hot-swappable. Agent harnesses let me spin up new capabilities in days, not quarters.
      </div>
    </section>

    <!-- === CONCEPT 3: FINDER / COMPOSABLE SKILL SYSTEM === -->
    <section class="proto-section">
      <div class="proto-section__header">
        <h2 class="proto-section__title">Concept 3: Finder / Composable Skill System</h2>
        <p class="proto-section__blurb">Skills as a hierarchical, composable system — double-click to drill in.</p>
      </div>
      <div class="finder">
        <div class="finder__toolbar">
          <span class="finder__btn">←</span>
          <span class="finder__path">Skills / Agentic Engineering</span>
        </div>
        <div class="finder__grid">
          {finderItems.map((item) => (
            <div class="finder__item">
              <div class="finder__icon">{item.type === 'folder' ? '📁' : '📄'}</div>
              <div class="finder__name">{item.name}</div>
              <div class="finder__meta">{item.children ? `${item.children.length} items` : 'skill'}</div>
            </div>
          ))}
        </div>
      </div>
      <div class="finder__caption">
        A composable skill system: folder-like domains containing concrete, provable outcomes. The harness itself is just another folder.
      </div>
    </section>

    <!-- === CONCEPT 4: SKILLS REPOSITORY BROWSER === -->
    <section class="proto-section proto-section--repo">
      <div class="proto-section__header proto-section__header--repo">
        <div>
          <h2 class="proto-section__title">Concept 4: Skills Repository Browser</h2>
          <p class="proto-section__blurb">A GitHub-inspired personal skills repo: composable capabilities as searchable markdown files with visible dependencies.</p>
        </div>
        <span class="repo-proto-pill">prototype-only · not /resume/</span>
      </div>

      <div class="repo-browser" aria-label="Prototype skills repository browser">
        <div class="repo-browser__topbar">
          <div class="repo-browser__crumbs">
            <span>jonatan</span><span>/</span><strong>personal-skills</strong><span>/</span><strong>agentic-engineering</strong>
          </div>
          <label class="repo-browser__search">
            <span>⌘K</span>
            <input type="text" value="Go to file: harness-factory.md" aria-label="Prototype go to file search" readonly />
          </label>
        </div>

        <div class="repo-browser__meta">
          <span>main</span>
          <span>12 skill files</span>
          <span>4 folders</span>
          <span>active file: <code>agentic-engineering/harness-factory.md</code></span>
        </div>

        <div class="repo-browser__body">
          <aside class="repo-tree" aria-label="Repository file tree">
            <div class="repo-tree__heading">Files</div>
            {repoTree.map((group) => (
              <div class="repo-tree__group">
                <div class="repo-tree__folder"><span>▾</span><span>📁 {group.folder}</span></div>
                <div class="repo-tree__files">
                  {group.files.map((file) => (
                    <div class:list={['repo-tree__file', file.selected && 'repo-tree__file--selected']}>
                      <span class="repo-tree__file-icon">📄</span>
                      <span class="repo-tree__file-name">{file.name}</span>
                      <span class="repo-tree__file-count">{file.count}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </aside>

          <article class="repo-preview" aria-label="Markdown skill preview">
            <header class="repo-preview__header">
              <div>
                <div class="repo-preview__path">agentic-engineering / <strong>harness-factory.md</strong></div>
                <h3>Harness Factory</h3>
              </div>
              <span class="repo-preview__badge">selected .md preview</span>
            </header>

            <div class="repo-preview__frontmatter" aria-label="Skill metadata">
              <div><span>status</span><strong>active / compounding</strong></div>
              <div><span>kind</span><strong>factory-building skill</strong></div>
              <div><span>interfaces</span><strong>code · product · data · growth</strong></div>
              <div><span>evidence</span><strong>Astro, Django, pipelines, agent substrate</strong></div>
            </div>

            <div class="repo-markdown">
              <h4>## What this skill does</h4>
              <p>Turns ambiguous startup work into inspectable systems: repo structure, test harnesses, agent prompts, review loops, and enough UI to let humans steer without losing velocity.</p>

              <h4>## Composes with</h4>
              <ul>
                <li><strong>Agentic engineering</strong> — parallel agents, code review loops, and context-preserving decomposition.</li>
                <li><strong>Codebase design / deep modules</strong> — naming, boundaries, acceptance contracts, and source-of-truth docs.</li>
                <li><strong>Growth loops</strong> — experiment surfaces, funnel instrumentation, CRO, and revenue learning cycles.</li>
                <li><strong>Bayesian MMM / data</strong> — pipelines, model diagnostics, dashboardable decisions.</li>
                <li><strong>Product wedges</strong> — small credible slices that prove a market before scaling a platform.</li>
                <li><strong>Learning frontier tools</strong> — fast adoption of new frameworks and AI workflows when the bottleneck moves.</li>
              </ul>

              <h4>## Usage notes</h4>
              <p>Best for zero-to-one builds where the deliverable is both the product and the machine that keeps improving it. Not a static skills list — it is a repo of reusable capability modules.</p>
            </div>

            <div class="repo-preview__refs" aria-label="Cross references">
              <span>Cross-references</span>
              {repoLinks.map((link) => <a href="#" aria-label={`Prototype cross reference to ${link}`}>{link}</a>)}
            </div>
          </article>
        </div>
      </div>
      <div class="repo-browser__caption">
        Stronger than a folder metaphor alone: technical readers can scan paths, open concrete `.md` files, and see how skills import each other into a practical startup-building toolkit.
      </div>
    </section>

  </div>

  <style>
    /* ========== SHARED PROTOTYPE SCAFFOLDING ========== */
    .proto-page {
      width: min(100%, 64rem);
      margin: 0 auto;
      padding: 0 0 3rem;
    }

    .proto-banner {
      text-align: center;
      margin-bottom: 2.5rem;
      padding: 1.25rem;
      border: 2px dashed rgba(255, 127, 80, 0.45);
      border-radius: 1rem;
      background: rgba(255, 127, 80, 0.06);
    }

    .proto-badge {
      display: inline-block;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      background: #ff7f50;
      color: #0b1116;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .proto-subtitle {
      margin: 0.75rem 0 0;
      color: var(--muted-content);
      font-size: 0.95rem;
      line-height: 1.45;
    }

    .proto-section {
      margin-bottom: 3rem;
      padding: 1.5rem;
      border: 1px solid rgba(171, 196, 220, 0.10);
      border-radius: 1.25rem;
      background: var(--base-200);
      box-shadow: 0 12px 30px rgba(0,0,0,0.22);
    }

    .proto-section__header {
      margin-bottom: 1.25rem;
    }

    .proto-section__title {
      margin: 0 0 0.35rem;
      font-size: 1.35rem;
      color: #f2f7fb;
    }

    .proto-section__blurb {
      margin: 0;
      color: var(--muted-content);
      font-size: 0.92rem;
    }

    /* ========== CONCEPT 1: FLYWHEEL ========== */
    .flywheel {
      position: relative;
      width: min(100%, 28rem);
      aspect-ratio: 1 / 1;
      margin: 1.5rem auto;
    }

    .flywheel__ring {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px dashed rgba(255, 255, 255, 0.12);
      animation: flywheelSpin 32s linear infinite;
    }

    @keyframes flywheelSpin {
      to { transform: rotate(360deg); }
    }

    .flywheel__node {
      position: absolute;
      top: 50%;
      left: 50%;
      --r: 11.5rem;           /* orbit radius */
      --angle: calc(360deg / var(--n) * var(--i) - 90deg);
      transform:
        translate(-50%, -50%)
        rotate(var(--angle))
        translateY(calc(var(--r) * -1))
        rotate(calc(var(--angle) * -1));
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      text-align: center;
      width: 5.5rem;
    }

    .flywheel__icon {
      width: 3rem;
      height: 3rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--hue);
      font-size: 1.25rem;
      box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }

    .flywheel__name {
      font-size: 0.78rem;
      font-weight: 600;
      color: #f2f7fb;
    }

    .flywheel__center {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      pointer-events: none;
    }

    .flywheel__center-label {
      width: 7rem;
      height: 7rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #1a2a32, #0c171d);
      border: 2px solid rgba(255, 127, 80, 0.35);
      color: #ff7f50;
      font-size: 0.82rem;
      font-weight: 700;
      text-align: center;
      line-height: 1.3;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      box-shadow: 0 0 40px rgba(255, 127, 80, 0.12);
    }

    .flywheel__caption {
      text-align: center;
      color: var(--muted-content);
      font-size: 0.92rem;
      max-width: 32rem;
      margin: 0 auto;
      line-height: 1.5;
    }

    /* ========== CONCEPT 2: COCKPIT ========== */
    .cockpit {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .cockpit__module {
      position: relative;
      padding: 1rem;
      border-radius: 0.9rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(171, 196, 220, 0.10);
      transition: transform 160ms ease, border-color 160ms ease;
    }

    .cockpit__module:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 127, 80, 0.35);
    }

    .cockpit__status-dot {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 50%;
      background: #64748b;
    }

    .cockpit__module--active .cockpit__status-dot {
      background: #22c55e;
      box-shadow: 0 0 8px rgba(34, 197, 94, 0.45);
    }

    .cockpit__module--idle .cockpit__status-dot {
      background: #f59e0b;
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.35);
    }

    .cockpit__label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted-content);
      margin-bottom: 0.35rem;
    }

    .cockpit__value {
      font-size: 0.92rem;
      font-weight: 600;
      color: #f2f7fb;
      line-height: 1.35;
    }

    .cockpit__legend {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.82rem;
      color: var(--muted-content);
      margin-bottom: 0.85rem;
    }

    .cockpit__legend-dot {
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 50%;
      margin-left: 0.5rem;
    }

    .cockpit__legend-dot--active { background: #22c55e; }
    .cockpit__legend-dot--idle { background: #f59e0b; }

    .cockpit__caption {
      color: var(--muted-content);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    /* ========== CONCEPT 3: FINDER ========== */
    .finder {
      border-radius: 0.9rem;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(171, 196, 220, 0.10);
      overflow: hidden;
    }

    .finder__toolbar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.65rem 1rem;
      background: rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid rgba(171, 196, 220, 0.08);
      font-size: 0.85rem;
    }

    .finder__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 0.35rem;
      background: rgba(255, 255, 255, 0.06);
      font-size: 0.75rem;
    }

    .finder__path {
      color: var(--muted-content);
    }

    .finder__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
      gap: 1rem;
      padding: 1rem;
    }

    .finder__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      padding: 1rem 0.5rem;
      border-radius: 0.65rem;
      transition: background 160ms ease;
      cursor: default;
    }

    .finder__item:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    .finder__icon {
      font-size: 2rem;
      line-height: 1;
    }

    .finder__name {
      font-size: 0.82rem;
      font-weight: 600;
      color: #f2f7fb;
      text-align: center;
      line-height: 1.25;
    }

    .finder__meta {
      font-size: 0.72rem;
      color: var(--muted-content);
    }

    .finder__caption {
      margin-top: 0.85rem;
      color: var(--muted-content);
      font-size: 0.92rem;
      line-height: 1.5;
    }



    /* ========== CONCEPT 4: SKILLS REPOSITORY BROWSER ========== */
    .proto-section--repo {
      border-color: rgba(56, 189, 248, 0.18);
      background:
        radial-gradient(circle at top right, rgba(56, 189, 248, 0.08), transparent 34rem),
        var(--base-200);
    }

    .proto-section__header--repo {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }

    .repo-proto-pill {
      flex: 0 0 auto;
      padding: 0.35rem 0.65rem;
      border: 1px solid rgba(255, 127, 80, 0.35);
      border-radius: 999px;
      color: #ffb199;
      background: rgba(255, 127, 80, 0.08);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .repo-browser {
      overflow: hidden;
      border: 1px solid rgba(171, 196, 220, 0.14);
      border-radius: 0.9rem;
      background: #0d1117;
      color: #c9d1d9;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    }

    .repo-browser__topbar,
    .repo-browser__meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      padding: 0.75rem 0.9rem;
      border-bottom: 1px solid #30363d;
    }

    .repo-browser__crumbs {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem;
      min-width: 0;
      color: #7d8590;
      font-size: 0.88rem;
    }

    .repo-browser__crumbs strong { color: #58a6ff; }

    .repo-browser__search {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      width: min(100%, 18rem);
      padding: 0.35rem 0.55rem;
      border: 1px solid #30363d;
      border-radius: 0.45rem;
      background: #010409;
      color: #7d8590;
      font-size: 0.76rem;
    }

    .repo-browser__search input {
      min-width: 0;
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      color: #8b949e;
      font: inherit;
    }

    .repo-browser__meta {
      justify-content: flex-start;
      flex-wrap: wrap;
      background: #161b22;
      color: #8b949e;
      font-size: 0.78rem;
    }

    .repo-browser__meta span {
      padding: 0.18rem 0.48rem;
      border: 1px solid #30363d;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.02);
    }

    .repo-browser__meta code {
      color: #c9d1d9;
      font-size: 0.75rem;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .repo-browser__body {
      display: grid;
      grid-template-columns: minmax(13rem, 18rem) minmax(0, 1fr);
      min-width: 0;
    }

    .repo-tree {
      min-width: 0;
      padding: 0.75rem;
      border-right: 1px solid #30363d;
      background: #0d1117;
    }

    .repo-tree__heading {
      margin-bottom: 0.6rem;
      color: #f0f6fc;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .repo-tree__group + .repo-tree__group { margin-top: 0.55rem; }

    .repo-tree__folder,
    .repo-tree__file {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.35rem;
      min-width: 0;
      padding: 0.34rem 0.42rem;
      border-radius: 0.38rem;
      font-size: 0.78rem;
      line-height: 1.25;
    }

    .repo-tree__folder {
      grid-template-columns: auto minmax(0, 1fr);
      color: #f0f6fc;
      font-weight: 650;
    }

    .repo-tree__files { margin-left: 0.65rem; }

    .repo-tree__file { color: #c9d1d9; }

    .repo-tree__file--selected {
      color: #ffffff;
      background: rgba(56, 139, 253, 0.18);
      outline: 1px solid rgba(56, 139, 253, 0.45);
    }

    .repo-tree__file-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .repo-tree__file-count {
      color: #7d8590;
      font-size: 0.68rem;
