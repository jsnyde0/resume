---
// PROTOTYPE (resume-soe.12) direction H2 "Cut-out, refined": homepage.
// The body is the page's structure. Jonatan, as tall as the screen, stands on paper. A black band runs
// through at shirt height so the lime shirt pops off it, and his outstretched hand points at his name,
// set in the same lime. The tagline wraps his silhouette (shape-outside on the transparent PNG).
// His front clog steps up onto a black floor that holds the links, in clog pink.
import DirectionSwitcher from '../../../components/directions/DirectionSwitcher.astro';
const photo = '/img/jonatan_posing_rocks_hires_no_bg.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Jonatan Snyders</title>
    <meta name="description" content="Jonatan Snyders. From catwalks to startups, agent harnesses to existential dread." />
    <link rel="preload" as="image" href={photo} fetchpriority="high" />
    <!-- SHORTCUT: Google Fonts link instead of self-hosted fonts. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap"
    />
  </head>
  <body>
    <main class="hero">
      <span class="band" aria-hidden="true"></span>
      <span class="floor" aria-hidden="true"></span>
      <div class="stage">
        <img
          class="figure"
          src={photo}
          alt="Jonatan mid-stride in a lime T-shirt, black cycling bibs and pink clogs, one hand held out."
          width="595"
          height="1041"
          fetchpriority="high"
        />
        <p class="line">From catwalks to startups, agent harnesses to existential dread.</p>
      </div>
      <h1 class="name"><span>Jonatan</span> <span>Snyders</span></h1>
      <nav class="ways" aria-label="Site">
        <ul>
          <li><a href="/directions/h2/resume/">Resume</a></li>
          <li><a href="/factory/">Factory</a></li>
          <li><a href="https://github.com/jsnyde0" rel="noopener">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/jonatan-snyders/" rel="noopener">LinkedIn</a></li>
        </ul>
      </nav>
    </main>

    <DirectionSwitcher current="h2" page="home" />
  </body>
</html>

<style is:global>
  :root {
    /* Brand colours, lifted from the photo and brightened: shirt lime, clog pink. They live on type and marks only. */
    --h2-lime: #c9ea6e;
    --h2-pink: #f0a6d2;
    --h2-ink: #121212;
    --h2-paper: #f1efe9;
    --h2-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --h2-font: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
  }
  html { background: var(--h2-paper); }
  body {
    margin: 0;
    color: var(--h2-ink);
    font-family: var(--h2-font);
    -webkit-font-smoothing: antialiased;
  }
</style>

<style>
  /*
   * Geometry. Everything is measured in --h, the rendered height of the 595x1041 cut-out (--w is its width).
   * Landmarks in the source, as fractions of the height: shirt 0.142 to 0.322, outstretched hand 0.20 to 0.25
   * (fingertips at 0.87 of the width), front clog sole 0.921 (heel at 0.74 of the width), back clog sole 0.998.
   */
  .hero {
    --H: max(100svh, 640px);
    /* The floor is tall enough to hold the links on their own row above the prototype switcher. */
    --floor: 7.25rem;
    --h: min(calc((var(--H) - var(--floor)) / 0.9), 1160px);
    --w: calc(var(--h) * 0.5716);
    --x0: max(1rem, 5vw);
    --y0: calc(var(--H) - var(--floor) - var(--h) * 0.919);
    --pad: clamp(1.25rem, 3.5vw, 3.5rem);
    position: relative;
    height: var(--H);
    overflow: clip;
  }

  /* Black band behind the shirt, full bleed: the lime shirt sits on the darkest thing on the page. */
  .band {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--y0) + var(--h) * 0.118);
    height: calc(var(--h) * 0.226);
    background: var(--h2-ink);
  }
  /* The floor his front clog steps up onto. */
  .floor {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--y0) + var(--h) * 0.919);
    bottom: 0;
    background: var(--h2-ink);
  }

  .stage {
    position: absolute;
    left: var(--x0);
    right: var(--pad);
    top: var(--y0);
    height: var(--h);
  }
  .figure {
    float: left;
    position: relative;
    z-index: 1;
    width: var(--w);
    height: var(--h);
    shape-outside: url('/img/jonatan_posing_rocks_hires_no_bg.png');
    shape-image-threshold: 0.4;
    shape-margin: calc(var(--h) * 0.03);
  }

  /* Tagline: second voice, set in ink on paper, its left edge follows the bent leg. */
  .line {
    position: relative;
    max-width: calc(var(--w) + 8.6em);
    margin: 0;
    padding-top: calc(var(--h) * 0.4);
    font-size: clamp(1.5rem, calc(var(--h) * 0.062), 4.25rem);
    font-weight: 500;
    font-variation-settings: 'opsz' 48;
    line-height: 1.04;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }

  /* The name, in shirt lime, in the band, where the hand points. */
  .name {
    position: absolute;
    left: calc(var(--x0) + var(--w) * 0.93);
    right: var(--pad);
    top: calc(var(--y0) + var(--h) * 0.225);
    transform: translateY(-50%);
    margin: 0;
    color: var(--h2-lime);
    font-size: min(calc(var(--h) * 0.125), calc((100vw - var(--x0) - var(--w) * 0.93 - var(--pad)) / 7.7));
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  /* Links on the floor, in clog pink. They sit right of the centred prototype switcher. */
  .ways {
    position: absolute;
    right: var(--pad);
    top: calc(var(--y0) + var(--h) * 0.919);
    bottom: 0;
    display: flex;
    align-items: flex-start;
    padding-top: 0.875rem;
  }
  .ways ul {
    display: flex;
    gap: 0 clamp(1.25rem, 2.4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ways a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--h2-pink);
    font-size: clamp(1.125rem, 1.45vw, 1.375rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 8px) / 0 2px no-repeat;
    transition: background-size 0.4s var(--h2-ease), color 0.2s;
  }
  .ways a:hover { background-size: 100% 2px; }
  .ways a:active { color: var(--h2-lime); }
  .ways a:focus-visible {
    outline: 2px solid var(--h2-lime);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Phone and portrait tablet: the stride fills the screen, the back elbow and toe crop off the left edge.
     The name splits around the outstretched hand; the floor becomes a deck holding the links in two rows. */
  @media (max-width: 760px), (orientation: portrait) and (max-width: 1100px) {
    .hero {
      --deck: 11.75rem;
      --h: min(calc((100svh - var(--deck) - 0.75rem) / 0.919), calc(100vw * 2.1), 1100px);
      --x0: calc(var(--w) * -0.2);
      --y0: max(0.75rem, calc(100svh - var(--deck) - var(--h) * 0.919));
      --pad: 1.25rem;
      height: calc(var(--y0) + var(--h) * 0.919 + var(--deck));
    }
    .band { top: calc(var(--y0) + var(--h) * 0.1); height: calc(var(--h) * 0.262); }
    .line {
      padding-top: calc(var(--h) * 0.405);
      max-width: calc(var(--x0) + var(--w) + 7em);
      font-size: clamp(1.25rem, calc(var(--h) * 0.036), 2.5rem);
      line-height: 1.08;
    }
    .figure { shape-margin: calc(var(--h) * 0.018); }
    .name {
      left: calc(var(--x0) + var(--w) * 0.56);
      top: calc(var(--y0) + var(--h) * 0.1);
      height: calc(var(--h) * 0.262);
      transform: none;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-end;
      padding: calc(var(--h) * 0.016) 0 calc(var(--h) * 0.02);
      box-sizing: border-box;
      font-size: calc(var(--h) * 0.074);
      line-height: 0.95;
    }
    /* Right of the back clog, which hangs into the floor at the left. */
    .ways {
      left: calc(var(--x0) + var(--w) * 0.33);
      justify-content: flex-end;
      padding-top: 0.625rem;
    }
    .ways ul { display: grid; grid-template-columns: auto auto; gap: 0 1.75rem; }
    .ways a { font-size: 1.5rem; min-height: 50px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .figure { animation: h2-in 1.1s var(--h2-ease) both; }
    .band { transform-origin: left center; animation: h2-wipe 1s var(--h2-ease) 0.1s both; }
    .floor { transform-origin: left center; animation: h2-wipe 1s var(--h2-ease) 0.25s both; }
    .name, .line, .ways ul { animation: h2-fade 0.9s var(--h2-ease) both; }
    .name { animation-name: h2-name; animation-delay: 0.4s; }
    .line { animation-delay: 0.55s; }
    .ways ul { animation-delay: 0.7s; }
    @keyframes h2-in { from { opacity: 0; transform: translateX(-2.5%); } }
    @keyframes h2-wipe { from { transform: scaleX(0); } }
    @keyframes h2-fade { from { opacity: 0; transform: translateY(0.4rem); } }
    @keyframes h2-name { from { opacity: 0; } }
  }
</style>
