---
// PROTOTYPE (resume-soe.4 + resume-soe.19): /projects in F7, with the site nav as a second axis.
// Three page layouts (?v=A|B|C) x three nav shapes (?nav=1|2|3), switchable from the bottom bar or ←/→ (layout)
// and ↑/↓ (nav). Real data from src/data/projects.ts.
//   A "Bands"    — one project per band: poster-scale lime name, description at reading size, stack + links.
//   B "Explorer" — /resume's mechanism: project names as big words left, the open project right, pink = open.
//   C "Ledger"   — dense Swiss table grouped by status (Built / Company / Building now): name | what | stack | links.
//   nav 1 "Top bar"   — /resume's bar extended: face + name home left, page links, GitHub/LinkedIn right.
//   nav 2 "Masthead"  — lime name wordmark is home; page words heavy, the current one in the pink block.
//   nav 3 "Index"     — tiny home link up top; the site index sits at the foot in home's poster voice.
import '../../../styles/tokens.css';
import { projectEntries, projectsIntro } from '../../../data/projects';
import type { ProjectTag } from '../../../data/projects';

// SHORTCUT: page labels for the nav are proposals for the human; production takes whatever they pick.
const pages = [
  { href: '/resume/', label: 'Resume', poster: 'What bores me' },
  { href: '/projects/', label: 'Projects', poster: "What I've built" },
  { href: '/readme/', label: 'README', poster: 'How I work' },
  { href: '/factory/', label: 'Factory', poster: 'What excites me' },
];
const current = '/projects/';
const tagLabel: Record<ProjectTag, string> = { built: 'Built', company: 'Company', 'in-progress': 'Building now' };
const groups = (['built', 'company', 'in-progress'] as ProjectTag[]).map((t) => ({
  tag: t,
  items: projectEntries.filter((p) => p.tag === t),
}));
const ext = (external?: boolean) => (external ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---
<!doctype html>
<html lang="en" data-v="A" data-nav="1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>PROTOTYPE · Projects — Jonatan Snyders</title>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/schibsted-grotesk-latin-wght.woff2" crossorigin />
    <!-- SHORTCUT: variant read client-side from the query (static build has no server params). -->
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search), h = document.documentElement;
        h.dataset.v = (q.get('v') || 'A').toUpperCase();
        h.dataset.nav = q.get('nav') || '1';
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <!-- ── nav 1: top bar ── -->
      <header class="nav nav-1">
        <a class="n1-home" href="/"><img src="/img/avatar_jonatan.png" alt="" width="253" height="252" /><span>Jonatan Snyders</span></a>
        <nav aria-label="Site"><ul class="n1-pages">
          {pages.map((p) => <li><a href={p.href} aria-current={p.href === current ? 'page' : undefined}>{p.label}</a></li>)}
        </ul></nav>
        <ul class="n1-ext">
          <li><a href="https://github.com/jsnyde0/" rel="me">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/jonatan-snyders/" rel="me">LinkedIn</a></li>
        </ul>
      </header>

      <!-- ── nav 2: masthead ── -->
      <header class="nav nav-2">
        <a class="n2-home" href="/">Jonatan Snyders</a>
        <nav aria-label="Site"><ul class="n2-pages">
          {pages.map((p) => <li><a href={p.href} aria-current={p.href === current ? 'page' : undefined}>{p.label}</a></li>)}
        </ul></nav>
      </header>

      <!-- ── nav 3: tiny home link (index sits at the foot) ── -->
      <header class="nav nav-3">
        <a class="n3-home" href="/">← Jonatan Snyders</a>
      </header>

      <main>
        <div class="head">
          <h1 class="title">{projectsIntro.title}</h1>
          <p class="lede">{projectsIntro.description}</p>
        </div>

        <!-- ── A: bands ── -->
        <section class="var var-A">
          {projectEntries.map((p) => (
            <article class="band">
              <p class="band-tag">{tagLabel[p.tag]}</p>
              <h2 class="band-name">{p.title}</h2>
              <p class="band-desc">{p.description}</p>
              <p class="band-meta">
                {p.technologies && <span class="stack">{p.technologies.join(' · ')}</span>}
                {p.links.map((l) => <a href={l.href} {...ext(l.external)}>{l.label}</a>)}
              </p>
            </article>
          ))}
        </section>

        <!-- ── B: explorer ── -->
        <section class="var var-B">
          <ul class="ex-list">
            {projectEntries.map((p, i) => (
              <li><button type="button" class:list={['ex-item', { 'is-open': i === 0 }]} data-slug={p.slug}>
                <span class="ex-name">{p.title}</span><span class="ex-tag">{tagLabel[p.tag]}</span>
              </button></li>
            ))}
          </ul>
          <div class="ex-pane">
            {projectEntries.map((p, i) => (
              <article class="ex-file" data-slug={p.slug} hidden={i !== 0}>
                <p class="ex-file-tag">{tagLabel[p.tag]}</p>
                <h2 class="ex-file-name">{p.title}</h2>
                <p class="ex-file-desc">{p.description}</p>
                {p.technologies && <p class="ex-file-stack">{p.technologies.join(' · ')}</p>}
                <p class="ex-file-links">{p.links.map((l) => <a href={l.href} {...ext(l.external)}>{l.label}</a>)}</p>
              </article>
            ))}
          </div>
        </section>

        <!-- ── C: ledger ── -->
        <section class="var var-C">
          {groups.map((g) => (
            <div class="lg-group">
              <h2 class="lg-head">{tagLabel[g.tag]}<sup>{g.items.length}</sup></h2>
              {g.items.map((p) => (
                <div class="lg-row">
                  <h3 class="lg-name">{p.title}</h3>
                  <p class="lg-desc">{p.description}</p>
                  <p class="lg-stack">{p.technologies?.join(' · ')}</p>
                  <p class="lg-links">{p.links.map((l) => <a href={l.href} {...ext(l.external)}>{l.label}</a>)}</p>
                </div>
              ))}
            </div>
          ))}
        </section>
      </main>

      <!-- ── nav 3: the foot index ── -->
      <footer class="nav nav-3 n3-index">
        <ul>
          {pages.map((p) => <li><a href={p.href} aria-current={p.href === current ? 'page' : undefined}>{p.poster}</a></li>)}
        </ul>
        <ul class="n3-ext">
          <li><a href="https://github.com/jsnyde0/" rel="me">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/jonatan-snyders/" rel="me">LinkedIn</a></li>
        </ul>
      </footer>
    </div>

    <!-- SHORTCUT: prototype switcher, visible in prod on purpose (noindex, unlinked, deleted with /directions/). -->
    <div class="psw" aria-label="Prototype switcher">
      <span class="psw-tag">PROTOTYPE</span>
      <span>layout</span>
      <button data-k="v" data-d="-1" aria-label="Previous layout">&larr;</button>
      <strong data-show="v"></strong>
      <button data-k="v" data-d="1" aria-label="Next layout">&rarr;</button>
      <span class="psw-sep"></span>
      <span>nav</span>
      <button data-k="nav" data-d="-1" aria-label="Previous nav">&larr;</button>
      <strong data-show="nav"></strong>
      <button data-k="nav" data-d="1" aria-label="Next nav">&rarr;</button>
    </div>

    <script is:inline>
      (function () {
        var h = document.documentElement;
        var opts = { v: ['A', 'B', 'C'], nav: ['1', '2', '3'] };
        var names = { A: 'Bands', B: 'Explorer', C: 'Ledger', 1: 'Top bar', 2: 'Masthead', 3: 'Index' };
        function paint() {
          document.querySelectorAll('[data-show]').forEach(function (el) {
            var k = h.dataset[el.dataset.show]; el.textContent = k + ' · ' + names[k];
          });
        }
        function step(k, d) {
          var o = opts[k], i = (o.indexOf(h.dataset[k]) + d + o.length) % o.length;
          h.dataset[k] = o[i];
          var q = new URLSearchParams(location.search); q.set(k, o[i]);
          history.replaceState(null, '', '?' + q.toString());
          paint();
        }
        document.querySelectorAll('.psw button').forEach(function (b) {
          b.addEventListener('click', function () { step(b.dataset.k, +b.dataset.d); });
        });
        document.addEventListener('keydown', function (e) {
          if (e.target.closest('input,textarea,[contenteditable]')) return;
          if (e.key === 'ArrowRight') step('v', 1);
          if (e.key === 'ArrowLeft') step('v', -1);
          if (e.key === 'ArrowDown') { e.preventDefault(); step('nav', 1); }
          if (e.key === 'ArrowUp') { e.preventDefault(); step('nav', -1); }
        });
        paint();
        // B explorer: one open project at a time.
        document.querySelectorAll('.ex-item').forEach(function (b) {
          b.addEventListener('click', function () {
            document.querySelectorAll('.ex-item').forEach(function (x) { x.classList.toggle('is-open', x === b); });
            document.querySelectorAll('.ex-file').forEach(function (f) { f.hidden = f.dataset.slug !== b.dataset.slug; });
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html, body { margin: 0; background: var(--id-ground); }
</style>

<style>
  .page {
    --pad: clamp(1rem, 2.4vw, 2.25rem);
    --ease: cubic-bezier(0.25, 1, 0.5, 1);
    min-height: 100svh;
    padding: var(--pad) var(--pad) 6rem;
    color: var(--id-paper);
    font-family: var(--id-font-body);
    font-size: var(--id-text-body);
    line-height: var(--line-height-body);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-underline-offset: 0.18em; transition: background-color 160ms var(--ease), color 160ms var(--ease); }
  a:hover { background: var(--id-pink); color: var(--id-ink); text-decoration-color: transparent; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--id-paper); outline-offset: 3px; }
  ul { list-style: none; margin: 0; padding: 0; }
  p, h1, h2, h3 { margin: 0; }

  /* variant gating */
  .nav, .var { display: none; }
  :global(html[data-nav='1']) .nav-1, :global(html[data-nav='2']) .nav-2, :global(html[data-nav='3']) .nav-3 { display: flex; }
  :global(html[data-v='A']) .var-A, :global(html[data-v='C']) .var-C { display: block; }
  :global(html[data-v='B']) .var-B { display: grid; }

  /* ── nav 1: top bar ── */
  .nav-1 { align-items: center; gap: var(--space-8); flex-wrap: wrap; }
  .n1-home { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 44px; font-weight: var(--id-weight-strong); letter-spacing: var(--id-tracking-heading); text-decoration: none; }
  .n1-home img { width: 44px; height: auto; }
  .n1-home:hover { background: none; color: inherit; }
  .n1-home:hover span { background: var(--id-pink); color: var(--id-ink); }
  .nav-1 nav { margin-left: auto; }
  .n1-pages, .n1-ext { display: flex; gap: var(--space-6); flex-wrap: wrap; }
  .n1-pages a { display: inline-flex; align-items: center; min-height: 44px; font-weight: var(--id-weight-strong); color: var(--id-lime); text-decoration: none; }
  .n1-pages a[aria-current] { background: var(--id-pink); color: var(--id-ink); padding: 0 0.3em; }
  .n1-ext a { display: inline-flex; align-items: center; min-height: 44px; }

  /* ── nav 2: masthead ── */
  .nav-2 { align-items: baseline; justify-content: space-between; gap: var(--space-4) var(--space-8); flex-wrap: wrap; }
  .n2-home { font-size: var(--id-text-heading); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-display); color: var(--id-lime); text-decoration: none; }
  .n2-pages { display: flex; gap: var(--space-2) var(--space-6); flex-wrap: wrap; }
  .n2-pages a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.12em; font-size: var(--id-text-heading); font-weight: var(--id-weight-strong); letter-spacing: var(--id-tracking-heading); text-decoration: none; }
  .n2-pages a[aria-current] { background: var(--id-pink); color: var(--id-ink); }

  /* ── nav 3: index ── */
  .n3-home { display: inline-flex; align-items: center; min-height: 44px; font-weight: var(--id-weight-strong); color: var(--id-lime); text-decoration: none; }
  .n3-index { flex-direction: column; gap: var(--space-8); margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--id-rule); }
  .n3-index ul:first-child a { font-size: var(--id-text-display); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-display); line-height: var(--id-leading-display); color: var(--id-lime); text-decoration: none; padding: 0 0.08em; }
  .n3-index ul:first-child a[aria-current] { color: var(--id-paper-2); pointer-events: none; }
  .n3-ext { display: flex; gap: var(--space-6); }

  /* ── page head ── */
  main { margin-top: clamp(2rem, 6vw, 5rem); }
  .head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--pad); align-items: end; }
  .title { font-size: var(--id-text-poster); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-poster); line-height: var(--id-leading-poster); color: var(--id-lime); }
  .lede { max-width: 34ch; font-size: var(--id-text-heading); font-weight: var(--id-weight-medium); line-height: 1.3; letter-spacing: var(--id-tracking-heading); }
  .var { margin-top: clamp(3rem, 7vw, 6rem); }
  .stack, .band-tag, .ex-tag, .ex-file-tag, .ex-file-stack, .lg-stack { color: var(--id-paper-2); font-size: var(--id-text-small); }

  /* ── A: bands ── */
  .band { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--pad); row-gap: var(--space-3); padding: var(--space-8) 0; border-top: 1px solid var(--id-rule); }
  .band-tag { grid-column: 1 / -1; }
  .band-name { grid-column: 1; font-size: var(--id-text-display); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-display); line-height: var(--id-leading-display); color: var(--id-lime); }
  .band-desc { grid-column: 2; grid-row: 2 / span 2; max-width: 46ch; line-height: var(--line-height-relaxed); }
  .band-meta { grid-column: 1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); }
  .band-meta a { display: inline-flex; align-items: center; min-height: 44px; font-weight: var(--id-weight-strong); color: var(--id-lime); }
  .band-meta a:hover { color: var(--id-ink); }

  /* ── B: explorer ── */
  .var-B { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: calc(2 * var(--pad)); align-items: start; }
  .ex-item { all: unset; box-sizing: border-box; display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); width: 100%; padding: var(--space-1) var(--space-2); cursor: pointer; }
  .ex-name { font-size: var(--id-text-display); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-display); line-height: 1.05; color: var(--id-lime); }
  .ex-item:hover .ex-name { color: var(--id-paper); }
  .ex-item.is-open { background: var(--id-pink); }
  .ex-item.is-open .ex-name, .ex-item.is-open .ex-tag { color: var(--id-ink); }
  .ex-pane { position: sticky; top: var(--pad); padding-top: var(--space-2); }
  .ex-file { display: grid; gap: var(--space-5); }
  .ex-file[hidden] { display: none; }
  .ex-file-name { font-size: var(--id-text-display); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-display); line-height: var(--id-leading-display); }
  .ex-file-desc { max-width: 52ch; font-size: var(--id-text-heading); line-height: 1.45; }
  .ex-file-links { display: flex; gap: var(--space-6); }
  .ex-file-links a { display: inline-flex; align-items: center; min-height: 44px; font-weight: var(--id-weight-strong); color: var(--id-lime); }
  .ex-file-links a:hover { color: var(--id-ink); }

  /* ── C: ledger ── */
  .lg-group + .lg-group { margin-top: var(--space-12); }
  .lg-head { padding-bottom: var(--space-3); font-size: var(--id-text-display); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-display); line-height: var(--id-leading-display); color: var(--id-lime); }
  .lg-head sup { margin-left: 0.2em; font-size: var(--id-text-small); font-weight: var(--id-weight-strong); letter-spacing: 0; color: var(--id-paper-2); vertical-align: top; }
  .lg-row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 2fr) minmax(0, 2fr); column-gap: var(--pad); align-items: baseline; padding: var(--space-4) var(--space-2); border-top: 1px solid var(--id-rule); }
  .lg-row:hover { background: var(--id-tint-hover); }
  .lg-name { font-size: var(--id-text-heading); font-weight: var(--id-weight-strong); letter-spacing: var(--id-tracking-heading); }
  .lg-desc { line-height: var(--line-height-relaxed); max-width: 60ch; }
  .lg-links { display: flex; flex-direction: column; align-items: flex-start; }
  .lg-links a { display: inline-flex; align-items: center; min-height: 44px; font-weight: var(--id-weight-strong); color: var(--id-lime); }
  .lg-links a:hover { color: var(--id-ink); }

  @media (max-width: 760px) {
    .nav-1 { gap: var(--space-2) var(--space-5); }
    .nav-1 nav { margin-left: 0; order: 3; width: 100%; }
    .n1-ext { margin-left: auto; gap: var(--space-4); font-size: var(--id-text-small); }
    .n1-home img { width: 36px; }
    .n1-pages { gap: 0 var(--space-4); }
    .n1-pages a { font-size: var(--id-text-small); }
    .n1-pages a[aria-current] { padding: 0 0.25em; }
    .psw { gap: 4px; padding: 4px 8px; font-size: 10px; }
    .psw-tag { display: none; }
    .head { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-5); }
    .band { grid-template-columns: minmax(0, 1fr); }
    .band-desc, .band-meta { grid-column: 1; grid-row: auto; }
    .var-B { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-8); }
    .ex-pane { position: static; }
    .lg-row { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-2); }
    .lg-links { flex-direction: row; gap: var(--space-5); }
  }

  /* ── prototype switcher (not part of any design) ── */
  .psw { position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 99; display: flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: #fff; color: #111; font: 600 12px/1 ui-monospace, monospace; box-shadow: 0 6px 24px rgba(0,0,0,.5); white-space: nowrap; }
  .psw button { all: unset; cursor: pointer; padding: 6px 8px; border-radius: 6px; background: #eee; }
  .psw-tag { background: #111; color: #fff; padding: 4px 6px; border-radius: 4px; }
  .psw-sep { width: 1px; height: 18px; background: #ccc; }
</style>
