---
// PROTOTYPE round 2 (resume-soe.4 + resume-soe.19). Human round-1 ruling: nav = top bar, GitHub/LinkedIn move
// to a footer; explorer feel + the ledger's status grouping; try a timeline; groups are Building now / Built;
// harness off; switch-berlin and Mapular under Building now; more projects; the factory broken into its parts.
//   layout B "Explorer"  — /resume's mechanism: status groups as big lime words, projects as dated rows,
//                          the factory a folder of its parts; the open project on the right, pink = open.
//   layout D "Timeline"  — month axis 2025 → now; one bar per project, the factory's parts as thin rows under it;
//                          click a row to open it in the pane below.
//   footer 1 "Quiet"     — one hairline row: name (home) left, GitHub · LinkedIn right.
//   footer 2 "Sign-off"  — GitHub and LinkedIn as big lime words.
//   footer 3 "Sitemap"   — page links + GitHub · LinkedIn in two short columns.
import '../../../styles/tokens.css';

type Status = 'now' | 'built';
interface P {
  slug: string; title: string; status: Status; from: string; to?: string; // YYYY-MM; no `to` = ongoing
  desc: string; stack?: string; links?: { label: string; href: string }[]; parent?: string; early?: string;
}
// SHORTCUT: prototype-local data (dates from git history, descriptions drafted from READMEs, not the human's
// copy). Production moves the approved list into src/data/projects.ts with the human's wording.
const projects: P[] = [
  { slug: 'switch-berlin', title: 'switch-berlin', status: 'now', from: '2025-01',
    desc: "A trust-first, organizer-centric events aggregator for Berlin's queer & alternative scene — Django + HTMX with a React island and LLM-powered scraping and ingestion.",
    stack: 'Django · HTMX · React · LLM', links: [{ label: 'switch.berlin', href: 'https://switch.berlin' }] },
  { slug: 'mapular', title: 'Mapular', status: 'now', from: '2025-05',
    desc: 'Location-intelligence software for retail expansion — 20M+ competitive data points combined with demographics and travel-time catchments to analyze markets, score candidate sites, and produce ranked, decision-ready shortlists, no GIS expertise needed.',
    links: [{ label: 'mapular.com', href: 'https://mapular.com/solutions/site-selection' }] },
  { slug: 'factory', title: 'self-driving factory', status: 'now', from: '2026-04',
    desc: "The agentic software factory I'm building — the system behind how I work.",
    links: [{ label: 'See the breakdown →', href: '/factory/' }] },
  { slug: 'orchestration', parent: 'factory', title: 'orchestration', status: 'now', from: '2026-07',
    desc: 'A planner agent watches the issue graph and starts sessions; each session drives one task and pulls in helpers. Grants decide who may touch what.' },
  { slug: 'mail', parent: 'factory', title: 'mail', status: 'now', from: '2026-07',
    desc: 'Agents write to each other through a mailbox on disk: send, read, acknowledge. Nothing gets lost when a session dies.' },
  { slug: 'memory', parent: 'factory', title: 'tiered memory', status: 'now', from: '2026-07',
    desc: 'Raw logs, fading notes, sticky lessons, binding decisions. Items climb as they prove useful; old ones rot on schedule.' },
  { slug: 'cockpit', parent: 'factory', title: 'cockpit', status: 'now', from: '2026-06',
    desc: 'Every agent in its own terminal pane, one view over all of them; I can jump into any session.' },
  { slug: 'seats', parent: 'factory', title: 'seats', status: 'now', from: '2026-09',
    desc: 'One tool that places agents in panes, talks to them, and notices when one is stuck on a rate limit.' },
  { slug: 'pacemaker', parent: 'factory', title: 'pacemaker', status: 'now', from: '2026-09',
    desc: 'The one clock in the system. It sends pulses on a schedule; agents answer with a beat.' },
  { slug: 'verify', parent: 'factory', title: 'verifiable targets', status: 'now', from: '2026-08',
    desc: 'Each task says what done looks like and which checks prove it, so an agent can tell when it is finished.' },
  { slug: 'personal-agent', title: 'personal agent', status: 'now', from: '2026-04',
    desc: 'An always-on assistant I talk to over Telegram, running on my own host with a scheduler and its own sessions.' },
  { slug: 'rip-cage', title: 'rip-cage', status: 'built', from: '2026-03', to: '2026-10',
    desc: 'A CLI that wraps your project in a Docker container with a command-intercepting safety stack, so you can run coding agents with --dangerously-skip-permissions and keep the blast radius small.',
    stack: 'Docker', links: [{ label: 'GitHub', href: 'https://github.com/jsnyde0/rip-cage' }] },
  { slug: 'meshmonk', title: 'meshmonk', status: 'built', from: '2026-04', to: '2026-10', early: '2016–2021',
    desc: 'The open-source 3D mesh-registration toolbox I built, used in KU Leuven craniofacial research and widely cited. In 2026 I rewrote it Python-first (C++20, clean API, Python bindings, PyPI).',
    stack: 'C++20 · Python', links: [{ label: 'GitHub', href: 'https://github.com/jsnyde0/meshmonk' }] },
  { slug: 'fetch-ladder', title: 'fetch-ladder', status: 'built', from: '2026-10', to: '2026-10',
    desc: 'A Python package that fetches a URL the way that site allows: it remembers which client works per host, climbs to the next when one fails, and paces requests.',
    stack: 'Python', links: [{ label: 'GitHub', href: 'https://github.com/jsnyde0/fetch-ladder' }] },
  { slug: 'haneen', title: 'haneenkhan.com', status: 'built', from: '2026-06', to: '2026-07',
    desc: "A static rebuild of a client's portfolio site, off Squarespace.", stack: 'Astro',
    links: [{ label: 'haneenkhan.com', href: 'https://www.haneenkhan.com' }] },
  { slug: 'approval-agent', title: 'approval-agent', status: 'built', from: '2026-03', to: '2026-03',
    desc: 'A Claude Code hook that asks a fast model to triage shell commands too opaque to approve by rule.',
    stack: 'Python · Gemini', links: [{ label: 'GitHub', href: 'https://github.com/jsnyde0/approval-agent' }] },
  { slug: 'humble-clay', title: 'humble-clay', status: 'built', from: '2025-03', to: '2025-05',
    desc: "A small API that runs prompts through LLMs in bulk — a humble take on Clay's AI agent.",
    stack: 'FastAPI · LLM', links: [{ label: 'GitHub', href: 'https://github.com/jsnyde0/humble-clay' }] },
  { slug: 'event-gulper', title: 'event-gulper', status: 'built', from: '2025-02', to: '2026-06',
    desc: 'The agentic event scraper that came before switch-berlin.', stack: 'Python · LLM',
    links: [{ label: 'GitHub', href: 'https://github.com/jsnyde0/event-gulper' }] },
];
const START = 2025 * 12; // 2025-01
const NOW = 2026 * 12 + 9; // 2026-10
const SPAN = NOW - START + 1;
const m = (s: string) => { const [y, mo] = s.split('-').map(Number); return y * 12 + mo - 1; };
const bar = (p: P) => {
  const a = Math.max(m(p.from), START), b = p.to ? m(p.to) : NOW;
  return `left:${((a - START) / SPAN) * 100}%;width:${((b - a + 1) / SPAN) * 100}%`;
};
const yrs = (p: P) => {
  const a = p.from.slice(0, 4), b = p.to ? p.to.slice(0, 4) : 'now';
  return a === b ? a : `${a}–${b}`;
};
const groups: { key: Status; label: string }[] = [
  { key: 'now', label: 'Building now' },
  { key: 'built', label: 'Built' },
];
const top = (s: Status) => projects.filter((p) => p.status === s && !p.parent);
const kids = (slug: string) => projects.filter((p) => p.parent === slug);
const pages = [
  { href: '/resume/', label: 'Resume' },
  { href: '/projects/', label: 'Projects' },
  { href: '/readme/', label: 'README' },
  { href: '/factory/', label: 'Factory' },
];
const current = '/projects/';
const months = ['2025', 'Apr', 'Jul', 'Oct', '2026', 'Apr', 'Jul'];
---
<!doctype html>
<html lang="en" data-v="B" data-foot="1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>PROTOTYPE · Projects — Jonatan Snyders</title>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/schibsted-grotesk-latin-wght.woff2" crossorigin />
    <!-- SHORTCUT: variant read client-side from the query (static build has no server params). -->
    <script is:inline>
      (function () {
        var q = new URLSearchParams(location.search), h = document.documentElement;
        var v = (q.get('v') || 'B').toUpperCase();
        h.dataset.v = v === 'D' ? 'D' : 'B';
        h.dataset.foot = q.get('foot') || '1';
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <a class="home" href="/"><img src="/img/avatar_jonatan.png" alt="" width="253" height="252" /><span>Jonatan Snyders</span></a>
        <nav aria-label="Site"><ul class="pages">
          {pages.map((p) => <li><a href={p.href} aria-current={p.href === current ? 'page' : undefined}>{p.label}</a></li>)}
        </ul></nav>
      </header>

      <main>
        <!-- SHORTCUT: lede reworded by the prototype seat to fit the new list; the human owns the final copy. -->
        <div class="head">
          <h1 class="title">Building</h1>
          <p class="lede">Things I've built and am building — products, tools, and research software, and the agent factory I run them with.</p>
        </div>

        <!-- ── B: explorer ── -->
        <section class="var var-B">
          <div class="ex-tree">
            {groups.map((g) => (
              <div class="ex-group">
                <h2 class="ex-head">{g.label}<sup>{top(g.key).length}</sup></h2>
                <ul>
                  {top(g.key).map((p) => (
                    <li>
                      <button type="button" class="row" data-open={p.slug}><span>{p.title}</span><span class="yrs">{yrs(p)}</span></button>
                      {kids(p.slug).length > 0 && (
                        <ul class="sub">
                          {kids(p.slug).map((k) => (
                            <li><button type="button" class="row" data-open={k.slug}><span>{k.title}</span><span class="yrs">{yrs(k)}</span></button></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="pane"><div class="pane-slot"></div></div>
        </section>

        <!-- ── D: timeline ── -->
        <section class="var var-D">
          <div class="tl-axis" aria-hidden="true">
            <span class="tl-label"></span>
            <div class="tl-track">{months.map((t, i) => <span style={`left:${(i * 3 / SPAN) * 100}%`} class:list={[{ yr: /^\d/.test(t) }]}>{t}</span>)}<span class="tl-now" style="left:100%">now</span></div>
          </div>
          {groups.map((g) => (
            <div class="tl-group">
              <h2 class="ex-head">{g.label}<sup>{top(g.key).length}</sup></h2>
              {top(g.key).map((p) => (
                <>
                  <button type="button" class="tl-row" data-open={p.slug}>
                    <span class="tl-label">{p.title}{p.early && <span class="tl-early"> · first {p.early}</span>}</span>
                    <span class="tl-track"><span class:list={['tl-bar', { ongoing: !p.to }]} style={bar(p)}></span></span>
                  </button>
                  {kids(p.slug).map((k) => (
                    <button type="button" class="tl-row tl-sub" data-open={k.slug}>
                      <span class="tl-label">{k.title}</span>
                      <span class="tl-track"><span class:list={['tl-bar', { ongoing: !k.to }]} style={bar(k)}></span></span>
                    </button>
                  ))}
                </>
              ))}
            </div>
          ))}
          <div class="pane tl-pane"><div class="pane-slot"></div></div>
        </section>

        <!-- one file per project; the open one is cloned into the visible pane by the script -->
        <div class="files" hidden>
          {projects.map((p) => (
            <article class="file" data-slug={p.slug}>
              <p class="file-meta">{p.status === 'now' ? 'Building now' : 'Built'} · {yrs(p)}{p.early && ` · first version ${p.early}`}{p.parent && ' · part of the factory'}</p>
              <h2 class="file-name">{p.title}</h2>
              <p class="file-desc">{p.desc}</p>
              {p.stack && <p class="file-meta">{p.stack}</p>}
              {p.links && <p class="file-links">{p.links.map((l) => <a href={l.href} {...(l.href.startsWith('/') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>{l.label}</a>)}</p>}
            </article>
          ))}
        </div>
      </main>

      <!-- ── footers ── -->
      <footer class="foot foot-1">
        <a class="foot-home" href="/">Jonatan Snyders</a>
        <ul class="ext">
          <li><a href="https://github.com/jsnyde0/" rel="me">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/jonatan-snyders/" rel="me">LinkedIn</a></li>
        </ul>
      </footer>
      <footer class="foot foot-2">
        <ul class="ext-big">
          <li><a href="https://github.com/jsnyde0/" rel="me">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/jonatan-snyders/" rel="me">LinkedIn</a></li>
        </ul>
        <a class="foot-home" href="/">Jonatan Snyders</a>
      </footer>
      <footer class="foot foot-3">
        <a class="foot-home" href="/">Jonatan Snyders</a>
        <ul class="col">{pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
        <ul class="col">
          <li><a href="https://github.com/jsnyde0/" rel="me">GitHub</a></li>
          <li><a href="https://www.linkedin.com/in/jonatan-snyders/" rel="me">LinkedIn</a></li>
        </ul>
      </footer>
    </div>

    <!-- SHORTCUT: prototype switcher, visible in prod on purpose (noindex, unlinked, deleted with /directions/). -->
    <div class="psw" aria-label="Prototype switcher">
      <span class="psw-tag">PROTOTYPE</span>
      <span>layout</span>
      <button data-k="v" data-d="-1" aria-label="Previous layout">&larr;</button>
      <strong data-show="v"></strong>
      <button data-k="v" data-d="1" aria-label="Next layout">&rarr;</button>
      <span class="psw-sep"></span>
      <span>footer</span>
      <button data-k="foot" data-d="-1" aria-label="Previous footer">&larr;</button>
      <strong data-show="foot"></strong>
      <button data-k="foot" data-d="1" aria-label="Next footer">&rarr;</button>
    </div>

    <script is:inline>
      (function () {
        var h = document.documentElement;
        var opts = { v: ['B', 'D'], foot: ['1', '2', '3'] };
        var names = { B: 'Explorer', D: 'Timeline', 1: 'Quiet', 2: 'Sign-off', 3: 'Sitemap' };
        function paint() {
          document.querySelectorAll('[data-show]').forEach(function (el) {
            var k = h.dataset[el.dataset.show]; el.textContent = k + ' · ' + names[k];
          });
        }
        function step(k, d) {
          var o = opts[k], i = (o.indexOf(h.dataset[k]) + d + o.length) % o.length;
          h.dataset[k] = o[i];
          var q = new URLSearchParams(location.search); q.set(k, o[i]);
          history.replaceState(null, '', '?' + q.toString());
          paint();
        }
        document.querySelectorAll('.psw button').forEach(function (b) {
          b.addEventListener('click', function () { step(b.dataset.k, +b.dataset.d); });
        });
        document.addEventListener('keydown', function (e) {
          if (e.target.closest('input,textarea,[contenteditable]')) return;
          if (e.key === 'ArrowRight') step('v', 1);
          if (e.key === 'ArrowLeft') step('v', -1);
          if (e.key === 'ArrowDown') { e.preventDefault(); step('foot', 1); }
          if (e.key === 'ArrowUp') { e.preventDefault(); step('foot', -1); }
        });
        // One open project, shown in each layout's pane. SHORTCUT: no #slug deep links yet (production: like /resume).
        function open(slug) {
          document.querySelectorAll('[data-open]').forEach(function (b) { b.classList.toggle('is-open', b.dataset.open === slug); });
          var f = document.querySelector('.file[data-slug="' + slug + '"]');
          document.querySelectorAll('.pane-slot').forEach(function (s) { s.innerHTML = ''; s.appendChild(f.cloneNode(true)); });
        }
        document.querySelectorAll('[data-open]').forEach(function (b) {
          b.addEventListener('click', function () { open(b.dataset.open); });
        });
        open('switch-berlin');
        paint();
      })();
    </script>
  </body>
</html>

<style is:global>
  html, body { margin: 0; background: var(--id-ground); }
</style>

<style>
  .page {
    --pad: clamp(1rem, 2.4vw, 2.25rem);
    --ease: cubic-bezier(0.25, 1, 0.5, 1);
    min-height: 100svh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: var(--pad) var(--pad) 5rem;
    color: var(--id-paper);
    font-family: var(--id-font-body);
    font-size: var(--id-text-body);
    line-height: var(--line-height-body);
    -webkit-font-smoothing: antialiased;
  }
  main { flex: 1; margin-top: clamp(2rem, 6vw, 5rem); }
  a { color: inherit; text-underline-offset: 0.18em; transition: background-color 160ms var(--ease), color 160ms var(--ease); }
  a:hover { background: var(--id-pink); color: var(--id-ink); text-decoration-color: transparent; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--id-paper); outline-offset: 3px; }
  ul { list-style: none; margin: 0; padding: 0; }
  p, h1, h2, h3 { margin: 0; }
  button { all: unset; box-sizing: border-box; cursor: pointer; }

  .var, .foot { display: none; }
  :global(html[data-v='B']) .var-B, :global(html[data-v='D']) .var-D { display: grid; }
  :global(html[data-foot='1']) .foot-1, :global(html[data-foot='2']) .foot-2, :global(html[data-foot='3']) .foot-3 { display: flex; }

  /* ── top bar (round-1 pick) ── */
  .topbar { display: flex; align-items: center; gap: var(--space-4) var(--space-8); flex-wrap: wrap; }
  .home { display: inline-flex; align-items: center; gap: 0.75rem; min-height: 44px; font-weight: var(--id-weight-strong); letter-spacing: var(--id-tracking-heading); text-decoration: none; }
  .home img { width: 44px; height: auto; }
  .home:hover { background: none; color: inherit; }
  .home:hover span { background: var(--id-pink); color: var(--id-ink); }
  .topbar nav { margin-left: auto; }
  .pages { display: flex; gap: var(--space-6); flex-wrap: wrap; }
  .pages a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.3em; font-weight: var(--id-weight-strong); color: var(--id-lime); text-decoration: none; }
  .pages a[aria-current] { background: var(--id-pink); color: var(--id-ink); }

  /* ── head ── */
  .head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--pad); align-items: end; }
  .title { font-size: var(--id-text-poster); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-poster); line-height: var(--id-leading-poster); color: var(--id-lime); }
  .lede { max-width: 34ch; font-size: var(--id-text-heading); font-weight: var(--id-weight-medium); line-height: 1.3; letter-spacing: var(--id-tracking-heading); }
  .var { margin-top: clamp(3rem, 6vw, 5rem); }

  .ex-head { padding-bottom: var(--space-3); font-size: var(--id-text-display); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-display); line-height: var(--id-leading-display); color: var(--id-lime); }
  .ex-head sup { margin-left: 0.2em; font-size: var(--id-text-small); font-weight: var(--id-weight-strong); letter-spacing: 0; color: var(--id-paper-2); vertical-align: top; }

  /* ── B: explorer ── */
  .var-B { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: calc(2 * var(--pad)); align-items: start; }
  .ex-group + .ex-group { margin-top: var(--space-10); }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); width: 100%; min-height: 44px; padding: var(--space-2); border-top: 1px solid var(--id-rule); font-weight: var(--id-weight-medium); }
  .ex-group > ul > li:last-child > .row { border-bottom: 1px solid var(--id-rule); }
  .row:hover { background: var(--id-tint-hover); }
  .row.is-open, .tl-row.is-open .tl-label { background: var(--id-pink); color: var(--id-ink); }
  .row.is-open .yrs { color: var(--id-ink); }
  .yrs { color: var(--id-paper-2); font-size: var(--id-text-small); white-space: nowrap; }
  .sub .row { min-height: 36px; padding: var(--space-1) var(--space-2) var(--space-1) var(--space-8); border-top-color: transparent; font-size: var(--id-text-small); }
  .sub .row span:first-child::before { content: '↳ '; color: var(--id-paper-2); }
  .sub .row.is-open span:first-child::before { color: var(--id-ink); }
  .pane { position: sticky; top: var(--pad); }
  .pane :global(.file) { display: grid; gap: var(--space-5); }
  .pane :global(.file-name) { font-size: var(--id-text-display); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-display); line-height: var(--id-leading-display); }
  .pane :global(.file-desc) { max-width: 52ch; font-size: var(--id-text-heading); line-height: 1.45; }
  .pane :global(.file-meta) { color: var(--id-paper-2); font-size: var(--id-text-small); }
  .pane :global(.file-links) { display: flex; gap: var(--space-6); }
  .pane :global(.file-links a) { display: inline-flex; align-items: center; min-height: 44px; font-weight: var(--id-weight-strong); color: var(--id-lime); }
  .pane :global(.file-links a:hover) { color: var(--id-ink); }

  /* ── D: timeline ── */
  .var-D { --label: minmax(10rem, 3fr); grid-template-columns: minmax(0, 1fr); }
  .tl-axis, .tl-row { display: grid; grid-template-columns: var(--label) minmax(0, 9fr); column-gap: var(--pad); align-items: center; }
  .tl-axis { position: sticky; top: 0; z-index: 2; padding: var(--space-2) 0; background: var(--id-ground); border-bottom: 1px solid var(--id-rule); font-size: var(--id-text-small); color: var(--id-paper-2); }
  .tl-axis .tl-track { position: relative; height: 1.5em; }
  .tl-axis .tl-track span { position: absolute; top: 0; padding-left: 4px; border-left: 1px solid var(--id-rule); }
  .tl-axis .tl-track .yr { color: var(--id-paper); font-weight: var(--id-weight-strong); }
  .tl-axis .tl-now { transform: translateX(-100%); border-left: 0 !important; padding-right: 2px; color: var(--id-pink); font-weight: var(--id-weight-strong); }
  .tl-group { margin-top: var(--space-10); }
  .tl-row { width: 100%; min-height: 40px; border-top: 1px solid var(--id-rule); }
  .tl-row:hover { background: var(--id-tint-hover); }
  .tl-row .tl-label { padding: var(--space-1) var(--space-2); font-weight: var(--id-weight-medium); justify-self: start; }
  .tl-early { color: var(--id-paper-2); font-size: var(--id-text-small); font-weight: var(--id-weight-body); }
  .tl-row .tl-track { position: relative; height: 14px; }
