---
// PROTOTYPE (resume-system): how /resume sits inside the shared design system. Three variants, ?variant=A|B|C.
//   A "Title is the intro"   big lime "Resume" title IS the intro toggle (pink when the intro is shown); no README row.
//   B "Intro as a row"       "Resume" is a plain title; about.md is an ordinary first row above Experience.
//   C "Intro in the head"    roles line sits in the head's right column (like /projects' lede); pane opens on the
//                            first Experience file; about.md is still reachable as a row.
// Copied from src/pages/resume.astro; everything outside the head/intro question is identical across variants.
// SHORTCUT: delete this route (and the switcher) once a variant is chosen; the build is a TDD rewrite into resume.astro.
// /resume/ — the repo explorer (resume-soe.12 D5, F4). Desktop (>860px): two panes, the lime
// section words are the tree, the open file is set like poster type on the right. <=860px: a
// compact accordion; one section and one file open at a time, the file opens inline under its own
// row, and that row turns pink and stays pinned while you read. Every file has a #path deep link.
// The face avatar is the home link; the page renders bare (no site navbar), it owns the viewport.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/site/SiteNav.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import { achievements, education, resumeIntro, workExperience } from '../../../data/resume';
import type { ResumeItem } from '../../../data/resume';
import { skillFiles } from '../../../data/resume-skills';
import { buildSection, buildSkills } from '../../../lib/resume-tree';
import type { TreeFolder } from '../../../lib/resume-tree';

const years = (range: string) => {
  const ys = range.match(/\d{4}/g) ?? [];
  const open = /\.\.\./.test(range);
  const from = ys[0] ?? range;
  const to = open ? 'now' : ys[1];
  return to ? `${from}–${to}` : from;
};

// Skill files carry their filename as an <h1>; the explorer sets a readable title instead.
const acronyms: Record<string, string> = { llm: 'LLM', apis: 'APIs', mmm: 'MMM' };
const titleFromFile = (f: string) =>
  f
    .replace(/\.md$/, '')
    .split('-')
    .map((w) => acronyms[w] ?? w)
    .join(' ')
    .replace(/^./, (c) => c.toUpperCase());

const renderItem = (item: ResumeItem) => {
  const place = [item.company, item.location].filter(Boolean).join(', ');
  const links = item.links?.length
    ? `<p class="p-links">${item.links
        .map((l) => `<a href="${l.href}" target="_blank" rel="noreferrer">${l.label}</a>`)
        .join('')}</p>`
    : '';
  return `
<h2 class="p-title">${item.title.trim()}</h2>
<p class="p-meta"><span class="p-role">${item.role}</span><span>${place}</span><span>${years(item.dateRange)}</span></p>
<div class="p-prose"><p>${item.body}</p></div>
${links}`;
};

const experience = buildSection('experience', workExperience, renderItem);
const achievementSection = buildSection('achievements', achievements, renderItem);
const educationSection = buildSection('education', education, renderItem);
const skills = buildSkills(skillFiles);

for (const [path, html] of Object.entries(skills.contents)) {
  const file = path.split('/').pop() ?? path;
  skills.contents[path] = `
<h2 class="p-title">${titleFromFile(file)}</h2>
<div class="p-prose p-skill">${html.replace(/<h1>[\s\S]*?<\/h1>/, '')}</div>`;
}

// Years shown beside each file in the tree (dated sections only).
const itemYears: Record<string, string> = {};
for (const [section, items] of [
  [experience, workExperience],
  [achievementSection, achievements],
  [educationSection, education],
] as const) {
  section.files.forEach((f, i) => (itemYears[f.path] = years(items[i].dateRange)));
}

const folders: (TreeFolder & { label: string })[] = [
  { name: 'experience', label: 'Experience', files: experience.files },
  { name: 'achievements', label: 'Achievements', files: achievementSection.files },
  { name: 'skills', label: 'Skills', files: [], subfolders: skills.subfolders },
  { name: 'education', label: 'Education', files: educationSection.files },
];
const countFiles = (f: TreeFolder): number =>
  f.files.length + (f.subfolders ?? []).reduce((n, s) => n + countFiles(s), 0);

const readmeHtml = `
<div class="readme">
  <div class="readme-head">
    <h2 class="p-title p-title--readme">Jonatan Snyders</h2>
    <p class="readme-roles">${resumeIntro.headlineBadges.join('<br />')}</p>
  </div>
  <img class="readme-photo" src="/img/jonatan_roaring_no_bg.png" alt="Jonatan on all fours on a rock, roaring at the camera." width="436" height="437" loading="lazy" />
  <div class="p-prose readme-prose">${resumeIntro.paragraphs.map((p) => `<p>${p}</p>`).join('')}</div>
</div>`;

// SHORTCUT: README.md renamed to about.md and its html (readme* class names, roles list) kept as-is; the final name is the human's call.
const ABOUT = 'about.md';
const contents: Record<string, string> = {
  [ABOUT]: readmeHtml,
  ...experience.contents,
  ...achievementSection.contents,
  ...skills.contents,
  ...educationSection.contents,
};
const panelId = (path: string) => 'f-' + path.replace(/[^a-z0-9]+/gi, '-');
// SHORTCUT: variant C default = first Experience file by position (mapular.md, newest); production: explicit data.
const firstExperience = experience.files[0].path;
---

{/* SHORTCUT: prototype title/description; production keeps resume.astro's. */}
<BaseLayout
  bare
  title="Resume (prototype) | Jonatan Snyders"
  description="Prototype of the shared-system resume page."
>
  <div class="resume-page" data-first-exp={firstExperience}>
    <!-- SHORTCUT: variant read client-side (static site, no request-time query); inline script sets it before first paint. -->
    <script is:inline>document.documentElement.dataset.variant = (new URLSearchParams(location.search).get('variant') || 'A').toUpperCase();</script>
    <SiteNav current="resume" />

    <main>
      <div class="head">
        <!-- A: the title is the intro toggle. -->
        <h1 class="title" data-only="A" data-anchor>
          <button class="title-btn file" type="button" data-path={ABOUT} aria-controls={panelId(ABOUT)} aria-current="true"><span>Resume</span><span class="mark" aria-hidden="true"></span></button>
        </h1>
        <h1 class="title" data-only="BC">Resume</h1>
        <!-- SHORTCUT: C's lede is just the roles joined with middots, not drafted copy. -->
        <p class="lede" data-only="C">{resumeIntro.headlineBadges.map((b, i) => <>{i > 0 && ' · '}<span class="nowrap">{b}</span></>)}</p>
      </div>

      <div class="explorer">
        <nav class="tree" id="tree" aria-label="Resume files">
          <ul class="tree-root">
            <li class="folder" data-only="BC">
              <ul class="files files--about">
                <li>
                  <button class="file leaf" type="button" data-path={ABOUT} aria-controls={panelId(ABOUT)}>
                    <span class="leaf-name">about.md</span>
                    <!-- SHORTCUT: 'intro' meta label is placeholder copy. -->
                    <span class="leaf-meta">intro</span>
                    <span class="mark" aria-hidden="true"></span>
                  </button>
                </li>
              </ul>
            </li>
            {folders.map((folder) => (
              <li class="folder">
                <h2 class="group-head">
                  <button
                    class="sect folder-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`dir-${folder.name}`}
                    data-folder={folder.name}
                  >
                    <span>{folder.label}</span>
                    <span class="count" aria-label={`${countFiles(folder)} files`}>{countFiles(folder)}</span>
                    <span class="mark" aria-hidden="true"></span>
                  </button>
                </h2>
                <ul class="files" id={`dir-${folder.name}`} hidden>
                  {folder.files.map((file) => (
                    <li>
                      <button class="file leaf" type="button" data-path={file.path} aria-controls={panelId(file.path)}>
                        <span class="leaf-name"><span class="leaf-dir">{folder.name}/</span>{file.name}</span>
                        {itemYears[file.path] && <span class="leaf-meta">{itemYears[file.path]}</span>}
                        <span class="mark" aria-hidden="true"></span>
                      </button>
                    </li>
                  ))}
                  {folder.subfolders?.map((sub) => (
                    <li class="sub">
                      <button
                        class="sub-toggle"
                        type="button"
                        aria-expanded="false"
                        aria-controls={`dir-${folder.name}-${sub.name}`}
                        data-folder={`${folder.name}/${sub.name}`}
                      >
                        {sub.name}/
                      </button>
                      <ul class="files files--sub" id={`dir-${folder.name}-${sub.name}`} hidden>
                        {sub.files.map((file) => (
                          <li>
                            <button class="file leaf" type="button" data-path={file.path} aria-controls={panelId(file.path)}>
                              <span class="leaf-name"><span class="leaf-dir">{folder.name}/{sub.name}/</span>{file.name}</span>
                              <span class="mark" aria-hidden="true"></span>
                            </button>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </nav>

        <section class="pane" id="pane" aria-label="Open file">
          {Object.entries(contents).map(([path, html]) => {
            const parts = path.split('/');
            const file = parts.pop();
            return (
              <article class="panel" id={panelId(path)} data-panel={path} tabindex="-1" hidden>
                <p class="p-path">
                  {parts.map((p) => <span class="p-dir">{p}/</span>)}
                  <span class="p-file">{file}</span>
                </p>
                <Fragment set:html={html} />
              </article>
            );
          })}
        </section>
      </div>
    </main>

    <SiteFooter />

    <!-- SHORTCUT: prototype-only switcher, shown in production on this route only (human ruling); delete with the route. -->
    <div class="proto-switcher" role="group" aria-label="Prototype variant">
      <button type="button" data-step="-1" aria-label="Previous variant">←</button>
      <span id="proto-label" aria-live="polite"></span>
      <button type="button" data-step="1" aria-label="Next variant">→</button>
    </div>
  </div>
</BaseLayout>

<script>
  // One set of panels, two layouts. Desktop (>860px): two panes, panels live in #pane.
  // <=860px: an accordion; the open panel is moved into the tree, right under its own row.
  const ABOUT = 'about.md';
  const VARIANTS = ['A', 'B', 'C'];
  const NAMES: Record<string, string> = { A: 'Title is the intro', B: 'Intro as a row', C: 'Intro in the head' };
  const rawVariant = (new URLSearchParams(location.search).get('variant') ?? 'A').toUpperCase();
  const variant = VARIANTS.includes(rawVariant) ? rawVariant : 'A';
  const DEFAULT_PATH = variant === 'C' ? (document.querySelector<HTMLElement>('.resume-page')?.dataset.firstExp ?? ABOUT) : ABOUT;
  const desktop = window.matchMedia('(min-width: 861px)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pane = document.getElementById('pane') as HTMLElement;

  const fileButtons = [...document.querySelectorAll<HTMLButtonElement>('.resume-page button[data-path]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const sectionToggles = [...document.querySelectorAll<HTMLButtonElement>('#tree .folder-toggle')];
  let current: string | null = null;

  // A and B/C both render an about.md button; only one is displayed (data-only), so pick the visible one.
  const buttonFor = (path: string) => fileButtons.find((b) => b.dataset.path === path && b.getClientRects().length > 0) ?? fileButtons.find((b) => b.dataset.path === path);
  const panelFor = (path: string) => panels.find((p) => p.dataset.panel === path);
  const behavior = (): ScrollBehavior => (reduced.matches ? 'auto' : 'smooth');

  function setFolder(toggle: HTMLButtonElement, open: boolean) {
    const list = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (!list) return;
    list.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
  }

  // Open every folder on the way to a file, so a deep link shows where you are.
  function revealInTree(path: string) {
    const parts = path.split('/').slice(0, -1);
    for (let i = 1; i <= parts.length; i++) {
      const t = document.querySelector<HTMLButtonElement>(`#tree button[data-folder="${parts.slice(0, i).join('/')}"]`);
      if (t) setFolder(t, true);
    }
  }

  function animateIn(panel: HTMLElement) {
    panel.classList.remove('is-entering');
    void panel.offsetWidth; // restart the entrance
    panel.classList.add('is-entering');
  }

  function sync() {
    const mobile = !desktop.matches;
    for (const b of fileButtons) {
      const on = b.dataset.path === current;
      b.setAttribute('aria-current', String(on));
      if (mobile) b.setAttribute('aria-expanded', String(on));
      else b.removeAttribute('aria-expanded');
      b.closest('li')?.classList.toggle('is-open', mobile && on);
    }
    for (const p of panels) {
      const on = p.dataset.panel === current;
      p.hidden = !on;
      const btn = buttonFor(p.dataset.panel ?? '');
      const anchor = btn?.closest('[data-anchor]') ?? btn; // variant A: under the title, not inside the h1
      if (mobile && on && anchor) anchor.after(p); // inline, right under its row
      else if (p.parentElement !== pane) pane.append(p);
    }
    history.replaceState(null, '', location.pathname + location.search + (!current || current === DEFAULT_PATH ? '' : `#${current}`));
  }

  function open(path: string, userAction: boolean) {
    const panel = panelFor(path);
    if (!panel) return;
    if (!desktop.matches) {
      // Accordion: one section open at a time, so the list stays short.
      const section = path.split('/')[0];
      sectionToggles.forEach((t) => { if (t.dataset.folder !== section) setFolder(t, false); });
    }
    current = path;
    revealInTree(path);
    sync();
    animateIn(panel);
    if (!userAction) return;
    if (desktop.matches) {
      pane.scrollTop = 0;
      if (pane.getBoundingClientRect().top < 0) pane.scrollIntoView({ behavior: behavior() });
    } else {
      // The previous file has folded away above or below; bring this row to the top to read.
      (buttonFor(path)?.closest('[data-anchor]') ?? buttonFor(path)?.closest('li'))?.scrollIntoView({ behavior: behavior(), block: 'start' });
    }
  }

  function close(path: string) {
    const btn = buttonFor(path);
    current = null;
    sync();
    // Folding a long file can leave the row far above the viewport; bring it back.
    if (btn && btn.getBoundingClientRect().top < 0) btn.scrollIntoView({ behavior: 'auto', block: 'start' });
  }

  fileButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const path = b.dataset.path ?? DEFAULT_PATH;
      if (!desktop.matches && current === path) close(path);
      else open(path, true);
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('#tree button[data-folder]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      const isSection = toggle.classList.contains('folder-toggle');
      if (!desktop.matches && isSection) {
        if (opening) sectionToggles.forEach((t) => t !== toggle && setFolder(t, false));
        // A file outside what is still open folds away with its folder.
        const keep = opening ? toggle.dataset.folder : null;
        if (current && current !== ABOUT && current.split('/')[0] !== keep) { current = null; sync(); }
      }
      setFolder(toggle, opening);
      if (!desktop.matches && opening && toggle.getBoundingClientRect().top < 0) {
        toggle.scrollIntoView({ behavior: 'auto', block: 'start' });
      }
    });
  });

  // Crossing the breakpoint: desktop always shows a file (the variant's default file); mobile keeps yours.
  desktop.addEventListener('change', () => {
    if (desktop.matches && !current) current = DEFAULT_PATH;
    sync();
  });

  window.addEventListener('hashchange', () => {
    const path = decodeURIComponent(location.hash.slice(1));
    if (panelFor(path)) open(path, true);
  });

  const fromHash = decodeURIComponent(location.hash.slice(1));
  const exp = document.querySelector<HTMLButtonElement>('#tree button[data-folder="experience"]');
  if (exp) setFolder(exp, true); // the first section is open on arrival, so one tap reads a file
  if (fromHash && panelFor(fromHash)) {
    open(fromHash, false);
    if (!desktop.matches) (buttonFor(fromHash)?.closest('[data-anchor]') ?? buttonFor(fromHash)?.closest('li'))?.scrollIntoView({ block: 'start' });
  } else if (desktop.matches) {
    current = DEFAULT_PATH;
    sync();
  } else {
    current = null;
    sync();
  }

  // ── Prototype switcher: ←/→ cycle, label shows the variant name. ──
  // SHORTCUT: a full navigation per switch (reload) instead of swapping state live; production has one variant.
  const label = document.getElementById('proto-label');
  if (label) label.textContent = `${variant} — ${NAMES[variant]}`;
  const go = (step: number) => {
    const next = VARIANTS[(VARIANTS.indexOf(variant) + step + VARIANTS.length) % VARIANTS.length];
    location.assign(`${location.pathname}?variant=${next}`);
  };
  document.querySelectorAll<HTMLButtonElement>('.proto-switcher [data-step]').forEach((b) =>
    b.addEventListener('click', () => go(Number(b.dataset.step))),
  );
  window.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null;
    if (t && (t.matches('input, textarea, select') || t.isContentEditable)) return;
    if (e.key === 'ArrowLeft') go(-1);
    if (e.key === 'ArrowRight') go(1);
  });
</script>

<style is:global>
  /* Global, not scoped: panel bodies are injected html (set:html) and the script moves panels
     between the pane and the tree, so scoped data-attributes would not reach them. Every rule is
     prefixed .resume-page, and this sheet ships with /resume/ only. */
  html,
  body { background: var(--id-ground); }

  .resume-page {
    --pad: clamp(1rem, 2.4vw, 2.25rem);
    --ease: cubic-bezier(0.25, 1, 0.5, 1);

    min-height: 100svh;
    background: var(--id-ground);
    color: var(--id-paper);
    font-family: var(--id-font-body);
    font-weight: var(--id-weight-body);
    line-height: normal;
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
  }

  .resume-page .panel a { color: inherit; text-decoration: underline; }
  .resume-page a:focus-visible,
  .resume-page button:focus-visible {
    /* Paper, not pink: the selected file is already pink, and the ring must stay visible on it. */
    outline: 3px solid var(--id-paper);
    outline-offset: 3px;
  }

  /* Variant gating: elements tagged data-only render for the listed variants only. */
  html[data-variant='A'] [data-only]:not([data-only*='A']),
  html[data-variant='B'] [data-only]:not([data-only*='B']),
  html[data-variant='C'] [data-only]:not([data-only*='C']) { display: none !important; }

  /* Same shell as /projects: the layout's global main padding is reset, the page sets its own rhythm. */
  .resume-page {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: var(--pad) var(--pad) var(--space-6);
  }
  .resume-page main { flex: 1; min-height: 0; padding: 0; margin-top: clamp(2rem, 6vw, 5rem); }
  .resume-page [hidden] { display: none !important; }

  /* ── head (same grid and tokens as /projects) ── */
  .resume-page .head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: calc(2 * var(--pad)); align-items: end; }
  .resume-page .title { margin: 0; font-size: var(--id-text-poster); font-weight: var(--id-weight-poster); letter-spacing: var(--id-tracking-poster); line-height: var(--id-leading-poster); color: var(--id-lime); }
  .resume-page .nowrap { white-space: nowrap; }
  .resume-page .lede { margin: 0; max-width: 30ch; text-wrap: pretty; font-size: var(--id-text-heading); font-weight: var(--id-weight-medium); line-height: 1.3; letter-spacing: var(--id-tracking-heading); }
  /* SHORTCUT: variant A's title button is not pinned/sticky on mobile like an open row; production decides if it should be. */
  /* Variant A: the title is a button. */
  .resume-page .title-btn { display: inline-flex; align-items: flex-start; gap: 0.12em; font: inherit; letter-spacing: inherit; line-height: inherit; color: inherit; background: none; border: 0; padding: 0 0.04em; margin-left: -0.04em; cursor: pointer; text-align: left; transition: color 160ms var(--ease); }
  .resume-page .title-btn:hover { color: var(--id-paper); }
  .resume-page .title-btn[aria-current='true'] { background: var(--id-pink); color: var(--id-ink); }

  /* ── Explorer: tree left, open file right ─────────────── */
  .resume-page .explorer {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: calc(2 * var(--pad));
    align-items: start;
    min-height: 0;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: 4rem;
  }
  /* The tree is a size container so the longest name ("Achievements" + count) always fits its column. */
  .resume-page .tree { grid-column: 1; }
  .resume-page .pane {
    grid-column: 2;
    position: sticky;
    top: var(--pad);
    max-height: calc(100svh - 2 * var(--pad));
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--id-rule) transparent;
  }

  :where(.resume-page .tree) ul { list-style: none; margin: 0; padding: 0; }
  /* :where() keeps this reset at zero specificity so the type rules below win. */
  :where(.resume-page .tree) button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  /* Section names are group headings, same size as /projects' "Now" / "Past". */
  .resume-page .group-head { margin: 0; font: inherit; }
  .resume-page .folder:not(:last-child) { margin-bottom: var(--space-10); }
  .resume-page .sect {
    display: flex;
    align-items: flex-start;
    gap: 0.12em;
    width: 100%;
    color: var(--id-lime);
    font-weight: var(--id-weight-poster);
    font-size: var(--id-text-display);
    line-height: var(--id-leading-display);
    letter-spacing: var(--id-tracking-display);
    padding: 0 0 var(--space-3);
    transition: color 160ms var(--ease);
  }
  .resume-page .sect:hover { color: var(--id-paper); }
  .resume-page .count {
    font-size: var(--id-text-small);
    font-weight: var(--id-weight-strong);
    letter-spacing: 0;
    line-height: 1;
    padding-top: 0.2em;
    color: var(--id-paper-2);
  }
  .resume-page .folder-toggle[aria-expanded='true'] .count { color: var(--id-lime); }

  /* Files: plain readable lines on a strict two-column rhythm (name, years). */
  .resume-page .files {
    margin: 0;
    border-top: 1px solid var(--id-rule);
  }
  .resume-page .files--about { border-bottom: 1px solid var(--id-rule); }
  .resume-page .files--about .leaf { border-bottom: 0; }
  .resume-page .files--sub { margin: 0 0 0.5rem 1.25rem; border-top: 0; }
  .resume-page .leaf,
  .resume-page .sub-toggle {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 0.5rem;
    border-bottom: 1px solid var(--id-rule);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: var(--id-tracking-heading);
    transition: background-color 140ms var(--ease), color 140ms var(--ease);
  }
