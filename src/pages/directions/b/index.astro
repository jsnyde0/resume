---
// PROTOTYPE (resume-soe.12), direction B "Runway": the homepage as a fashion-magazine cover.
import DirectionSwitcher from '../../../components/directions/DirectionSwitcher.astro';
import RunwayHead from '../../../components/directions/b/RunwayHead.astro';
import RunwayStrip from '../../../components/directions/b/RunwayStrip.astro';
import RunwayFooter from '../../../components/directions/b/RunwayFooter.astro';
import { resumeIntro, workExperience } from '../../../data/resume';

const lookCount = workExperience.length;
const firstYear = Math.min(...workExperience.map((w) => Number(w.dateRange.match(/\d{4}/)?.[0] ?? 9999)));
const words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const looksWord = words[lookCount] ?? String(lookCount);

// SHORTCUT: editor's letter hand-picks intro paragraphs by index instead of a curated field in src/data.
const letter = [resumeIntro.paragraphs[0], resumeIntro.paragraphs[2], resumeIntro.paragraphs[5]];
---
<!doctype html>
<html lang="en">
  <head>
    <RunwayHead
      title="Jonatan Snyders, Issue Nº 37"
      description="Jonatan Snyders: from catwalks to startups, agent harnesses to existential dread."
    />
  </head>
  <body>
    <a class="rw-skip" href="#main">Skip to content</a>

    <RunwayStrip current="home" mid="Berlin · Autumn / Winter 2026" />

    <main id="main">
      <section class="cover" aria-labelledby="mast">
        <h1 id="mast" class="mast" data-par="0.22" aria-label="Jonatan Snyders">
          <span class="mast-a rw-rise">Jonatan</span>
          <span class="mast-b rw-rise" style="--d: 120ms">Snyders</span>
        </h1>

        <img
          class="model rw-rise"
          style="--d: 260ms"
          data-par="-0.06"
          src="/img/jonatan_posing_rocks_no_bg.png"
          alt="Jonatan mid-stride in a lime T-shirt, black cycling bib shorts with red cuffs, patterned socks and pink Crocs, striking a runway pose."
          width="500"
          height="499"
          fetchpriority="high"
        />

        <p class="coverline rw-rise" style="--d: 420ms">
          From catwalks to startups, agent harnesses to existential dread.
        </p>

        <!-- SHORTCUT: hard-coded cover copy (issue details, cover-line deks, fake page numbers p. 02 / p. 37); not sourced from src/data. -->
        <dl class="issue rw-rise" style="--d: 520ms">
          <div><dt class="rw-label">Role</dt><dd>Agentic engineer</dd></div>
          <div><dt class="rw-label">Based</dt><dd>Berlin</dd></div>
          <div><dt class="rw-label">Formerly</dt><dd>Model, founder</dd></div>
        </dl>

        <ul class="lines rw-rise" style="--d: 620ms" aria-label="In this issue">
          <li>
            <a href="/directions/b/resume/">
              <span class="rw-label lines-kick">p. 02 &middot; What bores me</span>
              <span class="lines-title">The Lookbook</span>
              <span class="lines-dek">{looksWord} looks, {firstYear} to now. The résumé, styled.</span>
            </a>
          </li>
          <li>
            <a href="/factory/">
              <span class="rw-label lines-kick">p. 37 &middot; What excites me</span>
              <span class="lines-title">Inside the Factory</span>
              <span class="lines-dek">Agents that ship while he takes a long lunch.</span>
            </a>
          </li>
        </ul>
      </section>

      <section class="letter" aria-labelledby="letter-h">
        <p class="rw-label letter-kick">Editor&rsquo;s letter</p>
        <h2 id="letter-h" class="letter-h">Following what gives him energy, not rigid plans.</h2>
        <div class="letter-body">
          {letter.map((p) => <p>{p}</p>)}
          <p class="letter-sign">J.S.</p>
        </div>
      </section>
    </main>

    <RunwayFooter />

    <script>
      // Subtle scroll parallax on the cover: transform only, skipped for reduced motion.
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-par]'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      let ticking = false;
      const apply = () => {
        ticking = false;
        const y = Math.min(window.scrollY, window.innerHeight * 1.2);
        for (const el of els) {
          el.style.setProperty('--py', `${(y * Number(el.dataset.par)).toFixed(1)}px`);
        }
      };
      if (!reduce.matches) {
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(apply);
            }
          },
          { passive: true },
        );
      }
    </script>

    <DirectionSwitcher current="b" page="home" />
  </body>
</html>

<style>
  /* ---------- the cover ---------- */
  .cover {
    position: relative;
    height: calc(100svh - 3.25rem);
    min-height: 40rem;
    overflow: hidden;
    isolation: isolate;
    /* a single soft studio spot behind the model; no decorative blur */
    background: radial-gradient(ellipse 38% 55% at 50% 62%, #1f1a19 0%, rgba(10, 9, 9, 0) 100%);
  }
  .mast {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0.6vw 1.2vw 0;
    display: flex;
    justify-content: space-between;
    gap: 0;
    font-family: var(--rw-mast);
    font-weight: 400;
    font-size: 19.2vw;
    line-height: 0.78;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: var(--rw-red);
    white-space: nowrap;
    translate: 0 var(--py, 0px);
  }
  .mast span {
    display: block;
  }
  .model {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: -1svh;
    height: 104%;
    width: auto;
    translate: -50% var(--py, 0px);
    /* thin rim light so the black bib shorts read against the black ground */
    filter: drop-shadow(0 0 1px rgba(243, 239, 232, 0.5));
    pointer-events: none;
  }
  .coverline {
    position: absolute;
    z-index: 3;
    left: clamp(1.25rem, 3vw, 2.5rem);
    bottom: clamp(2rem, 7svh, 5rem);
    max-width: 11.5em;
    margin: 0;
    font-family: var(--rw-serif);
    font-style: italic;
    font-weight: 500;
    font-variation-settings: 'opsz' 96;
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--rw-paper);
  }
  .issue {
    position: absolute;
    z-index: 3;
    left: clamp(1.25rem, 3vw, 2.5rem);
    top: calc(19.2vw * 0.8 + 3rem);
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .issue div {
    display: grid;
    align-content: start;
    gap: 0.15rem;
  }
  .issue dt {
    color: var(--rw-red);
  }
  .issue dd {
    margin: 0;
    font-family: var(--rw-serif);
    font-size: 1.05rem;
  }
  .lines {
    position: absolute;
    z-index: 3;
    right: clamp(1.25rem, 3vw, 2.5rem);
    bottom: clamp(2rem, 7svh, 5rem);
    width: min(21rem, 28vw);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    text-align: right;
  }
  .lines a {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--rw-paper);
  }
  .lines-kick {
    color: var(--rw-red);
  }
  .lines-title {
    font-family: var(--rw-mast);
    font-size: clamp(2.25rem, 3.4vw, 3.25rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transition: color 0.3s;
  }
  .lines-dek {
    font-family: var(--rw-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--rw-mute);
  }
  .lines a:hover .lines-title,
  .lines a:focus-visible .lines-title {
    color: var(--rw-red);
  }

  /* ---------- editor's letter ---------- */
  .letter {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    padding: clamp(5rem, 12vw, 10rem) clamp(1.25rem, 4vw, 3.5rem);
    max-width: 90rem;
    margin: 0 auto;
  }
  .letter-kick {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--rw-red);
  }
  .letter-h {
    margin: 0;
    font-family: var(--rw-serif);
    font-weight: 400;
    font-style: italic;
    font-variation-settings: 'opsz' 40;
    font-size: clamp(2.25rem, 4.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .letter-body {
    max-width: 34rem;
    padding-top: 0.75rem;
  }
  .letter-body p {
    margin: 0 0 1.25em;
    font-size: 1.2rem;
    line-height: 1.6;
    color: #d9d3ca;
  }
  .letter-sign {
    font-style: italic;
    color: var(--rw-mute) !important;
  }

  /* ---------- narrow: cover reflows into a vertical stack ---------- */
  @media (max-width: 760px) {
    .cover {
      background: none;
    }
    .cover {
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .mast {
      flex-direction: column;
      font-size: 39vw;
      line-height: 0.8;
      padding: 1.5vw 2vw 0;
    }
    .mast-a {
      letter-spacing: 0.02em;
    }
    .model {
      position: relative;
      left: auto;
      bottom: auto;
      margin: -66vw auto 0;
      height: auto;
      width: 132vw;
      max-width: none;
      translate: 0 var(--py, 0px);
      align-self: center;
    }
    .coverline {
      position: relative;
      left: auto;
      bottom: auto;
      margin: 1.5rem 1.25rem 0;
      font-size: 2.15rem;
    }
    .issue {
      position: relative;
      top: auto;
      left: auto;
      margin: 2rem 1.25rem 0;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .lines {
      position: relative;
      right: auto;
      bottom: auto;
      width: auto;
      margin: 2.5rem 1.25rem 3rem;
      text-align: left;
      gap: 0;
      border-top: 1px solid var(--rw-line);
    }
    .lines li {
      border-bottom: 1px solid var(--rw-line);
    }
    .lines a {
      padding: 1.25rem 0;
    }
    .letter {
      grid-template-columns: 1fr;
    }
  }
</style>
