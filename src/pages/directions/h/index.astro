---
// PROTOTYPE (resume-soe.12) direction H "Cut-out": homepage.
// The photo is the layout. Jonatan, scaled to the full viewport height, is the page's structural column:
// a lime band runs through at shirt height, the type wraps his silhouette (shape-outside on the
// transparent PNG), and his forward clog steps onto a pink block that holds the links.
import DirectionSwitcher from '../../../components/directions/DirectionSwitcher.astro';
const photo = '/img/jonatan_posing_rocks_no_bg.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Jonatan Snyders</title>
    <meta name="description" content="Jonatan Snyders. From catwalks to startups, agent harnesses to existential dread." />
    <!-- SHORTCUT: Google Fonts link instead of self-hosted fonts. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap"
    />
  </head>
  <body>
    <main class="hero">
      <div class="stage">
        <span class="band" aria-hidden="true"></span>
        <!-- SHORTCUT: the source PNG is 500px; at desktop heights it renders ~2x and goes soft. Accepted: the body is structure here, not a portrait. -->
        <img
          class="figure"
          src={photo}
          alt="Jonatan mid-stride in a lime T-shirt, black cycling bibs and pink clogs."
          width="500"
          height="499"
          fetchpriority="high"
        />
        <h1 class="name">Jonatan <span class="last">Snyders</span></h1>
        <p class="line">From catwalks to startups, agent harnesses to existential dread.</p>
        <nav class="step" aria-label="Site">
          <ul>
            <li><a href="/directions/h/resume/">Resume</a></li>
            <li><a href="/factory/">Factory</a></li>
            <li><a href="https://github.com/jsnyde0" rel="noopener">GitHub</a></li>
            <li><a href="https://www.linkedin.com/in/jonatan-snyders/" rel="noopener">LinkedIn</a></li>
          </ul>
        </nav>
      </div>
    </main>

    <DirectionSwitcher current="h" page="home" />
  </body>
</html>

<style is:global>
  :root {
    /* Brand colours, lifted from the photo and brightened: shirt lime, clog pink, bib black. */
    --h-lime: #c6e46c;
    --h-pink: #e79bc8;
    --h-ink: #141414;
    --h-paper: #f2f0ea;
    --h-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --h-font: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
  }
  html { background: var(--h-paper); }
  body {
    margin: 0;
    color: var(--h-ink);
    font-family: var(--h-font);
    -webkit-font-smoothing: antialiased;
  }
</style>

<style>
  /*
   * Geometry. Everything is measured in --b, the rendered size of the 500x499 photo box.
   * Landmarks in the source (fraction of the box): head 0.062, shirt 0.176 to 0.36,
   * front clog sole 0.89 (heel at x 0.64), back clog sole 0.966.
   */
  .hero {
    --H: max(100svh, 680px);
    --b: min(calc(var(--H) * 1.14), 1120px);
    --x: calc(var(--b) * -0.11 + 1vw);
    position: relative;
    height: var(--H);
    overflow: clip;
  }
  /* The stage is the photo box's coordinate space: its top is where the box starts (above the fold, so the crown crops). */
  .stage {
    position: absolute;
    left: var(--x);
    right: 0;
    top: calc(var(--H) - 0.966 * var(--b));
    height: var(--b);
  }

  .figure {
    float: left;
    position: relative;
    z-index: 1;
    width: var(--b);
    height: var(--b);
    shape-outside: url('/img/jonatan_posing_rocks_no_bg.png');
    shape-image-threshold: 0.4;
    shape-margin: calc(var(--b) * 0.03);
  }

  /* Lime band at shirt height, full bleed behind the body: the shirt keeps going. */
  .band {
    position: absolute;
    z-index: 0;
    left: calc(var(--x) * -1);
    right: 0;
    top: calc(var(--b) * 0.19);
    height: calc(var(--b) * 0.165);
    background: var(--h-lime);
  }

  .name {
    position: relative;
    z-index: 2;
    margin: 0;
    padding-top: calc(var(--b) * 0.19);
    padding-right: 3rem;
    font-size: calc(var(--b) * 0.088);
    font-weight: 800;
    font-variation-settings: 'opsz' 96;
    line-height: 0.94;
    letter-spacing: -0.045em;
  }
  .last { display: block; }

  .line {
    position: relative;
    z-index: 2;
    margin: calc(var(--b) * 0.055) 0 0;
    padding-right: max(2.5rem, 5vw);
    font-size: calc(var(--b) * 0.07);
    font-weight: 500;
    font-variation-settings: 'opsz' 60;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  /* Pink block under the forward clog: he steps onto it. It holds the ways on. */
  .step {
    position: absolute;
    z-index: 0;
    left: calc(var(--b) * 0.64);
    right: 0;
    top: calc(var(--b) * 0.894);
    height: calc(var(--b) * 0.072 + 1px);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 clamp(1.25rem, 2.8vw, 2.5rem) 0 calc(var(--b) * 0.12);
    background: var(--h-pink);
  }
  .step ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1.25rem, 2.6vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--h-ink);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    background: linear-gradient(var(--h-ink), var(--h-ink)) 0 calc(100% - 9px) / 0 2px no-repeat;
    transition: background-size 0.35s var(--h-ease);
  }
  .step a:hover { background-size: 100% 2px; }
  .step a:focus-visible {
    outline: 3px solid var(--h-ink);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Phone: the stride spans the screen width; the pink block becomes a pedestal that holds the links stacked. */
  @media (max-width: 760px), (orientation: portrait) and (max-width: 1100px) {
    .hero {
      --b: calc(100vw * 1.22);
      --x: calc(var(--b) * -0.252);
      --lift: calc(var(--b) * 0.03);
      --pedestal: 12.5rem;
      height: max(100svh, calc(0.966 * var(--b) - var(--lift) + var(--pedestal) - var(--b) * 0.072));
    }
    .stage {
      /* Centre the figure-plus-pedestal in tall screens; on short ones, crop the crown like desktop. */
      top: max(calc(var(--lift) * -1), calc((100svh - var(--b) * 0.894 - var(--pedestal)) / 2));
      bottom: 0;
      height: auto;
    }
    .band { top: calc(var(--b) * 0.17); height: calc(var(--b) * 0.19); }
    .name {
      padding-top: calc(var(--b) * 0.185);
      padding-right: 1rem;
      font-size: calc(var(--b) * 0.084);
    }
    .line {
      margin-top: calc(var(--b) * 0.05);
      padding-right: 1rem;
      font-size: calc(var(--b) * 0.041);
      line-height: 1.12;
    }
    .step {
      top: calc(var(--b) * 0.894);
      height: auto;
      bottom: 0;
      align-items: flex-start;
      padding: 1rem 1.25rem 5rem;
    }
    .step ul { flex-direction: column; align-items: flex-end; gap: 0; }
    .step a { font-size: 1.375rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .figure { animation: h-in 1.1s var(--h-ease) both; }
    .band { transform-origin: left center; animation: h-wipe 1s var(--h-ease) 0.15s both; }
    .name, .line, .step ul { animation: h-fade 0.9s var(--h-ease) both; }
    .name { animation-delay: 0.35s; }
    .line { animation-delay: 0.5s; }
    .step ul { animation-delay: 0.65s; }
    @keyframes h-in { from { opacity: 0; transform: translateX(-3%); } }
    @keyframes h-wipe { from { transform: scaleX(0); } }
    @keyframes h-fade { from { opacity: 0; transform: translateY(0.4rem); } }
  }
</style>
