---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { projectEntries, projectsIntro } from '../data/projects';
---

<BaseLayout title="Building | Jonatan Snyders" description="Things Jonatan Snyders has built and tools he builds on — a reference list linking real repos.">
  <div class="projects-page" id="projects">
    <header class="projects-page__intro">
      <h1>{projectsIntro.title}</h1>
      <p>{projectsIntro.description}</p>
    </header>

    <div class="projects-page__list">
      {projectEntries.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>

  <style>
    .projects-page {
      width: min(100%, 52rem);
      margin: 0 auto;
    }

    .projects-page__intro {
      max-width: 42rem;
      margin: 0 auto 3rem;
      text-align: center;
    }

    .projects-page__intro h1 {
      margin: 0 0 1.25rem;
      font-size: clamp(2rem, 4vw, 2.5rem);
      line-height: 1.1;
    }

    .projects-page__intro p {
      margin: 0;
      font-size: clamp(1rem, 2vw, 1.15rem);
      line-height: 1.65;
    }

    .projects-page__list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
  </style>
</BaseLayout>
