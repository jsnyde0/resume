---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { projectEntries, projectsIntro } from '../data/projects';
---

<BaseLayout title="Building | Jonatan Snyders" description="Things Jonatan Snyders has built — products, tools, and research software, from a sandboxing CLI to a cited academic toolbox and a location-intelligence platform.">
  <div class="projects-page" id="projects">
    <header class="projects-page__intro">
      <h1>{projectsIntro.title}</h1>
      <p>{projectsIntro.description}</p>
    </header>

    <div class="projects-page__list">
      {projectEntries.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>

  <style>
    .projects-page {
      width: min(100%, var(--container-narrow));
      margin: 0 auto;
    }

    .projects-page__intro {
      max-width: var(--container-prose);
      margin: 0 auto var(--space-12);
      text-align: center;
    }

    .projects-page__intro h1 {
      margin: 0 0 var(--space-5);
      font-size: var(--text-title);
      line-height: 1.1;
    }

    .projects-page__intro p {
      margin: 0;
      font-size: var(--text-lead);
      line-height: var(--line-height-relaxed);
    }

    .projects-page__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
  </style>
</BaseLayout>
