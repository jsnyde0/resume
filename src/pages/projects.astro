---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { projectEntries, projectsIntro } from '../data/projects';
---

<BaseLayout title="Side Projects | Jonatan Snyders" description="Side projects by Jonatan Snyders across web development, data tooling, and experiments.">
  <div class="projects-page" id="projects">
    <header class="projects-page__intro">
      <h1>{projectsIntro.title}</h1>
      <p>{projectsIntro.description}</p>
    </header>

    <div class="projects-page__stack">
      {projectEntries.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>

  <script>
    const setCarouselIndex = (root, nextIndex) => {
      const slides = Array.from(root.querySelectorAll('[data-carousel-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-carousel-dot]'));
      if (slides.length === 0) return;

      const normalizedIndex = (nextIndex + slides.length) % slides.length;
      root.dataset.carouselIndex = String(normalizedIndex);

      slides.forEach((slide, index) => {
        slide.toggleAttribute('hidden', index !== normalizedIndex);
      });

      dots.forEach((dot, index) => {
        dot.setAttribute('aria-pressed', String(index === normalizedIndex));
      });
    };

    document.querySelectorAll('[data-carousel-root]').forEach((root) => {
      setCarouselIndex(root, Number(root.dataset.carouselIndex ?? 0));

      root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => {
        const currentIndex = Number(root.dataset.carouselIndex ?? 0);
        setCarouselIndex(root, currentIndex - 1);
      });

      root.querySelector('[data-carousel-next]')?.addEventListener('click', () => {
        const currentIndex = Number(root.dataset.carouselIndex ?? 0);
        setCarouselIndex(root, currentIndex + 1);
      });

      root.querySelectorAll('[data-carousel-dot]').forEach((dot) => {
        dot.addEventListener('click', () => {
          const targetIndex = Number(dot.getAttribute('data-carousel-dot') ?? 0);
          setCarouselIndex(root, targetIndex);
        });
      });
    });
  </script>

  <style>
    .projects-page {
      width: min(100%, 72rem);
      margin: 0 auto;
    }

    .projects-page__intro {
      max-width: 52rem;
      margin: 0 auto 4rem;
      text-align: center;
    }

    .projects-page__intro h1 {
      margin: 0 0 1.5rem;
      font-size: clamp(2rem, 4vw, 2.5rem);
      line-height: 1.1;
    }

    .projects-page__intro p {
      margin: 0;
      font-size: clamp(1rem, 2vw, 1.2rem);
      line-height: 1.65;
    }

    .projects-page__stack {
      display: grid;
      gap: 2.5rem;
    }
  </style>
</BaseLayout>
