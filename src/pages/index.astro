---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Jonatan Snyders' Resume">
  <div id="home-content" class="home-content">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>Jonatan Snyders</h1>
        <p>From fashion icon to former founder, web developer to data scientist.</p>
        <div class="hero-actions">
          <a href="/resume/" class="button button-primary">
            See resume
            <svg fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
            </svg>
          </a>
          <a href="/projects/" class="button button-secondary">Check out projects</a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/img/jonatan_posing_rocks_no_bg.png" alt="Jonatan posing on rocks" width="600" height="600" />
      </div>
    </div>
  </div>
</BaseLayout>
