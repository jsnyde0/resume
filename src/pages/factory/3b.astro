---
// PROTOTYPE (resume-t7j round 3, variant 3b): 2a's flat SVG world + scroll camera, with the recursion drawn as a
// dispatch TREE (left) linked by thin lines to the regions of the project MAP (right) that each node owns.
// The same dispatch move (edge draws, pulse travels, child pops, scope outline + link draw) is generated by one
// function and played at every level, so the visitor sees one move repeat one level down.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import PrototypeSwitcher from '../../components/factory-prototype/PrototypeSwitcher.astro';
import { intro, beats, creditsHeading, credits } from '../../components/factory-prototype/beats-v3';
import {
  BOX, LAPTOP, B, S, NODE_R, LEAF_Y, LEAF_W, LEAF_H, MAP, SCOPE_A, PORT_X, LEAVES, LEAF, W2, W2_DISPATCH_T,
  SANDBOX, STEP_W, STEP_X0, GROUND_Y, stepTop, PAPER, P5, edgePath, lanePath,
} from '../../components/factory-prototype/3b/world';
import { STAMP_T } from '../../components/factory-prototype/3b/timeline';

const r = (a: number, b: number) => `${a.toFixed(2)},${b.toFixed(2)}`;
/** the ONE dispatch move, as time windows, used at every level */
const dispatch = (t0: number) => ({
  edge: r(t0, t0 + 0.12),
  pulse: r(t0, t0 + 0.16),
  pop: r(t0 + 0.12, t0 + 0.26),
  scope: r(t0 + 0.16, t0 + 0.4),
});
const DS = dispatch(3.2); // brain -> sub-brain
const DW2 = dispatch(W2_DISPATCH_T); // driver -> worker (no new scope: it inherits its driver's)

const blobs: [number, number, number][][] = [
  [[0, 0, 190], [-120, 60, 120], [110, -80, 130]],
  [[0, 0, 140], [90, 70, 90], [-90, -60, 90]],
  [[0, 0, 170], [130, -40, 100], [-100, 90, 110]],
  [[0, 0, 130], [-80, -50, 90], [80, 60, 80]],
  [[0, 0, 150], [100, 60, 90], [-90, -70, 90]],
];
const FOG_SCALE = 0.62;
const fogPatches = [
  ...LEAVES.map((l, i) => ({ c: l.patch, blob: l.blob, inT: 2.8 + i * 0.07, outR: l.doneT })),
  { c: P5, blob: 4, inT: 3.0, outR: null as [number, number] | null },
];

const stepsPath = (() => {
  let d = `M${STEP_X0} ${GROUND_Y}`;
  for (let i = 0; i < 5; i++) d += ` L${STEP_X0 + STEP_W * i} ${stepTop(i)} L${STEP_X0 + STEP_W * (i + 1)} ${stepTop(i)}`;
  return d + ` L${STEP_X0 + STEP_W * 5} ${GROUND_Y} Z`;
})();
// SHORTCUT: the tree has spike/prototype/build drivers + workers; beats-v3 copy for beat 4 also names a brainstorm driver that is not drawn (copy or tree needs to change).
// SHORTCUT: the hill's 'fail' at step 3 is only the card sliding back one step; no distinct failed-check mark.
const passT = [6.32, 6.42, 6.7, 6.8, 6.92];

const gridX = Array.from({ length: 8 }, (_, i) => MAP.x + 50 + i * 190);
const gridY = Array.from({ length: 11 }, (_, i) => MAP.y + 100 + i * 190);
const leafTop = LEAF_Y - LEAF_H / 2;
const leafBottom = LEAF_Y + LEAF_H / 2;
const W2_H = 140;
const pulses: { along: string; t: string }[] = [
  { along: 'e-B-S', t: DS.pulse },
  ...LEAVES.map((l) => ({ along: `e-${l.id}`, t: dispatch(l.dispatchT).pulse })),
  { along: 'e-build-W2', t: DW2.pulse },
  // agents come back after the power cut and pick up from the paper: same pulse along the same edges
  { along: 'p-paper-B', t: '8.88,9.0' },
  { along: 'e-B-S', t: '8.98,9.1' },
  ...LEAVES.map((l, i) => ({ along: `e-${l.id}`, t: r(9.08 + i * 0.03, 9.2 + i * 0.03) })),
];
---

<BaseLayout bare title="How I build (prototype 3b) | Jonatan Snyders" description="Follow one task through a factory of AI agents.">
  <div class="p3b">
    <div class="navwrap"><SiteNav current="factory" /></div>

    <!-- SHORTCUT: track height (10 units x 1.2 screens + 1) is a magic number; production tunes pacing per beat. -->
    <section class="track" id="track" aria-label="Follow one task through the factory">
      <div class="stage" id="stage">
        <svg id="world-svg" class="svg" aria-hidden="true" focusable="false">
          <!-- SHORTCUT: no viewBox, the camera is a JS transform on #world; without JS the world is blank. Production needs a no-JS static fallback. -->
          <g id="world">
            <!-- ===== the home box ===== -->
            <rect id="box-frame" x={BOX.x} y={BOX.y} width={BOX.w} height={BOX.h} fill="none" stroke="var(--id-paper-2)" stroke-width="8" />
            <text x="40" y="-48" class="lab">HOME BOX</text>
            <circle cx={BOX.w - 120} cy="110" r="26" fill="var(--id-lime)" />
            <circle class="hb" cx={BOX.w - 120} cy="110" r="26" fill="none" stroke="var(--id-lime)" stroke-width="8" />

            <!-- ===== my laptop (open screen squashes shut at the end) ===== -->
            <g id="lid">
              <rect x={LAPTOP.cx - LAPTOP.w / 2} y={LAPTOP.screenTop} width={LAPTOP.w} height={LAPTOP.screenBottom - LAPTOP.screenTop} fill="var(--id-ground)" stroke="var(--id-paper-2)" stroke-width="10" />
              <g fill="var(--id-paper-2)" opacity="0.7">
                <rect x="640" y="-1131" width="520" height="22" />
                <rect x="640" y="-1071" width="720" height="22" />
                <rect x="640" y="-1001" width="380" height="22" />
              </g>
            </g>
            <rect x={LAPTOP.cx - LAPTOP.baseW / 2} y={LAPTOP.screenBottom} width={LAPTOP.baseW} height="70" fill="var(--id-paper-2)" />
            <text x={LAPTOP.cx - LAPTOP.baseW / 2} y="-440" class="lab">MY LAPTOP</text>

            <!-- SSH: one line from the laptop, through the box wall, to the brain -->
            <path d={`M${B[0]} ${LAPTOP.screenBottom + 70} L${B[0]} 0`} pathLength="1" data-draw="0.3,1.4" fill="none" stroke="var(--id-lime)" stroke-width="8" />
            <path d={`M${B[0]} 0 L${B[0]} ${B[1] - NODE_R}`} pathLength="1" data-draw="2.0,2.35" fill="none" stroke="var(--id-lime)" stroke-width="8" />
            <text x={B[0] + 36} y="-190" class="lab" data-in="0.5,1.2">SSH</text>

            <!-- ===== the project map (right): clear ground + fog ===== -->
            <g data-in="2.5,2.85" fill="none">
              <rect x={MAP.x} y={MAP.y} width={MAP.w} height={MAP.h} fill="var(--id-paper)" fill-opacity="0.05" />
              {gridX.map((x) => <line x1={x} y1={MAP.y} x2={x} y2={MAP.y + MAP.h} stroke="var(--id-rule)" stroke-width="2" />)}
              {gridY.map((y) => <line x1={MAP.x} y1={y} x2={MAP.x + MAP.w} y2={y} stroke="var(--id-rule)" stroke-width="2" />)}
              <rect x={MAP.x} y={MAP.y} width={MAP.w} height={MAP.h} stroke="var(--id-paper-2)" stroke-width="4" />
            </g>
            <text x={MAP.x + 10} y={MAP.y - 40} class="lab" data-in="2.5,2.85">PROJECT MAP</text>
            <!-- built things on clear ground -->
            <g data-in="2.6,2.95">
              <g fill="var(--id-lime)">
                <rect x="2520" y="410" width="40" height="40" />
                <rect x="3480" y="700" width="40" height="40" />
                <rect x="3440" y="1500" width="40" height="40" />
                <rect x="2470" y="1200" width="40" height="40" />
                <rect x="2480" y="1820" width="40" height="40" />
                <rect x="3520" y="1880" width="40" height="40" />
                <rect x="2600" y="2180" width="40" height="40" />
              </g>
              <g stroke="var(--id-lime-dim)" stroke-width="4" fill="none">
                <path d="M2540 450 L2540 540 L2900 540" />
                <path d="M3500 740 L3500 960" />
                <path d="M2500 1860 L2500 2180 L2600 2180" />
                <path d="M3540 1920 L3540 2100" />
              </g>
            </g>
            <!-- fog: a patch grows in, clears when its owner finishes. Patches never nest or overlap. -->
            {fogPatches.map((f) => (
              <g transform={`translate(${f.c[0]} ${f.c[1]}) scale(${FOG_SCALE})`}>
                <g data-fog data-in={r(f.inT, f.inT + 0.25)} data-out={f.outR ? r(f.outR[0], f.outR[1]) : undefined}>
                  <g fill="var(--id-ground)">{blobs[f.blob].map(([dx, dy, rr]) => <circle cx={dx} cy={dy} r={rr} />)}</g>
                  <g fill="var(--id-paper-2)" opacity="0.34">{blobs[f.blob].map(([dx, dy, rr]) => <circle cx={dx} cy={dy} r={rr} />)}</g>
                </g>
              </g>
            ))}

            <!-- ===== brain (the first node) and its link to the whole map ===== -->
            <path id="l-B-map" d={`M${B[0] + NODE_R + 14} ${B[1]} L${PORT_X} ${B[1]}`} pathLength="1" data-draw="2.75,3.05" fill="none" stroke="var(--id-lime-dim)" stroke-width="5" />
            <g data-in="2.35,2.5" data-pop>
              <circle cx={B[0]} cy={B[1]} r={NODE_R} fill="var(--id-ground)" stroke="var(--id-lime)" stroke-width="8" />
              <circle cx={B[0]} cy={B[1]} r="26" fill="var(--id-lime)" />
              <text x={B[0] - NODE_R - 24} y={B[1] + 14} text-anchor="end" class="lab">BRAIN</text>
            </g>
            <circle class="hb" cx={B[0]} cy={B[1]} r={NODE_R} fill="none" stroke="var(--id-lime)" stroke-width="8" />

            <!-- ===== dispatch level 1: brain -> sub-brain; the sub-brain owns scope A ===== -->
            <path id="e-B-S" d={`M${B[0]} ${B[1] + NODE_R} L${S[0]} ${S[1] - NODE_R}`} pathLength="1" data-draw={DS.edge} fill="none" stroke="var(--id-lime)" stroke-width="8" />
            <g data-in={DS.pop} data-pop>
              <circle cx={S[0]} cy={S[1]} r={NODE_R} fill="var(--id-ground)" stroke="var(--id-lime)" stroke-width="8" />
              <circle cx={S[0]} cy={S[1]} r="26" fill="var(--id-lime)" />
              <text x={S[0] - NODE_R - 24} y={S[1] + 14} text-anchor="end" class="lab">SUB-BRAIN</text>
            </g>
            <rect x={SCOPE_A.x} y={SCOPE_A.y} width={SCOPE_A.w} height={SCOPE_A.h} fill="none" stroke="var(--id-lime)" stroke-width="6" pathLength="1" data-draw={DS.scope} />
            <path d={`M${S[0] + NODE_R + 14} ${S[1]} L${SCOPE_A.x} ${S[1]}`} pathLength="1" data-draw={DS.scope} fill="none" stroke="var(--id-lime-dim)" stroke-width="5" />

            <!-- ===== dispatch level 2: the sub-brain does the same move to four children ===== -->
            {LEAVES.map((l) => {
              const d = dispatch(l.dispatchT);
              const worker = l.role === 'WORKER';
              const [pcx, pcy] = l.patch;
              return (
                <>
                  <path id={`e-${l.id}`} d={edgePath([l.x, leafTop], leafTop)} pathLength="1" data-draw={d.edge} fill="none" stroke="var(--id-lime)" stroke-width="8" />
                  <g data-in={d.pop} data-pop>
                    <rect x={l.x - LEAF_W / 2} y={leafTop} width={LEAF_W} height={LEAF_H} fill={worker ? 'var(--id-lime)' : 'var(--id-ground)'} stroke="var(--id-lime)" stroke-width="8" />
                    <text x={l.x} y={LEAF_Y - 12} text-anchor="middle" class="nrole" fill={worker ? 'var(--id-ink)' : 'var(--id-lime)'}>{l.role}</text>
                    <text x={l.x} y={LEAF_Y + 38} text-anchor="middle" class="nmeth" fill={worker ? 'var(--id-ink)' : 'var(--id-paper)'}>{l.method}</text>
                  </g>
                  <path d={lanePath(l)} pathLength="1" data-draw={d.scope} fill="none" stroke="var(--id-lime-dim)" stroke-width="5" />
                  <circle cx={pcx} cy={pcy} r="175" pathLength="1" data-draw={d.scope} fill="none" stroke="var(--id-lime)" stroke-width="6" />
                  <rect x={l.x + LEAF_W / 2 - 52} y={leafTop + 16} width="26" height="26" fill={worker ? 'var(--id-ink)' : 'var(--id-lime)'} data-in={r(l.doneT[0], l.doneT[1])} />
                </>
              );
            })}

            <!-- ===== dispatch level 3: the build driver hands the card to a worker; a sandbox hangs under it ===== -->
            <path id="e-build-W2" d={`M${LEAF.build.x} ${leafBottom} L${W2[0]} ${W2[1] - W2_H / 2}`} pathLength="1" data-draw={DW2.edge} fill="none" stroke="var(--id-lime)" stroke-width="8" />
            <g data-in={DW2.pop} data-pop>
              <rect x={W2[0] - LEAF_W / 2} y={W2[1] - W2_H / 2} width={LEAF_W} height={W2_H} fill="var(--id-lime)" stroke="var(--id-lime)" stroke-width="8" />
              <text x={W2[0]} y={W2[1] - 12} text-anchor="middle" class="nrole" fill="var(--id-ink)">WORKER</text>
              <text x={W2[0]} y={W2[1] + 38} text-anchor="middle" class="nmeth" fill="var(--id-ink)">SANDBOX</text>
            </g>
            <g data-in="5.85,6.0">
              <path d={`M${W2[0]} ${W2[1] + W2_H / 2} L${W2[0]} ${SANDBOX.y}`} fill="none" stroke="var(--id-lime)" stroke-width="8" />
              <path d={`M${W2[0] - 60} ${SANDBOX.y} L${SANDBOX.x} ${SANDBOX.y} L${SANDBOX.x} ${SANDBOX.y + SANDBOX.h} L${SANDBOX.x + SANDBOX.w} ${SANDBOX.y + SANDBOX.h} L${SANDBOX.x + SANDBOX.w} ${SANDBOX.y} L${W2[0] + 60} ${SANDBOX.y}`} fill="none" stroke="var(--id-lime)" stroke-width="8" />
              <path d={stepsPath} fill="var(--id-paper)" fill-opacity="0.12" stroke="var(--id-paper-2)" stroke-width="3" />
              <text x={SANDBOX.x + 24} y={SANDBOX.y + 62} class="lab">SANDBOX</text>
            </g>
            {passT.map((t, i) => <rect x={STEP_X0 + STEP_W * i + 47} y={stepTop(i) + 18} width="26" height="26" fill="var(--id-lime)" data-in={r(t, t + 0.06)} />)}

            <!-- SHORTCUT: stamp rings are drawn twice (on the card and mirrored on the paper top sheet); production picks one. -->
            <!-- tiny hidden paths used only by pulses -->
            <path id="p-paper-B" d={`M${PAPER.x + PAPER.w + 20} ${PAPER.y + 150} L${B[0] - NODE_R - 14} ${B[1]}`} fill="none" stroke="none" />

            <!-- pulses: the lime dot that rides an edge. Same circle, same timing offsets, every dispatch. -->
            {pulses.map((p) => <circle r="20" fill="var(--id-lime)" data-pulse={p.t} data-along={p.along} />)}

            <!-- ===== blackout veil: everything above dims; paper + task are drawn after ===== -->
            <rect id="veil" x="-3000" y="-2600" width="9800" height="7600" fill="var(--id-ground)" opacity="0" />

            <!-- ===== paper stack ===== -->
            <g id="paper" data-in="3.2,3.5">
              <rect x={PAPER.x + 40} y={PAPER.y + 40} width={PAPER.w} height={PAPER.h} fill="var(--id-paper-2)" />
              <rect x={PAPER.x + 26} y={PAPER.y + 26} width={PAPER.w} height={PAPER.h} fill="var(--id-paper-2)" stroke="var(--id-ground)" stroke-width="3" />
              <rect x={PAPER.x + 13} y={PAPER.y + 13} width={PAPER.w} height={PAPER.h} fill="var(--id-paper-2)" stroke="var(--id-ground)" stroke-width="3" />
              <rect x={PAPER.x} y={PAPER.y} width={PAPER.w} height={PAPER.h} fill="var(--id-paper)" stroke="var(--id-ground)" stroke-width="3" />
              <g fill="var(--id-ink)" opacity="0.4">
                <rect x={PAPER.x + 28} y={PAPER.y + 30} width="210" height="12" />
                <rect x={PAPER.x + 28} y={PAPER.y + 60} width="280" height="12" />
                <rect x={PAPER.x + 28} y={PAPER.y + 90} width="170" height="12" />
              </g>
              {STAMP_T.map((t, i) => <circle cx={PAPER.x + 62 + i * 66} cy={PAPER.y + PAPER.h - 44} r="24" fill="none" stroke="var(--id-ink)" stroke-width="7" opacity="0.65" data-in={r(t, t + 0.08)} />)}
              <text x={PAPER.x} y={PAPER.y + PAPER.h + 90} class="lab" style="fill: var(--id-paper)">PAPER</text>
            </g>

            <!-- ===== THE TASK: one pink shape that never leaves (cursor -> dot -> card) ===== -->
            <g id="task">
              <circle id="glow2" r="100" fill="none" stroke="var(--id-pink)" stroke-width="4" opacity="0" />
              <circle id="glow1" r="100" fill="none" stroke="var(--id-pink)" stroke-width="10" opacity="0" />
              <rect id="task-rect" x="-20" y="-38" width="40" height="76" fill="var(--id-pink)" />
              <path id="task-chk" d="M0 0" fill="none" stroke="var(--id-ink)" stroke-linecap="square" stroke-linejoin="miter" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" opacity="0" />
              <g id="stamps">
                {STAMP_T.map((t, i) => <circle cx={-93 + i * 62} cy="52" r="23" fill="none" stroke="var(--id-ink)" stroke-width="8" data-in={r(t, t + 0.08)} data-pop />)}
              </g>
            </g>
          </g>
        </svg>

        <div class="copy-layer">
          <div class="col" id="col" aria-hidden="true"></div>
          <header class="copy copy-intro" data-txt="intro">
            <h1>{intro.title}</h1>
            <p class="lede">{intro.lede}</p>
          </header>
          {beats.map((b, i) => (
            <article class="copy" data-txt={String(i)} aria-labelledby={`beat-${b.key}`}>
              <p class="kicker">{b.kicker}</p>
              <h2 id={`beat-${b.key}`}>{b.title}</h2>
              {b.body.map((t) => <p class="body">{t}</p>)}
              {b.credit && <p class="credit">{b.credit.text} <a href={b.credit.href}>{b.credit.name}</a></p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="credits" aria-labelledby="credits-h">
      <h2 id="credits-h">{creditsHeading}</h2>
      <ul>
        {credits.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
      </ul>
    </section>

    <SiteFooter />
    <PrototypeSwitcher current="3b" />
  </div>
</BaseLayout>

<style is:global>
  html, body { margin: 0; background: var(--id-ground); }
</style>
<style>
  .p3b {
    position: relative;
    background: var(--id-ground);
    color: var(--id-paper);
    font-family: var(--id-font-body);
    min-height: 100vh;
  }
  .navwrap { position: absolute; top: 0; left: 0; right: 0; z-index: 5; padding: var(--space-4) clamp(1rem, 4vw, 4rem); pointer-events: none; }
  .navwrap :global(a) { pointer-events: auto; }

  .track { position: relative; height: calc(100svh * 13); }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .svg .lab { font-family: var(--id-font-display); font-weight: 800; font-size: 54px; letter-spacing: 0.02em; fill: var(--id-paper-2); }
  .svg .nrole { font-family: var(--id-font-display); font-weight: 800; font-size: 40px; letter-spacing: 0.08em; }
  .svg .nmeth { font-family: var(--id-font-display); font-weight: 800; font-size: 52px; letter-spacing: 0.02em; }
  /* scripted elements start hidden; camera.ts drives them from the scroll position */
  .svg :global([data-in]), .svg :global([data-draw]), .svg :global([data-pulse]) { opacity: 0; }
  .svg :global([data-draw]) { stroke-dasharray: 1 1; stroke-dashoffset: 1; }
  .svg :global([data-pop]), .svg :global([data-fog]) { transform-box: fill-box; transform-origin: center; }
  .svg :global(.hb) { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .svg.live :global(.hb) { animation: hb 2.6s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  @keyframes hb {
    0% { opacity: 0.9; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(2.6); }
  }

  .copy-layer { position: absolute; inset: 0; pointer-events: none; }
  .col { position: absolute; left: 0; top: 0; bottom: 0; width: 42vw; background: var(--id-ground); border-right: 1px solid var(--id-rule); opacity: 0; }
  .copy {
    position: absolute;
    left: clamp(1.25rem, 4vw, 4rem);
    top: 47%;
    width: min(36vw, 36rem);
    translate: 0 -50%;
    pointer-events: auto;
    will-change: opacity, transform;
  }
  .kicker { margin: 0 0 var(--space-4); color: var(--id-lime); font-weight: var(--id-weight-strong); font-size: var(--id-text-body); letter-spacing: var(--id-tracking-heading); }
  .copy h2 {
    margin: 0 0 var(--space-6);
    font-size: clamp(2.2rem, 4.2vw, 4.4rem);
    font-weight: var(--id-weight-poster);
    letter-spacing: var(--id-tracking-display);
    line-height: var(--id-leading-display);
    color: var(--id-paper);
  }
  .copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(4rem, 8.5vw, 9rem);
    font-weight: var(--id-weight-poster);
    letter-spacing: var(--id-tracking-poster);
    line-height: var(--id-leading-poster);
    color: var(--id-lime);
  }
  .lede { margin: 0; max-width: 28ch; font-size: clamp(1.15rem, 1.7vw, 1.6rem); font-weight: var(--id-weight-medium); line-height: 1.3; }
  .body { margin: 0 0 var(--space-3); max-width: 38ch; font-size: var(--id-text-body); line-height: 1.45; color: var(--id-paper); }
  .credit { margin: var(--space-4) 0 0; font-size: var(--id-text-small); color: var(--id-paper-2); }
  a { color: var(--id-lime); text-underline-offset: 0.18em; }
  a:hover { background: var(--id-pink); color: var(--id-ink); }
  a:focus-visible { outline: 3px solid var(--id-paper); outline-offset: 3px; }

  .credits { padding: var(--space-12) clamp(1.25rem, 4vw, 4rem); border-top: 1px solid var(--id-rule); }
  .credits h2 { margin: 0 0 var(--space-4); font-size: var(--id-text-heading); font-weight: var(--id-weight-strong); color: var(--id-paper-2); }
