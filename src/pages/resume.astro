---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeCard from '../components/resume/ResumeCard.astro';
import { achievements, education, resumeIntro, workExperience } from '../data/resume';

// ─── Slug helpers ────────────────────────────────────────────────────────────

function slugify(str: string): string {
  return str
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function itemSlug(item: { company: string; title: string; slug?: string }): string {
  return item.slug ?? slugify(item.company || item.title);
}

// ─── File tree taxonomy ───────────────────────────────────────────────────────

interface TreeFile {
  name: string;
  path: string;
}

interface TreeFolder {
  name: string;
  files: TreeFile[];
  subfolders?: TreeFolder[];
}

// Build experience folder from workExperience data
const experienceFiles: TreeFile[] = workExperience.map((item) => {
  const slug = itemSlug(item);
  return { name: `${slug}.md`, path: `experience/${slug}.md` };
});

// Build achievements folder
const achievementFiles: TreeFile[] = achievements.map((item) => {
  const slug = itemSlug(item);
  return { name: `${slug}.md`, path: `achievements/${slug}.md` };
});

// Build education folder
const educationFiles: TreeFile[] = education.map((item) => {
  const slug = itemSlug(item);
  return { name: `${slug}.md`, path: `education/${slug}.md` };
});

// Skills subfolders (existing content, re-parented under skills/)
const skillsSubfolders: TreeFolder[] = [
  {
    name: 'agentic-engineering',
    files: [
      { name: 'harness-factory.md',          path: 'skills/agentic-engineering/harness-factory.md' },
      { name: 'disposable-orchestrators.md', path: 'skills/agentic-engineering/disposable-orchestrators.md' },
      { name: 'sandboxed-autonomy.md',       path: 'skills/agentic-engineering/sandboxed-autonomy.md' },
      { name: 'llm-app-engineering.md',      path: 'skills/agentic-engineering/llm-app-engineering.md' },
    ],
  },
  {
    name: 'web-development',
    files: [
      { name: 'full-stack-web.md',           path: 'skills/web-development/full-stack-web.md' },
      { name: 'apis-and-deployment.md',      path: 'skills/web-development/apis-and-deployment.md' },
      { name: 'analytics-instrumentation.md',path: 'skills/web-development/analytics-instrumentation.md' },
    ],
  },
  {
    name: 'data-science',
    files: [
      { name: 'bayesian-modeling.md',  path: 'skills/data-science/bayesian-modeling.md' },
      { name: 'computer-vision.md',    path: 'skills/data-science/computer-vision.md' },
      { name: 'data-pipelines.md',     path: 'skills/data-science/data-pipelines.md' },
    ],
  },
  {
    name: 'growth-engineering',
    files: [
      { name: 'performance-marketing.md', path: 'skills/growth-engineering/performance-marketing.md' },
      { name: 'server-side-tracking.md',  path: 'skills/growth-engineering/server-side-tracking.md' },
      { name: 'bayesian-mmm.md',          path: 'skills/growth-engineering/bayesian-mmm.md' },
    ],
  },
  {
    name: 'founder-operator',
    files: [
      { name: 'strategy.md',             path: 'skills/founder-operator/strategy.md' },
      { name: 'teams-and-ops.md',        path: 'skills/founder-operator/teams-and-ops.md' },
      { name: 'learning-from-failures.md',path: 'skills/founder-operator/learning-from-failures.md' },
    ],
  },
];

const folders: TreeFolder[] = [
  { name: 'skills',        files: [], subfolders: skillsSubfolders },
  { name: 'achievements',  files: achievementFiles },
  { name: 'experience',    files: experienceFiles },
  { name: 'education',     files: educationFiles },
];

// ─── File content builders ────────────────────────────────────────────────────

function buildItemHtml(item: {
  title: string;
  role: string;
  badgeColor: string;
  company: string;
  location: string;
  dateRange: string;
  imageUrl: string;
  imageAlt: string;
  body: string;
  links?: { label: string; href: string }[];
}): string {
  const badgeColors: Record<string, string> = {
    primary: 'ghv-badge--primary',
    accent: 'ghv-badge--accent',
    secondary: 'ghv-badge--secondary',
    info: 'ghv-badge--info',
  };
  const badgeClass = badgeColors[item.badgeColor] ?? 'ghv-badge--primary';

  const linksHtml = item.links && item.links.length > 0
    ? `<div class="ghv-item-links">${item.links.map((l) => `<a href="${l.href}" class="ghv-link" target="_blank" rel="noreferrer">${l.label}</a>`).join('')}</div>`
    : '';

  // Only render meta parts that are present (a current-job item may omit location/date).
  const metaTextHtml = [item.company, item.location, item.dateRange]
    .filter(Boolean)
    .map((part) => `<span>${part}</span>`)
    .join('<span>·</span>');

  return `
<article class="resume-item-card ghv-item-card">
  <div class="ghv-item-logo">
    <img src="${item.imageUrl}" alt="${item.imageAlt}" class="ghv-item-logo__img" />
  </div>
  <div class="ghv-item-body ghv-md">
    <h1>${item.title}</h1>
    <p class="ghv-item-meta">
      <span class="ghv-badge ${badgeClass}">${item.role}</span>
      ${metaTextHtml}
    </p>
    <p>${item.body}</p>
    ${linksHtml}
  </div>
</article>`;
}

// Build README content
const readmeHtml = `
<div class="ghv-md ghv-readme">
  <div class="ghv-readme-profile">
    <div class="ghv-readme-avatar">
      <img src="/img/jonatan_avatar_smiling_no_bg.png" alt="Jonatan Snyders profile photo" class="ghv-readme-avatar__img" />
    </div>
    <div class="ghv-readme-intro">
      <h1>Jonatan Snyders</h1>
      <div class="ghv-readme-badges">
        ${resumeIntro.headlineBadges.map((badge, i) => {
          const cls = ['ghv-badge--primary', 'ghv-badge--accent', 'ghv-badge--secondary', 'ghv-badge--info'][i] ?? 'ghv-badge--primary';
          return `<span class="ghv-badge ${cls}">${badge}</span>`;
        }).join('')}
      </div>
      ${resumeIntro.paragraphs.map((p) => `<p>${p}</p>`).join('')}
    </div>
  </div>
</div>`;

// Build all file contents map
const fileContents: Record<string, string> = {
  'README.md': readmeHtml,
};

// Experience files
workExperience.forEach((item) => {
  const slug = itemSlug(item);
  fileContents[`experience/${slug}.md`] = buildItemHtml(item);
});

// Achievement files
achievements.forEach((item) => {
  const slug = itemSlug(item);
  fileContents[`achievements/${slug}.md`] = buildItemHtml(item);
});

// Education files
education.forEach((item) => {
  const slug = itemSlug(item);
  fileContents[`education/${slug}.md`] = buildItemHtml(item);
});

// Skills files (re-parented under skills/)
const skillsContents: Record<string, string> = {
  'skills/agentic-engineering/harness-factory.md': `
<div class="ghv-md">
<h1>harness-factory.md</h1>
<p>I build and own my agent harness: the prompts, tools, context routing, and review loops that turn an LLM into a system that does real work, unattended.</p>
<h2>Technologies</h2>
<ul>
  <li>pi, a harness I can change all the way down</li>
  <li>Custom skills, roles, and tools</li>
  <li>Subagents and fresh-context review loops</li>
  <li>Prompt templates and context routing</li>
</ul>
<h2>Proof</h2>
<p>The whole system runs: <a href="/factory/" class="ghv-link">/factory</a>.</p>
</div>`,
  'skills/agentic-engineering/disposable-orchestrators.md': `
<div class="ghv-md">
<h1>disposable-orchestrators.md</h1>
<p>I architect agent work so state lives in the substrate, not the agent. Each orchestrator reads a graph of goals, makes one move, writes its decision back, and dies, so any agent can crash and the work picks up where it left off.</p>
<h2>Technologies</h2>
<ul>
  <li>Work as a dependency graph, not a chat log</li>
  <li>Tiered memory kept by lifecycle</li>
  <li>Disposable orchestrators over shared substrate</li>
  <li>Crash-resumable, parallel-safe workflows</li>
</ul>
<h2>Proof</h2>
<p>The work loop behind <a href="/factory/" class="ghv-link">/factory</a>, including a planner that proposes the next move.</p>
</div>`,
  'skills/agentic-engineering/sandboxed-autonomy.md': `
<div class="ghv-md">
<h1>sandboxed-autonomy.md</h1>
<p>I run agents unattended by putting hard limits around them: containerized execution, every shell command checked before it runs, and credentials the agent never holds directly.</p>
<h2>Technologies</h2>
<ul>
  <li>rip-cage, a container plus command-gating I built</li>
  <li>Credential isolation through a proxy</li>
  <li>Always-on host, not a laptop</li>
  <li>Safe-to-run-unattended execution</li>
</ul>
<h2>Proof</h2>
<p>Open source: <a href="https://github.com/jsnyde0/rip-cage" class="ghv-link">rip-cage</a>.</p>
</div>`,
  'skills/agentic-engineering/llm-app-engineering.md': `
<div class="ghv-md">
<h1>llm-app-engineering.md</h1>
<p>Beyond tooling my own workflow, I build agentic apps: LLM calls wrapped in tools, structured output, and guardrails meant to hold up in production.</p>
<h2>Technologies</h2>
<ul>
  <li>LLM-powered features and agents</li>
  <li>Tool use and structured output</li>
  <li>Retrieval and context design</li>
  <li>Evaluation and guardrails</li>
</ul>
</div>`,
  'skills/web-development/full-stack-web.md': `
<div class="ghv-md">
<h1>full-stack-web.md</h1>
<p>I build full-stack web apps across backend, frontend, and the data layer behind them. I default to hypermedia-driven apps: server-rendered HTML with focused interactivity and little client-side state. I build with React too, but reach for it when an app genuinely needs a rich client.</p>
<h2>Technologies</h2>
<ul>
  <li>Django, PostgreSQL, MongoDB</li>
  <li>HTMX, Tailwind, Astro</li>
  <li>React, JavaScript</li>
</ul>
<h2>Approach</h2>
<p>Why hypermedia-driven: <a href="https://htmx.org/essays/hypermedia-driven-applications/" class="ghv-link">htmx.org/essays/hypermedia-driven-applications</a>.</p>
</div>`,
  'skills/web-development/apis-and-deployment.md': `
<div class="ghv-md">
<h1>apis-and-deployment.md</h1>
<p>I build APIs, containerize apps, and deploy them with practical CI/CD.</p>
<h2>Technologies</h2>
<ul>
  <li>Django REST Framework</li>
  <li>Pydantic</li>
  <li>Docker</li>
  <li>DigitalOcean</li>
  <li>GitHub Actions</li>
</ul>
</div>`,
  'skills/web-development/analytics-instrumentation.md': `
<div class="ghv-md">
<h1>analytics-instrumentation.md</h1>
<p>I instrument product and marketing data so teams can trust what they measure.</p>
<h2>Technologies</h2>
<ul>
  <li>PostHog</li>
  <li>GA4</li>
  <li>BigQuery</li>
  <li>Dataform</li>
  <li>Looker Studio</li>
</ul>
</div>`,
  'skills/data-science/bayesian-modeling.md': `
<div class="ghv-md">
<h1>bayesian-modeling.md</h1>
<p>I use Bayesian modelling when signals are noisy and decisions still need to be made.</p>
<h2>Technologies</h2>
<ul>
  <li>Python</li>
  <li>PyMC</li>
  <li>pandas</li>
  <li>NumPy</li>
  <li>Marketing Mix Models</li>
</ul>
<h2>Proof</h2>
<p>Built a Bayesian MMM at Moonbird.</p>
</div>`,
  'skills/data-science/computer-vision.md': `
<div class="ghv-md">
<h1>computer-vision.md</h1>
<p>I worked on medical image processing, 3D meshes, and computer vision systems.</p>
<h2>Technologies</h2>
<ul>
  <li>C++</li>
  <li>Computer vision</li>
  <li>Medical image processing</li>
  <li>3D mesh processing</li>
  <li>Deep learning consulting</li>
</ul>
<h2>Proof</h2>
<p>Created <a href="https://github.com/TheWebMonks/meshmonk" class="ghv-link">MeshMonk</a>; used or cited in 140+ research projects.</p>
</div>`,
  'skills/data-science/data-pipelines.md': `
<div class="ghv-md">
<h1>data-pipelines.md</h1>
<p>I build ELT pipelines that turn source data into models, dashboards, and decisions.</p>
<h2>Technologies</h2>
<ul>
  <li>Python</li>
  <li>SQL</li>
  <li>BigQuery</li>
  <li>Dataform</li>
  <li>API and database extraction</li>
</ul>
<h2>Proof</h2>
<p>Built the Moonbird pipeline behind growth reporting and modelling.</p>
</div>`,
  'skills/growth-engineering/performance-marketing.md': `
<div class="ghv-md">
<h1>performance-marketing.md</h1>
<p>I combine acquisition, experiments, automation, and measurement into one growth loop.</p>
<h2>Technologies</h2>
<ul>
  <li>Paid search</li>
  <li>Paid social</li>
  <li>Email marketing</li>
  <li>SEO and CRO</li>
  <li>Marketing automation</li>
</ul>
<h2>Proof</h2>
<p>At Moonbird, grew monthly revenue from four to six figures in 3.5 years.</p>
</div>`,
  'skills/growth-engineering/server-side-tracking.md': `
<div class="ghv-md">
<h1>server-side-tracking.md</h1>
<p>I preserve attribution signal by sending conversion events from the backend.</p>
<h2>Technologies</h2>
<ul>
  <li>Server-side tracking</li>
  <li>Conversion APIs</li>
  <li>Backend event forwarding</li>
  <li>Ad-platform measurement</li>
</ul>
<h2>Proof</h2>
<p>Built and maintained server-side tracking for Moonbird's ad stack.</p>
</div>`,
  'skills/growth-engineering/bayesian-mmm.md': `
<div class="ghv-md">
<h1>bayesian-mmm.md</h1>
<p>I model channel contribution when last-click attribution is too noisy to trust.</p>
<h2>Technologies</h2>
<ul>
  <li>Python</li>
  <li>PyMC</li>
  <li>Bayesian modelling</li>
  <li>Marketing Mix Modelling</li>
  <li>Diminishing-return and lag effects</li>
</ul>
<h2>Proof</h2>
<p>Used at Moonbird to guide marketing budget allocation.</p>
</div>`,
  'skills/founder-operator/strategy.md': `
<div class="ghv-md">
<h1>strategy.md</h1>
<p>I founded and ran an impact-first organization focused on digital jobs and training.</p>
<h2>Methods</h2>
<ul>
  <li>Vision and strategy</li>
  <li>Market selection</li>
  <li>Partnership design</li>
  <li>Funding approach</li>
</ul>
<h2>Proof</h2>
<p>Humainly supported 30 people through NGO partnerships in Venezuela and Nigeria.</p>
</div>`,
  'skills/founder-operator/teams-and-ops.md': `
<div class="ghv-md">
<h1>teams-and-ops.md</h1>
<p>I ran small international teams with explicit roles and distributed authority.</p>
<h2>Methods</h2>
<ul>
  <li>Holacracy</li>
  <li>Hiring and onboarding</li>
  <li>Role design</li>
  <li>Remote operations</li>
</ul>
<h2>Proof</h2>
<p>Humainly operated across Belgium, Venezuela, and Nigeria.</p>
</div>`,
  'skills/founder-operator/learning-from-failures.md': `
<div class="ghv-md">
<h1>learning-from-failures.md</h1>
<p>Humainly did not scale before founder burnout; that changed how I think about pace and sustainability.</p>
<h2>Methods</h2>
<ul>
  <li>Retrospective practice</li>
  <li>Scope control</li>
  <li>Founder sustainability</li>
  <li>Impact-model evaluation</li>
</ul>
<h2>Proof</h2>
<p>The mission worked; the growth rate and operating model did not.</p>
</div>`,
};

Object.assign(fileContents, skillsContents);

const DEFAULT_PATH = 'README.md';

// Count total files for subheader
const countFiles = (foldersArr: TreeFolder[]): number => {
  let count = 1; // README.md
  for (const f of foldersArr) {
    count += f.files.length;
    if (f.subfolders) count += countFiles(f.subfolders) - 1; // -1 to not double-count the offset
  }
  return count;
};

// Simple flat count
const totalFiles = 1 + // README.md
  workExperience.length +
  achievements.length +
  education.length +
  Object.keys(skillsContents).length;

const totalFolders = 4 + skillsSubfolders.length; // experience, achievements, education, skills + skill subfolders
---

<BaseLayout title="Resume | Jonatan Snyders" description="Resume of Jonatan Snyders — web developer, data scientist, ex-founder, and growth engineer.">
  <div class="resume-page">
    <h1 class="resume-page__title">Resume</h1>

    <ResumeCard>
      <div class="ghv-shell" role="main" aria-label="Resume repository browser">

        <!-- Repo header / breadcrumb -->
        <div class="ghv-header">
          <div class="ghv-crumb">
            <span class="ghv-crumb-owner">jsnyde0</span>
            <span class="ghv-crumb-sep">/</span>
            <span class="ghv-crumb-repo">resume</span>
          </div>
          <div class="ghv-header-pills">
            <span class="ghv-pill">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
              Star
            </span>
            <span class="ghv-pill">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
              Fork
            </span>
          </div>
        </div>

        <!-- Branch + stats bar -->
        <div class="ghv-subheader">
          <span class="ghv-branch-badge">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z"/></svg>
            main
          </span>
          <span class="ghv-subheader-sep">·</span>
          <span>{totalFiles} files</span>
          <span class="ghv-subheader-sep">·</span>
          <span>{totalFolders} folders</span>

          <!-- Download PDF button — fake-download interaction -->
          <button
            class="ghv-dl-btn"
            id="ghv-dl-btn"
            type="button"
            aria-label="Download PDF"
            style="margin-left:auto; position:relative; overflow:hidden;"
          >
            <div class="ghv-dl-spinner" id="ghv-dl-spinner" aria-hidden="true"></div>
            <svg viewBox="0 0 16 16" aria-hidden="true" id="ghv-dl-icon"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Zm-1-5.573 3.25 3.25a.75.75 0 0 0 1.06 0L9.31 8.427A.75.75 0 0 0 8.25 7.366H6.75V2.75a.75.75 0 0 0-1.5 0v4.616H3.75a.75.75 0 0 0-.53 1.28l-.47.581Z"/></svg>
            <span id="ghv-dl-label">Download PDF</span>
            <div class="ghv-dl-progress" id="ghv-dl-progress" aria-hidden="true"></div>
          </button>
        </div>

        <!-- Mobile: tree toggle -->
        <button
          class="ghv-mobile-toggle"
          aria-controls="ghv-tree-panel"
          aria-expanded="false"
          id="ghv-mobile-toggle-btn"
          type="button"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.75 2.5a.75.75 0 0 0 0 1.5h12.5a.75.75 0 0 0 0-1.5H1.75Zm0 4a.75.75 0 0 0 0 1.5h12.5a.75.75 0 0 0 0-1.5H1.75Zm0 4a.75.75 0 0 0 0 1.5h12.5a.75.75 0 0 0 0-1.5H1.75Z"/></svg>
          Files
          <span class="ghv-mobile-toggle-caret" id="ghv-mobile-caret" aria-hidden="true">▼</span>
        </button>

        <!-- Two-pane body -->
        <div class="ghv-body">

          <!-- File tree sidebar -->
          <nav class="ghv-tree" id="ghv-tree-panel" aria-label="Repository file tree">
            <div class="ghv-tree-header">
              <span>Files</span>
            </div>

            <div class="ghv-tree-root">
              <!-- README.md — default selected -->
              <div
                class="ghv-file ghv-file--selected"
                role="button"
                tabindex="0"
                data-ghv-path="README.md"
                aria-label="README.md"
                aria-current="true"
              >
                <span class="ghv-file-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"/></svg>
                </span>
                <span>README.md</span>
              </div>

              <!-- Top-level folders: experience, achievements, education, skills -->
              {folders.map((folder, folderIdx) => (
                <div class="ghv-folder" data-ghv-folder={folder.name}>
                  <div
                    class="ghv-folder-row"
                    role="button"
                    tabindex="0"
                    aria-expanded="false"
                    aria-controls={`ghv-folder-files-${folderIdx}`}
                    data-ghv-folder-toggle={folder.name}
                  >
                    <span class="ghv-folder-caret" aria-hidden="true">▶</span>
                    <span class="ghv-folder-icon" aria-hidden="true">
                      <svg viewBox="0 0 16 16"><path d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75Z"/></svg>
                    </span>
                    <span>{folder.name}/</span>
                  </div>
                  <div class="ghv-folder-files" id={`ghv-folder-files-${folderIdx}`} style="display:none">
                    {/* Direct files in this folder */}
                    {folder.files.map((file) => (
                      <div
                        class="ghv-file"
                        role="button"
                        tabindex="0"
                        data-ghv-path={file.path}
                        aria-label={file.name}
                        aria-current="false"
                      >
                        <span class="ghv-file-icon" aria-hidden="true">
                          <svg viewBox="0 0 16 16"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"/></svg>
                        </span>
                        <span>{file.name}</span>
                      </div>
                    ))}
                    {/* Skill subfolders */}
                    {folder.subfolders && folder.subfolders.map((sub, subIdx) => (
                      <div class="ghv-folder" data-ghv-folder={`${folder.name}/${sub.name}`}>
                        <div
                          class="ghv-folder-row ghv-folder-row--sub"
                          role="button"
                          tabindex="0"
                          aria-expanded="false"
                          aria-controls={`ghv-subfolder-files-${folderIdx}-${subIdx}`}
                          data-ghv-subfolder-toggle={`${folder.name}/${sub.name}`}
                          data-ghv-subfolder-panel={`ghv-subfolder-files-${folderIdx}-${subIdx}`}
                        >
                          <span class="ghv-folder-caret" aria-hidden="true">▶</span>
                          <span class="ghv-folder-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16"><path d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75Z"/></svg>
                          </span>
                          <span>{sub.name}/</span>
                        </div>
                        <div class="ghv-folder-files" id={`ghv-subfolder-files-${folderIdx}-${subIdx}`} style="display:none">
                          {sub.files.map((file) => (
                            <div
                              class="ghv-file"
                              role="button"
                              tabindex="0"
                              data-ghv-path={file.path}
                              aria-label={file.name}
                              aria-current="false"
                            >
                              <span class="ghv-file-icon" aria-hidden="true">
                                <svg viewBox="0 0 16 16"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"/></svg>
                              </span>
                              <span>{file.name}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </nav>

          <!-- Preview pane -->
          <div class="ghv-preview" id="ghv-preview-pane" role="region" aria-label="File preview">

            <!-- Preview header bar -->
            <div class="ghv-preview-header">
              <div class="ghv-preview-path" id="ghv-preview-path" aria-live="polite">
                <span>README.md</span>
              </div>
              <div class="ghv-preview-actions">
                <span class="ghv-preview-btn">Raw</span>
                <span class="ghv-preview-btn">Blame</span>
              </div>
            </div>

            <!-- Rendered content — all panels rendered server-side, JS toggles visibility -->
            <div class="ghv-preview-content">
              {Object.entries(fileContents).map(([path, html]) => (
                <div
                  class="ghv-file-panel"
                  data-ghv-panel={path}
                  style={path === DEFAULT_PATH ? '' : 'display:none'}
                  aria-hidden={path === DEFAULT_PATH ? 'false' : 'true'}
                  set:html={html}
                />
              ))}
            </div>

          </div>
        </div>
      </div>
    </ResumeCard>
  </div>

  <script>
    // Inline vanilla JS — no framework islands, no URL/hash changes.

    const DEFAULT_PATH = 'README.md';

    const previewPath = document.getElementById('ghv-preview-path');
    const mobileToggleBtn = document.getElementById('ghv-mobile-toggle-btn');
    const mobileCaret = document.getElementById('ghv-mobile-caret');
    const treePanel = document.getElementById('ghv-tree-panel');

    function setPreview(path: string) {
      // Hide all panels
      document.querySelectorAll<HTMLElement>('[data-ghv-panel]').forEach((panel) => {
        const isActive = panel.getAttribute('data-ghv-panel') === path;
        panel.style.display = isActive ? '' : 'none';
        panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      // Update breadcrumb
      if (previewPath) {
        const parts = path.split('/');
        if (parts.length === 1) {
          previewPath.innerHTML = '<span>' + path + '</span>';
        } else {
          previewPath.innerHTML = parts.slice(0, -1).join('/') + ' / <span>' + parts[parts.length - 1] + '</span>';
        }
      }
    }

    function setSelected(path: string) {
      document.querySelectorAll<HTMLElement>('[data-ghv-path]').forEach((el) => {
        const isSelected = el.getAttribute('data-ghv-path') === path;
        el.classList.toggle('ghv-file--selected', isSelected);
        el.setAttribute('aria-current', isSelected ? 'true' : 'false');
      });
    }

    function handleFileClick(el: HTMLElement) {
      const path = el.getAttribute('data-ghv-path');
      if (!path) return;
      setSelected(path);
      setPreview(path);
      // On mobile, collapse tree after selection
      if (window.innerWidth <= 640 && treePanel && mobileToggleBtn && mobileCaret) {
        treePanel.classList.remove('is-mobile-open');
        mobileToggleBtn.setAttribute('aria-expanded', 'false');
        mobileCaret.classList.remove('is-open');
      }
    }

    // Wire up file click / keyboard
    document.querySelectorAll<HTMLElement>('[data-ghv-path]').forEach((el) => {
      el.addEventListener('click', () => handleFileClick(el));
      el.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleFileClick(el);
        }
      });
    });

    // Top-level folder toggle
    document.querySelectorAll<HTMLElement>('[data-ghv-folder-toggle]').forEach((toggleEl) => {
      toggleEl.addEventListener('click', () => {
        const folderName = toggleEl.getAttribute('data-ghv-folder-toggle');
        const panelId = toggleEl.getAttribute('aria-controls');
        if (!panelId) return;
        const filesPanel = document.getElementById(panelId);
        const caret = toggleEl.querySelector('.ghv-folder-caret');
        if (!filesPanel) return;
        const isOpen = filesPanel.style.display !== 'none';
        filesPanel.style.display = isOpen ? 'none' : '';
        toggleEl.setAttribute('aria-expanded', String(!isOpen));
        caret?.classList.toggle('is-open', !isOpen);
      });
      toggleEl.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleEl.click();
        }
      });
    });

    // Sub-folder toggle
    document.querySelectorAll<HTMLElement>('[data-ghv-subfolder-toggle]').forEach((toggleEl) => {
      toggleEl.addEventListener('click', (e: Event) => {
        e.stopPropagation(); // don't trigger parent folder toggle
        const panelId = toggleEl.getAttribute('data-ghv-subfolder-panel');
        if (!panelId) return;
        const filesPanel = document.getElementById(panelId);
        const caret = toggleEl.querySelector('.ghv-folder-caret');
        if (!filesPanel) return;
        const isOpen = filesPanel.style.display !== 'none';
        filesPanel.style.display = isOpen ? 'none' : '';
        toggleEl.setAttribute('aria-expanded', String(!isOpen));
        caret?.classList.toggle('is-open', !isOpen);
      });
      toggleEl.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleEl.click();
        }
      });
    });

    // Mobile tree toggle
    mobileToggleBtn?.addEventListener('click', () => {
      const isOpen = treePanel?.classList.contains('is-mobile-open');
      treePanel?.classList.toggle('is-mobile-open', !isOpen);
      mobileToggleBtn.setAttribute('aria-expanded', String(!isOpen));
      mobileCaret?.classList.toggle('is-open', !isOpen);
    });

    // Set initial state
    setSelected(DEFAULT_PATH);
    setPreview(DEFAULT_PATH);

    // ── Download PDF — fake-download interaction ────────────────────────────
    const dlBtn      = document.getElementById('ghv-dl-btn') as HTMLButtonElement;
    const dlLabel    = document.getElementById('ghv-dl-label') as HTMLElement;
    const dlIcon     = document.getElementById('ghv-dl-icon') as SVGElement;
    const dlProgress = document.getElementById('ghv-dl-progress') as HTMLElement;
    const dlSpinner  = document.getElementById('ghv-dl-spinner') as HTMLElement;
    let dlRunning = false;
    let dlTimer: ReturnType<typeof setTimeout> | null = null;

    function dlReset() {
      dlRunning = false;
      if (dlTimer) { clearTimeout(dlTimer); dlTimer = null; }
      dlSpinner.style.display = 'none';
      dlIcon.style.display = '';
      dlLabel.textContent = 'Download PDF';
      dlLabel.style.whiteSpace = '';
      dlProgress.style.transition = 'none';
      dlProgress.style.width = '0%';
      dlProgress.style.opacity = '1';
      dlBtn.style.background = '';
      dlBtn.style.borderColor = '';
      dlBtn.style.whiteSpace = '';
      dlBtn.setAttribute('aria-label', 'Download PDF');
    }

    dlBtn?.addEventListener('click', () => {
      if (dlRunning) { dlReset(); return; }

      dlRunning = true;

      // Phase 1: loading state
      dlIcon.style.display = 'none';
      dlSpinner.style.display = 'block';
      dlLabel.textContent = 'oh, shit, erm...';
      dlBtn.setAttribute('aria-label', 'oh, shit, erm...');

      // Progress bar: 0 → 85%
      dlProgress.style.transition = 'none';
      dlProgress.style.width = '0%';
      dlProgress.style.opacity = '1';
      dlBtn.offsetWidth; // force reflow
      dlProgress.style.transition = 'width 900ms cubic-bezier(0.25, 1, 0.5, 1)';
      dlProgress.style.width = '85%';

      dlTimer = setTimeout(() => {
        if (!dlRunning) return;

        // Phase 2: reveal
        dlSpinner.style.display = 'none';
        dlIcon.style.display = '';
        dlLabel.textContent = 'if you need this as a PDF, are we really a match?';
        dlLabel.style.whiteSpace = 'normal';
        dlBtn.setAttribute('aria-label', 'if you need this as a PDF, are we really a match?');
        dlBtn.style.background = '#21262d';
        dlBtn.style.borderColor = '#30363d';
        dlBtn.style.whiteSpace = 'normal';

        // Complete bar then fade it
        dlProgress.style.transition = 'width 200ms ease-out';
        dlProgress.style.width = '100%';
        setTimeout(() => {
          dlProgress.style.transition = 'opacity 300ms ease-out';
          dlProgress.style.opacity = '0';
        }, 220);
      }, 1100);
    });
  </script>

  <style>
    .resume-page {
      width: min(100%, 56rem);
      margin: 0 auto;
    }

    .resume-page__title {
      margin: 0 0 2rem;
      font-size: clamp(2rem, 4vw, 2.5rem);
      line-height: 1.1;
    }

    /* === GITHUB-DARK SHELL === */
    .ghv-shell {
      background: #0d1117;
      color: #c9d1d9;
      border: 1px solid #30363d;
      border-radius: 6px;
      overflow: hidden;
      font-size: 14px;
      line-height: 1.5;
    }

    /* === REPO HEADER / BREADCRUMB === */
    .ghv-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 12px 16px;
      background: #161b22;
      border-bottom: 1px solid #30363d;
      flex-wrap: wrap;
    }

    .ghv-crumb {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 14px;
      flex-wrap: wrap;
    }

    .ghv-crumb-owner {
      color: #8b949e;
    }

    .ghv-crumb-sep {
      color: #30363d;
      font-size: 1.1em;
    }

    .ghv-crumb-repo {
      color: #58a6ff;
      font-weight: 600;
    }

    .ghv-header-pills {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-left: auto;
      flex-shrink: 0;
    }

    .ghv-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 3px 10px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid #30363d;
      border-radius: 999px;
      font-size: 12px;
      color: #8b949e;
    }

    .ghv-pill svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
      opacity: 0.7;
    }

    /* === SUB-HEADER (branch + stats bar) === */
    .ghv-subheader {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 8px 16px;
      background: #161b22;
      border-bottom: 1px solid #30363d;
      font-size: 12px;
      color: #8b949e;
      flex-wrap: wrap;
    }

    .ghv-branch-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 3px 8px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid #30363d;
      border-radius: 6px;
      color: #c9d1d9;
      font-size: 12px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    .ghv-branch-badge svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
    }

    .ghv-subheader-sep {
      color: #30363d;
    }

    /* === MAIN TWO-PANE === */
    .ghv-body {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      min-height: 520px;
    }

    /* === FILE TREE === */
    .ghv-tree {
      background: #0d1117;
      border-right: 1px solid #30363d;
      overflow-y: auto;
      padding: 8px 0;
    }

    .ghv-tree-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 12px 8px;
      font-size: 12px;
      font-weight: 600;
      color: #8b949e;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1px solid #21262d;
      margin-bottom: 4px;
    }

    .ghv-tree-root {
      padding: 0 4px;
    }

    /* root README.md file */
    .ghv-file {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 4px;
      font-size: 13px;
      color: #c9d1d9;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      position: relative;
      transition: background 80ms ease-out, color 80ms ease-out;
    }

    .ghv-file:hover {
      background: rgba(177, 186, 196, 0.08);
      color: #f0f6fc;
    }

    .ghv-file--selected {
      background: rgba(56, 139, 253, 0.15);
      color: #ffffff;
    }

    .ghv-file--selected::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 2px;
      background: #58a6ff;
      border-radius: 0 2px 2px 0;
    }

    .ghv-file--selected:hover {
      background: rgba(56, 139, 253, 0.2);
    }

    .ghv-file-icon {
      flex-shrink: 0;
      width: 16px;
      height: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0.7;
    }

    .ghv-file-icon svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
    }

    /* folder section */
    .ghv-folder {
      margin-top: 2px;
    }

    .ghv-folder-row {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      font-size: 13px;
      font-weight: 600;
      color: #c9d1d9;
      cursor: pointer;
      user-select: none;
      border-radius: 4px;
      transition: background 80ms ease-out;
    }

    .ghv-folder-row:hover {
      background: rgba(177, 186, 196, 0.08);
    }

    /* Subfolder rows get extra indent */
    .ghv-folder-row--sub {
      padding-left: 24px;
      font-weight: 500;
    }

    .ghv-folder-icon {
      flex-shrink: 0;
      color: #58a6ff;
      width: 16px;
      height: 16px;
      display: flex;
      align-items: center;
    }

    .ghv-folder-icon svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
    }

    .ghv-folder-caret {
      flex-shrink: 0;
      color: #8b949e;
      font-size: 10px;
      width: 12px;
      text-align: center;
      transition: transform 140ms ease-out;
    }

    .ghv-folder-caret.is-open {
      transform: rotate(90deg);
    }

    .ghv-folder-files {
      padding-left: 20px;
    }

    .ghv-folder-files .ghv-file {
      padding-left: 10px;
    }

    /* Nested subfolder files get extra indent */
    .ghv-folder-files .ghv-folder-files .ghv-file {
      padding-left: 18px;
    }

    /* === PREVIEW PANE === */
    .ghv-preview {
      background: #0d1117;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .ghv-preview-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 10px 16px;
      background: #161b22;
      border-bottom: 1px solid #30363d;
      flex-wrap: wrap;
    }

    .ghv-preview-path {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 12px;
      color: #8b949e;
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* JS dynamically rewrites this span without scoped attributes — must be fully :global */
    :global(.ghv-preview-path span) {
      color: #58a6ff;
    }

    .ghv-preview-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .ghv-preview-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid #30363d;
      border-radius: 6px;
      font-size: 12px;
      color: #c9d1d9;
      cursor: default;
    }

    .ghv-preview-content {
      padding: 24px 32px 32px;
      overflow-y: auto;
      flex: 1;
    }

    /* === RESUME ITEM CARD & GHV PANEL CONTENT (global — targets set:html injected content) === */
    :global(.resume-item-card) {
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
    }

    :global(.ghv-item-logo) {
      flex: 0 0 3.5rem;
      width: 3.5rem;
      height: 3.5rem;
    }

    :global(.ghv-item-logo__img) {
      width: 100%;
      height: 100%;
      object-fit: contain;
      /* Lighten dark logos on dark background */
      filter: brightness(1.1);
    }

    :global(.ghv-item-body) {
      flex: 1;
      min-width: 0;
    }

    :global(.ghv-item-meta) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.6rem;
      align-items: center;
      color: #8b949e;
      font-size: 0.875rem;
      margin: 0.5rem 0 1rem !important;
    }

    :global(.ghv-item-links) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }

    /* === BADGES (inside ghv panels — global) === */
    :global(.ghv-badge) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 0.25rem 0.65rem;
      font-size: 0.8rem;
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
    }

    :global(.ghv-badge--primary)   { background: #388bfd; color: #ffffff; }
    :global(.ghv-badge--accent)    { background: #3fb950; color: #0d1117; }
    :global(.ghv-badge--secondary) { background: #58a6ff; color: #0d1117; }
    :global(.ghv-badge--info)      { background: #79c0ff; color: #0d1117; }

    /* === README PROFILE (global) === */
    :global(.ghv-readme-profile) {
      display: flex;
      gap: 1.75rem;
      align-items: flex-start;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }

    :global(.ghv-readme-avatar) {
      flex: 0 0 6rem;
      width: 6rem;
      height: 6rem;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid #30363d;
      background: #161b22;
    }

    :global(.ghv-readme-avatar__img) {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    :global(.ghv-readme-intro) {
      flex: 1;
      min-width: 220px;
    }

    /* README name heading: no divider line — person's name, not a file title.
       Fully global so it works inside set:html content; specificity [0,3,1] > [0,1,1]. */
    :global(.ghv-readme.ghv-md .ghv-readme-intro h1) {
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 0.5rem;
      font-size: 1.6em;
    }

    :global(.ghv-readme-badges) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin: 0 0 1rem;
    }

    /* === Markdown-style content rendering (all fully global — targets set:html content) === */
