---
// /resume/ — the repo explorer (resume-soe.12 D5, F4). Desktop (>860px): two panes, the lime
// section words are the tree, the open file is set like poster type on the right. <=860px: a
// compact accordion; one section and one file open at a time, the file opens inline under its own
// row, and that row turns pink and stays pinned while you read. Every file has a #path deep link.
// The face avatar is the home link; the page renders bare (no site navbar), it owns the viewport.
import BaseLayout from '../layouts/BaseLayout.astro';
import { achievements, education, resumeIntro, workExperience } from '../data/resume';
import type { ResumeItem } from '../data/resume';
import { skillFiles } from '../data/resume-skills';
import { buildSection, buildSkills } from '../lib/resume-tree';
import type { TreeFolder } from '../lib/resume-tree';

const years = (range: string) => {
  const ys = range.match(/\d{4}/g) ?? [];
  const open = /\.\.\./.test(range);
  const from = ys[0] ?? range;
  const to = open ? 'now' : ys[1];
  return to ? `${from}–${to}` : from;
};

// Skill files carry their filename as an <h1>; the explorer sets a readable title instead.
const acronyms: Record<string, string> = { llm: 'LLM', apis: 'APIs', mmm: 'MMM' };
const titleFromFile = (f: string) =>
  f
    .replace(/\.md$/, '')
    .split('-')
    .map((w) => acronyms[w] ?? w)
    .join(' ')
    .replace(/^./, (c) => c.toUpperCase());

const renderItem = (item: ResumeItem) => {
  const place = [item.company, item.location].filter(Boolean).join(', ');
  const links = item.links?.length
    ? `<p class="p-links">${item.links
        .map((l) => `<a href="${l.href}" target="_blank" rel="noreferrer">${l.label}</a>`)
        .join('')}</p>`
    : '';
  return `
<h2 class="p-title">${item.title.trim()}</h2>
<p class="p-meta"><span class="p-role">${item.role}</span><span>${place}</span><span>${years(item.dateRange)}</span></p>
<div class="p-prose"><p>${item.body}</p></div>
${links}`;
};

const experience = buildSection('experience', workExperience, renderItem);
const achievementSection = buildSection('achievements', achievements, renderItem);
const educationSection = buildSection('education', education, renderItem);
const skills = buildSkills(skillFiles);

for (const [path, html] of Object.entries(skills.contents)) {
  const file = path.split('/').pop() ?? path;
  skills.contents[path] = `
<h2 class="p-title">${titleFromFile(file)}</h2>
<div class="p-prose p-skill">${html.replace(/<h1>[\s\S]*?<\/h1>/, '')}</div>`;
}

// Years shown beside each file in the tree (dated sections only).
const itemYears: Record<string, string> = {};
for (const [section, items] of [
  [experience, workExperience],
  [achievementSection, achievements],
  [educationSection, education],
] as const) {
  section.files.forEach((f, i) => (itemYears[f.path] = years(items[i].dateRange)));
}

const folders: (TreeFolder & { label: string })[] = [
  { name: 'experience', label: 'Experience', files: experience.files },
  { name: 'achievements', label: 'Achievements', files: achievementSection.files },
  { name: 'skills', label: 'Skills', files: [], subfolders: skills.subfolders },
  { name: 'education', label: 'Education', files: educationSection.files },
];
const countFiles = (f: TreeFolder): number =>
  f.files.length + (f.subfolders ?? []).reduce((n, s) => n + countFiles(s), 0);

const readmeHtml = `
<div class="readme">
  <div class="readme-head">
    <h2 class="p-title p-title--readme">Jonatan Snyders</h2>
    <p class="readme-roles">${resumeIntro.headlineBadges.join('<br />')}</p>
  </div>
  <img class="readme-photo" src="/img/jonatan_roaring_no_bg.png" alt="Jonatan on all fours on a rock, roaring at the camera." width="436" height="437" loading="lazy" />
  <div class="p-prose readme-prose">${resumeIntro.paragraphs.map((p) => `<p>${p}</p>`).join('')}</div>
</div>`;

const contents: Record<string, string> = {
  'README.md': readmeHtml,
  ...experience.contents,
  ...achievementSection.contents,
  ...skills.contents,
  ...educationSection.contents,
};
const panelId = (path: string) => 'f-' + path.replace(/[^a-z0-9]+/gi, '-');
const DEFAULT_PATH = 'README.md';
---

<BaseLayout
  bare
  title="Resume | Jonatan Snyders"
  description="Resume of Jonatan Snyders — web developer, data scientist, ex-founder, and growth engineer."
>
  <div class="resume-page">
    <header class="top">
      <a class="home" href="/">
        <img src="/img/avatar_jonatan.png" alt="" width="253" height="252" />
        <span>Jonatan Snyders</span>
      </a>
      <h1 class="top-title">Resume</h1>
      <ul class="top-links">
        <li><a href="https://github.com/jsnyde0/" rel="me">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/jonatan-snyders/" rel="me">LinkedIn</a></li>
      </ul>
    </header>

    <main class="explorer">
      <nav class="tree" id="tree" aria-label="Resume files">
        <ul class="tree-root">
          <li>
            <button
              class="sect file"
              type="button"
              data-path="README.md"
              aria-controls={panelId('README.md')}
              aria-current="true"
            ><span>README</span><span class="mark" aria-hidden="true"></span></button>
          </li>
          {folders.map((folder) => (
            <li class="folder">
              <button
                class="sect folder-toggle"
                type="button"
                aria-expanded="false"
                aria-controls={`dir-${folder.name}`}
                data-folder={folder.name}
              >
                <span>{folder.label}</span>
                <span class="count" aria-label={`${countFiles(folder)} files`}>{countFiles(folder)}</span>
              </button>
              <ul class="files" id={`dir-${folder.name}`} hidden>
                {folder.files.map((file) => (
                  <li>
                    <button class="file leaf" type="button" data-path={file.path} aria-controls={panelId(file.path)}>
                      <span class="leaf-name"><span class="leaf-dir">{folder.name}/</span>{file.name}</span>
                      {itemYears[file.path] && <span class="leaf-meta">{itemYears[file.path]}</span>}
                      <span class="mark" aria-hidden="true"></span>
                    </button>
                  </li>
                ))}
                {folder.subfolders?.map((sub) => (
                  <li class="sub">
                    <button
                      class="sub-toggle"
                      type="button"
                      aria-expanded="false"
                      aria-controls={`dir-${folder.name}-${sub.name}`}
                      data-folder={`${folder.name}/${sub.name}`}
                    >
                      {sub.name}/
                    </button>
                    <ul class="files files--sub" id={`dir-${folder.name}-${sub.name}`} hidden>
                      {sub.files.map((file) => (
                        <li>
                          <button class="file leaf" type="button" data-path={file.path} aria-controls={panelId(file.path)}>
                            <span class="leaf-name"><span class="leaf-dir">{folder.name}/{sub.name}/</span>{file.name}</span>
                            <span class="mark" aria-hidden="true"></span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </nav>

      <section class="pane" id="pane" aria-label="Open file">
        {Object.entries(contents).map(([path, html]) => {
          const parts = path.split('/');
          const file = parts.pop();
          return (
            <article class="panel" id={panelId(path)} data-panel={path} tabindex="-1" hidden={path !== DEFAULT_PATH}>
              <p class="p-path">
                {parts.map((p) => <span class="p-dir">{p}/</span>)}
                <span class="p-file">{file}</span>
              </p>
              <Fragment set:html={html} />
            </article>
          );
        })}
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  // One set of panels, two layouts. Desktop (>860px): two panes, panels live in #pane.
  // <=860px: an accordion; the open panel is moved into the tree, right under its own row.
  const DEFAULT_PATH = 'README.md';
  const desktop = window.matchMedia('(min-width: 861px)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pane = document.getElementById('pane') as HTMLElement;

  const fileButtons = [...document.querySelectorAll<HTMLButtonElement>('#tree button[data-path]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const sectionToggles = [...document.querySelectorAll<HTMLButtonElement>('#tree .folder-toggle')];
  let current: string | null = null;

  const buttonFor = (path: string) => fileButtons.find((b) => b.dataset.path === path);
  const panelFor = (path: string) => panels.find((p) => p.dataset.panel === path);
  const behavior = (): ScrollBehavior => (reduced.matches ? 'auto' : 'smooth');

  function setFolder(toggle: HTMLButtonElement, open: boolean) {
    const list = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (!list) return;
    list.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
  }

  // Open every folder on the way to a file, so a deep link shows where you are.
  function revealInTree(path: string) {
    const parts = path.split('/').slice(0, -1);
    for (let i = 1; i <= parts.length; i++) {
      const t = document.querySelector<HTMLButtonElement>(`#tree button[data-folder="${parts.slice(0, i).join('/')}"]`);
      if (t) setFolder(t, true);
    }
  }

  function animateIn(panel: HTMLElement) {
    panel.classList.remove('is-entering');
    void panel.offsetWidth; // restart the entrance
    panel.classList.add('is-entering');
  }

  function sync() {
    const mobile = !desktop.matches;
    for (const b of fileButtons) {
      const on = b.dataset.path === current;
      b.setAttribute('aria-current', String(on));
      if (mobile) b.setAttribute('aria-expanded', String(on));
      else b.removeAttribute('aria-expanded');
      b.closest('li')?.classList.toggle('is-open', mobile && on);
    }
    for (const p of panels) {
      const on = p.dataset.panel === current;
      p.hidden = !on;
      const btn = buttonFor(p.dataset.panel ?? '');
      if (mobile && on && btn) btn.after(p); // inline, right under its row
      else if (p.parentElement !== pane) pane.append(p);
    }
    history.replaceState(null, '', !current || current === DEFAULT_PATH ? location.pathname : `#${current}`);
  }

  function open(path: string, userAction: boolean) {
    const panel = panelFor(path);
    if (!panel) return;
    if (!desktop.matches) {
      // Accordion: one section open at a time, so the list stays short.
      const section = path.split('/')[0];
      sectionToggles.forEach((t) => { if (t.dataset.folder !== section) setFolder(t, false); });
    }
    current = path;
    revealInTree(path);
    sync();
    animateIn(panel);
    if (!userAction) return;
    if (desktop.matches) {
      pane.scrollTop = 0;
      if (pane.getBoundingClientRect().top < 0) pane.scrollIntoView({ behavior: behavior() });
    } else {
      // The previous file has folded away above or below; bring this row to the top to read.
      buttonFor(path)?.closest('li')?.scrollIntoView({ behavior: behavior(), block: 'start' });
    }
  }

  function close(path: string) {
    const btn = buttonFor(path);
    current = null;
    sync();
    // Folding a long file can leave the row far above the viewport; bring it back.
    if (btn && btn.getBoundingClientRect().top < 0) btn.scrollIntoView({ behavior: 'auto', block: 'start' });
  }

  fileButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const path = b.dataset.path ?? DEFAULT_PATH;
      if (!desktop.matches && current === path) close(path);
      else open(path, true);
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('#tree button[data-folder]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      const isSection = toggle.classList.contains('folder-toggle');
      if (!desktop.matches && isSection) {
        if (opening) sectionToggles.forEach((t) => t !== toggle && setFolder(t, false));
        // A file outside what is still open folds away with its folder.
        const keep = opening ? toggle.dataset.folder : null;
        if (current && current !== DEFAULT_PATH && current.split('/')[0] !== keep) { current = null; sync(); }
      }
      setFolder(toggle, opening);
      if (!desktop.matches && opening && toggle.getBoundingClientRect().top < 0) {
        toggle.scrollIntoView({ behavior: 'auto', block: 'start' });
      }
    });
  });

  // Crossing the breakpoint: desktop always shows a file (README by default); mobile keeps yours.
  desktop.addEventListener('change', () => {
    if (desktop.matches && !current) current = DEFAULT_PATH;
    sync();
  });

  window.addEventListener('hashchange', () => {
    const path = decodeURIComponent(location.hash.slice(1));
    if (panelFor(path)) open(path, true);
  });

  const fromHash = decodeURIComponent(location.hash.slice(1));
  const exp = document.querySelector<HTMLButtonElement>('#tree button[data-folder="experience"]');
  if (exp) setFolder(exp, true); // the first section is open on arrival, so one tap reads a file
  if (fromHash && panelFor(fromHash)) {
    open(fromHash, false);
    if (!desktop.matches) buttonFor(fromHash)?.closest('li')?.scrollIntoView({ block: 'start' });
  } else if (desktop.matches) {
    current = DEFAULT_PATH;
    sync();
  } else {
    current = null;
    sync();
  }
</script>

<style is:global>
  /* Global, not scoped: panel bodies are injected html (set:html) and the script moves panels
     between the pane and the tree, so scoped data-attributes would not reach them. Every rule is
     prefixed .resume-page, and this sheet ships with /resume/ only. */
  html,
  body { background: var(--id-ground); }

  .resume-page {
    --pad: clamp(1rem, 2.4vw, 2.25rem);
    --ease: cubic-bezier(0.25, 1, 0.5, 1);

    min-height: 100svh;
    background: var(--id-ground);
    color: var(--id-paper);
    font-family: var(--id-font-body);
    font-weight: var(--id-weight-body);
    line-height: normal;
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
  }

  .resume-page a { color: inherit; text-decoration: underline; }
  .resume-page a:focus-visible,
  .resume-page button:focus-visible {
    /* Paper, not pink: the selected file is already pink, and the ring must stay visible on it. */
    outline: 3px solid var(--id-paper);
    outline-offset: 3px;
  }

  /* ── Top bar ─────────────────────────────────────────── */
  .resume-page .top {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--pad);
    align-items: center;
    padding: var(--pad) var(--pad) 0;
  }
  .resume-page .home {
    grid-column: 1 / span 5;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: start;
    min-height: 44px;
    font-weight: var(--id-weight-strong);
    font-size: var(--id-text-body);
    letter-spacing: var(--id-tracking-heading);
    text-decoration: none;
  }
  .resume-page .home img { width: 44px; height: auto; }
  .resume-page .home:hover span { background: var(--id-pink); color: var(--id-ink); }
  .resume-page .top-title {
    grid-column: 6 / span 3;
    margin: 0;
    font-size: var(--id-text-body);
    font-weight: var(--id-weight-strong);
    color: var(--id-lime);
  }
  .resume-page .top-links {
    grid-column: 9 / -1;
    flex-wrap: wrap;
    justify-self: end;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .resume-page .top-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 0.18em;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  .resume-page .top-links a:hover { background: var(--id-pink); color: var(--id-ink); text-decoration-color: transparent; }

  /* ── Explorer: tree left, open file right ─────────────── */
  .resume-page .explorer {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--pad);
    align-items: start;
    min-height: 0;
    padding: clamp(2rem, 5vw, 4.5rem) var(--pad) 7rem;
  }
  /* The tree is a size container so the longest name ("Achievements" + count) always fits its column. */
  .resume-page .tree { grid-column: 1 / span 5; container-type: inline-size; }
  .resume-page .pane {
    grid-column: 6 / -1;
    position: sticky;
    top: var(--pad);
    max-height: calc(100svh - 2 * var(--pad));
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--id-rule) transparent;
    padding-left: clamp(0rem, 2vw, 2rem);
  }

  :where(.resume-page .tree) ul { list-style: none; margin: 0; padding: 0; }
  /* :where() keeps this reset at zero specificity so the type rules below win. */
  :where(.resume-page .tree) button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  /* The section names are the poster. */
  .resume-page .sect {
    display: flex;
    align-items: flex-start;
    gap: 0.12em;
    width: 100%;
    color: var(--id-lime);
    font-weight: var(--id-weight-poster);
    font-size: min(14.2cqi, 7rem);
    line-height: 0.86;
    letter-spacing: -0.055em;
    padding: 0.06em 0 0.08em;
    margin-left: -0.04em;
    transition: color 160ms var(--ease);
  }
  .resume-page .sect:hover { color: var(--id-paper); }
  .resume-page .sect.file[aria-current='true'] {
    width: auto;
    background: var(--id-pink);
    color: var(--id-ink);
    padding-inline: 0.06em;
  }
  .resume-page .count {
    font-size: 0.2em;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    padding-top: 0.5em;
    color: var(--id-paper-2);
  }
  .resume-page .folder-toggle[aria-expanded='true'] .count { color: var(--id-lime); }

  /* Files: plain readable lines on a strict two-column rhythm (name, years). */
  .resume-page .files {
    margin: 0.75rem 0 1.75rem;
    border-top: 1px solid var(--id-rule);
  }
  .resume-page .files--sub { margin: 0 0 0.5rem 1.25rem; border-top: 0; }
  .resume-page .leaf,
  .resume-page .sub-toggle {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 0.5rem;
    border-bottom: 1px solid var(--id-rule);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: var(--id-tracking-heading);
    transition: background-color 140ms var(--ease), color 140ms var(--ease);
  }
  .resume-page .sub-toggle { color: var(--id-lime); font-weight: var(--id-weight-strong); }
  .resume-page .files--sub .leaf { font-size: var(--id-text-body); font-weight: var(--id-weight-medium); border-bottom-color: transparent; min-height: 40px; }
  .resume-page .leaf-meta { color: var(--id-paper-2); font-weight: var(--id-weight-medium); font-variant-numeric: tabular-nums; font-size: 1rem; }
  .resume-page .leaf:hover,
  .resume-page .sub-toggle:hover { background: var(--id-tint-hover); }
  .resume-page .leaf[aria-current='true'] { background: var(--id-pink); color: var(--id-ink); }
  .resume-page .leaf[aria-current='true'] .leaf-meta { color: var(--id-ink); }

  /* ── The open file, set like poster type ─────────────── */
  .resume-page .panel { outline: none; }
  .resume-page .panel.is-entering { animation: resume-enter 380ms var(--ease) both; }
  @keyframes resume-enter {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  .resume-page .p-path {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin: 0 0 1.5rem;
    font-size: var(--id-text-small);
    color: var(--id-paper-2);
  }
  .resume-page .p-file { color: var(--id-lime); font-weight: 700; }
  .resume-page .mark { display: none; }
  /* The folder path is only shown on the open, pinned row (<=860px), where the list above is out of view. */
  .resume-page .leaf-dir { display: none; }

  .resume-page .p-title {
    margin: 0 0 1.25rem;
    max-width: 16ch;
    color: var(--id-paper);
    font-size: var(--id-text-display);
    font-weight: 850;
    line-height: var(--id-leading-display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .resume-page .p-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0 0 2rem;
    padding: 0.75rem 0;
    border-block: 1px solid var(--id-rule);
    font-size: var(--id-text-body);
    color: var(--id-paper-2);
  }
  .resume-page .p-role { color: var(--id-lime); font-weight: var(--id-weight-strong); }

  .resume-page .p-prose { max-width: 58ch; }
  .resume-page .p-prose p {
    margin: 0 0 1em;
    font-size: clamp(1.125rem, 1.35vw, 1.3rem);
    line-height: 1.5;
  }
  .resume-page .p-skill h2 {
    margin: 2rem 0 0.5rem;
    font-size: var(--id-text-small);
    font-weight: var(--id-weight-strong);
    color: var(--id-lime);
  }
  .resume-page .p-skill ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--id-rule); }
  .resume-page .p-skill li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--id-rule);
    font-size: 1.1rem;
    line-height: 1.4;
  }
  .resume-page .p-links { display: flex; gap: 1.5rem; margin: 0.5rem 0 0; }
  .resume-page .p-links a,
  .resume-page .p-prose a {
    color: var(--id-lime);
    font-weight: 700;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.18em;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  .resume-page .p-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: 1.15rem; }
  .resume-page .p-links a:hover,
  .resume-page .p-prose a:hover { background: var(--id-pink); color: var(--id-ink); text-decoration-color: transparent; }

  /* README: the roar earns its place next to who he is. */
  .resume-page .readme {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    column-gap: var(--pad);
    align-items: start;
  }
  .resume-page .readme-head { grid-column: 1; }
  .resume-page .p-title--readme { font-size: clamp(2.5rem, 5vw, 5rem); max-width: 8ch; }
  .resume-page .readme-roles {
    margin: 0;
    color: var(--id-lime);
    font-size: var(--id-text-heading);
    font-weight: var(--id-weight-strong);
