    }

    .ghv-dl-btn:hover { background: #2ea043; }
    .ghv-dl-btn:focus-visible { outline: 2px solid #58a6ff; outline-offset: 2px; }

    .ghv-dl-btn svg {
      width: 13px;
      height: 13px;
      fill: currentColor;
