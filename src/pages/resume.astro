        margin: 0 0 1rem 0;
      }
    }

    @media (max-width: 640px) {
      .ghv-body {
        grid-template-columns: 1fr;
        grid-template-rows: auto 1fr;
      }

      .ghv-tree {
        border-right: none;
        border-bottom: 1px solid #30363d;
