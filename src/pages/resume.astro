    /* === ITEM CARD — width-fill layout === */
    /* Float the logo so body text fills full width and wraps under it */
    :global(.resume-item-card) {
      display: block; /* override flex */
    }

    :global(.ghv-item-logo) {
      float: left;
      width: 3.5rem;
      height: 3.5rem;
      margin: 0 1.25rem 0.75rem 0;
      flex: none; /* cancel any residual flex sizing */
    }

    :global(.ghv-item-body) {
      /* No min-width/flex needed — it's a block that flows around the float */
      display: block;
    }

    /* The h1 and meta sit beside the float; paragraphs wrap under it */
    :global(.ghv-item-body p:not(.ghv-item-meta)) {
      max-width: none; /* let body text fill full width */
      clear: none;     /* stays beside float until float height exceeded */
    }

    /* After the card content, clear the float so next card starts fresh */
    :global(.resume-item-card::after) {
      content: '';
      display: table;
      clear: both;
    }

    /* === README PROFILE — width-fill layout === */
    :global(.ghv-readme-profile) {
      display: block; /* override flex */
      margin-bottom: 2.5rem;
