      background: #161b22;
      margin: 0 1.75rem 1rem 0;
      flex: none;
    }

    :global(.ghv-readme-intro) {
      display: block; /* flows around float */
      min-width: 0;
    }

    /* Paragraphs in the intro extend full width and start below the avatar
       (name + badges stay beside it; the bio text does not wrap around it) */
    :global(.ghv-readme-intro p) {
      max-width: none;
      clear: left;
    }

    /* Clear the float after profile block */
    :global(.ghv-readme-profile::after) {
      content: '';
      display: table;
      clear: both;
    }

    /* Widen ghv-md p/li inside item body and readme intro for full-width fill */
    :global(.ghv-item-body .ghv-md p),
    :global(.ghv-item-body .ghv-md li) {
      max-width: none;
    }

    @media (max-width: 767px) {
      /* On narrow screens revert to stacked block — no float needed */
      :global(.ghv-item-logo) {
        float: none;
        margin: 0 0 0.75rem 0;
