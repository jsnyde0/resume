---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="The software factory | Jonatan Snyders" description="An always-on software factory: agents that pick up goals and do the work in a sandbox, unattended. State lives in the substrate, not the agent.">
  <div class="factory-page">

    <!-- 1. Hero -->
    <header class="factory-hero">
      <p class="factory-kicker">what excites me</p>
      <h1>The software factory I'm building.</h1>
      <p class="factory-lede">
        An always-on software factory: agents that pick up goals and do the work in a sandbox, unattended. The idea underneath it: state lives in the substrate, not the agent — so the agents are disposable and the whole system is crash-resumable. The direction I'm building toward is self-driving; here's the system so far, and where I honestly am on the way there.
      </p>
    </header>

    <!-- 2. Interactive Component Graph -->
    <section class="factory-graph" aria-label="Interactive component graph">
      <div class="graph-header">
        <h2 class="graph-title">How the pieces connect</h2>
        <button class="graph-reset" id="graph-reset" aria-label="Reset graph — show all nodes" hidden>
          show all
        </button>
      </div>
      <p class="graph-hint">Select a node to trace its connections.</p>

      <!-- Desktop graph (CSS positioned layout) -->
      <div class="graph-wrap" id="graph-wrap" role="application" aria-label="Software factory component graph">

        <!-- Connection lines drawn by JS after layout -->
        <svg class="graph-svg-overlay" id="graph-svg-overlay" aria-hidden="true" focusable="false"></svg>

        <!--
          Layout columns (desktop):
          col A (left): Cockpit section + Building toward section
          col B (center): pi + always-on host (foundation)
          col C (right): Substrate section + Sandbox section
          row bottom: The work loop
        -->

        <!-- Column A: Cockpit -->
        <div class="graph-section" id="section-cockpit" data-section="cockpit" style="grid-area: cockpit">
          <div class="section-header">
            <span class="section-name">Cockpit</span>
            <span class="section-sub">watch &amp; steer</span>
          </div>
          <div class="section-nodes">
            <button
              class="node node--running"
              id="node-herdr"
              data-node="herdr"
              data-connects="node-pi,node-orch,node-cmux"
              aria-pressed="false"
            >
              <span class="node-name">herdr</span>
              <span class="node-badge node-badge--running">running</span>
            </button>
            <button
              class="node node--running"
              id="node-cmux"
              data-node="cmux"
              data-connects="node-pi,node-herdr"
              aria-pressed="false"
            >
              <span class="node-name">cmux</span>
              <span class="node-badge node-badge--running">running</span>
            </button>
          </div>
        </div>

        <!-- Column B: pi center + always-on host -->
        <div class="graph-center-col" style="grid-area: center-col">
          <button
            class="node node--center node--running"
            id="node-pi"
            data-node="pi"
            data-connects="node-host,node-beads,node-memory,node-ripcage,node-ironproxy,node-herdr,node-cmux,node-orch,node-drover"
            aria-pressed="false"
          >
            <a href="https://github.com/badlogic/pi-mono" target="_blank" rel="noopener" class="node-link" tabindex="-1" aria-label="pi on GitHub (opens new tab)">
              <span class="node-name">pi</span>
            </a>
            <span class="node-sub">my harness</span>
            <span class="node-badge node-badge--running">running</span>
          </button>

          <button
            class="node node--running node--host"
            id="node-host"
            data-node="host"
            data-connects="node-pi"
            aria-pressed="false"
          >
            <span class="node-name">always-on host</span>
            <span class="node-badge node-badge--running">running</span>
          </button>
        </div>

        <!-- Column A bottom: Building toward -->
        <div class="graph-section graph-section--building-toward" id="section-building" data-section="building" style="grid-area: building">
          <div class="section-header">
            <span class="section-name section-name--building-toward">Building toward</span>
            <span class="section-sub section-sub--building-toward">not done yet</span>
          </div>
          <div class="section-nodes">
            <button
              class="node node--building-toward"
              id="node-selfdriving"
              data-node="selfdriving"
              data-connects=""
              aria-pressed="false"
            >
              <span class="node-name">self-driving</span>
              <span class="node-badge node-badge--building-toward">building toward</span>
            </button>
            <button
              class="node node--building-toward"
              id="node-mail"
              data-node="mail"
              data-connects="node-orch"
              aria-pressed="false"
            >
              <span class="node-name">agent_mail</span>
              <span class="node-badge node-badge--building-toward">building toward</span>
            </button>
          </div>
        </div>

        <!-- Column C: Substrate -->
        <div class="graph-section" id="section-substrate" data-section="substrate" style="grid-area: substrate">
          <div class="section-header">
            <span class="section-name">Substrate</span>
            <span class="section-sub">state lives here</span>
          </div>
          <div class="section-nodes">
            <button
              class="node node--running"
              id="node-beads"
              data-node="beads"
              data-connects="node-pi,node-orch,node-drover"
              aria-pressed="false"
            >
              <span class="node-name">beads</span>
              <span class="node-badge node-badge--running">running</span>
            </button>
            <button
              class="node node--running"
              id="node-memory"
              data-node="memory"
              data-connects="node-pi,node-orch"
              aria-pressed="false"
            >
              <span class="node-name">tiered memory</span>
              <span class="node-badge node-badge--running">running</span>
            </button>
          </div>
        </div>

        <!-- Column C bottom: Sandbox -->
        <div class="graph-section" id="section-sandbox" data-section="sandbox" style="grid-area: sandbox">
          <div class="section-header">
            <span class="section-name">Sandbox</span>
            <span class="section-sub">safe to run unattended</span>
          </div>
          <div class="section-nodes">
            <button
              class="node node--running"
              id="node-ripcage"
              data-node="ripcage"
              data-connects="node-pi,node-orch,node-ironproxy"
              aria-pressed="false"
            >
              <a href="https://github.com/jsnyde0/rip-cage" target="_blank" rel="noopener" class="node-link" tabindex="-1" aria-label="rip-cage on GitHub (opens new tab)">
                <span class="node-name">rip-cage</span>
              </a>
              <span class="node-badge node-badge--running">running</span>
            </button>
            <button
              class="node node--running"
              id="node-ironproxy"
              data-node="ironproxy"
              data-connects="node-pi,node-ripcage"
              aria-pressed="false"
            >
              <span class="node-name">iron-proxy</span>
              <span class="node-badge node-badge--running">running</span>
            </button>
          </div>
        </div>

        <!-- Bottom row: The work loop -->
        <div class="graph-section graph-section--workloop" id="section-workloop" data-section="workloop" style="grid-area: workloop">
          <div class="section-header">
            <span class="section-name">The work loop</span>
          </div>
          <div class="section-nodes section-nodes--row">
            <button
              class="node node--running"
              id="node-orch"
              data-node="orch"
              data-connects="node-pi,node-beads,node-memory,node-ripcage,node-herdr,node-drover,node-mail"
              aria-pressed="false"
            >
              <span class="node-name">disposable orchestrators</span>
              <span class="node-badge node-badge--running">running</span>
            </button>
            <button
              class="node node--running"
              id="node-drover"
              data-node="drover"
              data-connects="node-pi,node-beads,node-orch"
              aria-pressed="false"
            >
              <span class="node-name">the drover</span>
              <span class="node-sub">suggest-mode</span>
              <span class="node-badge node-badge--running">running</span>
            </button>
          </div>
        </div>

      </div>

      <!-- Legend -->
      <div class="graph-legend" aria-label="Legend">
        <span class="legend-item">
          <span class="legend-swatch legend-swatch--running" aria-hidden="true"></span>
          running
        </span>
        <span class="legend-item">
          <span class="legend-swatch legend-swatch--building-toward" aria-hidden="true"></span>
          building toward
        </span>
      </div>
    </section>

    <!-- 3. The components list -->
    <section class="factory-components" aria-label="Component descriptions" id="components-list">
      <h2 class="components-title">The components</h2>

      <!-- Foundation -->
      <div class="comp-group">
        <h3 class="comp-group-label">Foundation</h3>
        <ul class="comp-list">
          <li class="comp-item" id="comp-pi" data-comp="pi">
            <strong class="comp-name">pi — my harness</strong> — The foundation. I build on <a href="https://github.com/badlogic/pi-mono" target="_blank" rel="noopener" class="factory-link">pi</a> because it's changeable all the way down — closed harnesses like Claude Code only let you bolt on hooks and skills, but parts of my system only exist because I can change the agent itself. The model behind it is swappable; the harness is the part I build and own.
          </li>
          <li class="comp-item" id="comp-host" data-comp="host">
            <strong class="comp-name">Always-on host</strong> — It runs on a box that's always on — a Mac mini now, a VPS next — not my laptop. I close the lid and the agents keep going. With the crash-resumable substrate, that's what makes "unattended" actually true.
          </li>
        </ul>
      </div>

      <!-- Substrate -->
      <div class="comp-group">
        <h3 class="comp-group-label">Substrate <span class="comp-group-sub">state lives here</span></h3>
        <ul class="comp-list">
          <li class="comp-item" id="comp-beads" data-comp="beads">
            <strong class="comp-name">beads</strong> — Work is a graph of goals, not a chat log: every task is a node with its dependencies, so the plan survives any single agent dying.
          </li>
          <li class="comp-item" id="comp-memory" data-comp="memory">
            <strong class="comp-name">tiered memory</strong> — Memory kept by lifecycle, so nothing load-bearing is trapped in a context window that's about to be compacted. (session search &amp; memory via cass/cm, by Jeffrey Emanuel)
          </li>
        </ul>
      </div>

      <!-- Sandbox -->
      <div class="comp-group">
        <h3 class="comp-group-label">Sandbox <span class="comp-group-sub">safe to run unattended</span></h3>
        <ul class="comp-list">
          <li class="comp-item" id="comp-ripcage" data-comp="ripcage">
            <strong class="comp-name"><a href="https://github.com/jsnyde0/rip-cage" target="_blank" rel="noopener" class="factory-link">rip-cage</a></strong> — Wraps the work in a container and checks every shell command before it runs, so a mistake can't reach far.
          </li>
          <li class="comp-item" id="comp-ironproxy" data-comp="ironproxy">
            <strong class="comp-name">iron-proxy</strong> — Holds the real credentials so the agents never do — they reach the outside world through it. (by ironsh)
          </li>
        </ul>
      </div>

      <!-- Cockpit -->
      <div class="comp-group">
        <h3 class="comp-group-label">Cockpit <span class="comp-group-sub">watch &amp; steer</span></h3>
        <ul class="comp-list">
          <li class="comp-item" id="comp-herdr" data-comp="herdr">
            <strong class="comp-name">herdr</strong> — A live roster of every session — working, blocked, done — that I can attach to and steer. (by Ogulcan Celik)
          </li>
          <li class="comp-item" id="comp-cmux" data-comp="cmux">
            <strong class="comp-name">cmux</strong> — The session view on my Mac. (by Manaflow)
          </li>
        </ul>
      </div>

      <!-- Work loop -->
      <div class="comp-group">
        <h3 class="comp-group-label">The work loop</h3>
        <ul class="comp-list">
          <li class="comp-item" id="comp-orch" data-comp="orch">
            <strong class="comp-name">Disposable orchestrators</strong> — Each one reads the graph, makes a single move, writes its decision back, and dies; re-spawn it and it picks up from the substrate. The agents are disposable; only the substrate persists. (my /send-it + composable primitives)
          </li>
          <li class="comp-item" id="comp-drover" data-comp="drover">
            <strong class="comp-name">The drover — running, in suggest-mode</strong> — A planner over the whole bead graph. It already runs: it gets an event whenever a piece of work closes and proposes what to pick up next. For now I stay in the loop, approving its moves while I sharpen its judgment.
          </li>
        </ul>
      </div>

      <!-- Building toward -->
      <div class="comp-group comp-group--building-toward">
        <h3 class="comp-group-label comp-group-label--building-toward">Building toward <span class="comp-group-sub">not done yet</span></h3>
        <ul class="comp-list">
          <li class="comp-item comp-item--building-toward" id="comp-selfdriving" data-comp="selfdriving">
            <strong class="comp-name">Self-driving</strong> — The drover acting on its own: deciding what to wake up for, with no human approving each move. That's the edge I'm working at right now — building toward it, not there yet.
          </li>
          <li class="comp-item comp-item--building-toward" id="comp-mail" data-comp="mail">
            <strong class="comp-name">agent_mail</strong> — Collision-avoidance rails so parallel agents don't step on each other. I'm planning to adopt it — honestly, not battle-tested yet. (by Jeffrey Emanuel)
          </li>
        </ul>
      </div>
    </section>

    <!-- 4. Closing -->
    <footer class="factory-closing">
      <p>Right now the planner proposes the next move and I approve it. Closing the gap between "proposes what to do" and "just does it" is what I'm building toward. I'd rather show you a system I'm honestly still building than a finished story that doesn't run.</p>
    </footer>

  </div>
</BaseLayout>

<style>
  .factory-page {
    width: min(100%, 64rem);
    margin: 0 auto;
  }

  /* ── Hero ── */
  .factory-hero {
    max-width: 52rem;
    margin: 0 0 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .factory-kicker {
    margin: 0 0 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .factory-hero h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--content-bright);
  }

  .factory-lede {
    margin: 0;
    max-width: 50rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: var(--line-height-relaxed);
    color: var(--muted-content);
  }

  /* ── Graph section ── */
  .factory-graph {
    margin-bottom: 3.5rem;
  }

  .graph-header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 0.375rem;
  }

  .graph-title {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--content-bright);
  }

  .graph-hint {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted-content);
    letter-spacing: 0.01em;
  }

  .graph-reset {
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background: var(--surface-subtle);
    color: var(--muted-content);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base);
    white-space: nowrap;
  }

  .graph-reset:hover {
    color: var(--content-bright);
    border-color: rgba(171, 196, 220, 0.3);
  }

  .graph-reset:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* ── Graph wrap: CSS grid layout ── */
  .graph-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--base-200);
    padding: 1.5rem;
    /* Mobile: single column stack */
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* SVG overlay for connection lines */
  .graph-svg-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  /* ── Section styles ── */
  .graph-section {
    border: 1px solid rgba(171, 196, 220, 0.1);
    border-radius: var(--radius-md);
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.015);
  }

  .graph-section--building-toward {
    border-style: dashed;
    border-color: rgba(171, 196, 220, 0.08);
    background: rgba(171, 196, 220, 0.01);
  }

  .graph-section--workloop {
    /* work loop sits at bottom spanning full width on desktop */
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .section-name {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(171, 196, 220, 0.5);
  }

  .section-name--building-toward {
    color: rgba(171, 196, 220, 0.35);
  }

  .section-sub {
    font-size: 0.625rem;
    color: rgba(171, 196, 220, 0.3);
    letter-spacing: 0.03em;
  }

  .section-sub--building-toward {
    color: rgba(171, 196, 220, 0.22);
  }

  .section-nodes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-nodes--row {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  /* Center column on mobile: just stacked */
  .graph-center-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem;
    order: -1; /* pi first on mobile */
  }

  /* ── Node styles ── */
  .node {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-md);
    gap: 0.125rem;
    cursor: pointer;
    width: 100%;
    min-height: 44px;
    justify-content: center;
    transition: opacity 240ms ease, box-shadow 240ms ease, border-color 240ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .node { transition: none; }
  }

  .node:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .node--running {
    background: var(--base-300);
    border: 1px solid rgba(171, 196, 220, 0.16);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  .node--center {
    background: var(--primary-tint);
    border: 2px solid rgba(255, 127, 80, 0.35);
    align-items: center;
    text-align: center;
    padding: 1rem 1.5rem;
    width: auto;
    min-width: 8rem;
  }

  .node--host {
    align-items: center;
    text-align: center;
  }

  .node--building-toward {
    background: rgba(171, 196, 220, 0.03);
    border: 1.5px dashed rgba(171, 196, 220, 0.16);
    opacity: 0.75;
  }

  .node.is-selected {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 3px rgba(255, 127, 80, 0.18), 0 2px 12px rgba(0, 0, 0, 0.3) !important;
    opacity: 1 !important;
  }

  .node.is-connected {
    opacity: 1;
    border-color: rgba(171, 196, 220, 0.3);
  }

  .node.is-dimmed {
    opacity: 0.18;
  }

  .node-link {
    display: contents;
    color: inherit;
  }

  .node-name {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--content-bright);
    line-height: 1.3;
  }

  .node--center .node-name {
    font-size: 1rem;
    color: var(--primary);
  }

  .node--building-toward .node-name {
    color: var(--base-content);
    font-weight: 600;
  }

  .node-sub {
    font-size: 0.6875rem;
    color: var(--muted-content);
    letter-spacing: 0.02em;
  }

  .node-badge {
    display: inline-block;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.0625rem 0.3rem;
    border-radius: var(--radius-full);
    margin-top: 0.25rem;
    white-space: nowrap;
  }

  .node-badge--running {
    background: rgba(34, 197, 94, 0.1);
    color: #4ade80;
  }

  .node-badge--building-toward {
    background: rgba(171, 196, 220, 0.07);
    color: rgba(171, 196, 220, 0.55);
  }

  /* SVG edges — set via JS attributes, these classes add transitions + state */
  :global(.graph-edge) {
    fill: none;
    transition: opacity 240ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.graph-edge) { transition: none; }
  }

  :global(.graph-edge.is-dimmed) {
    opacity: 0.15;
  }

  /* Legend */
  .graph-legend {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.875rem;
    padding: 0 0.25rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--muted-content);
  }

  .legend-swatch {
    display: inline-block;
    width: 1.25rem;
    height: 0.5rem;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .legend-swatch--running {
    background: var(--base-300);
    border: 1px solid rgba(171, 196, 220, 0.16);
  }

  .legend-swatch--building-toward {
    background: rgba(171, 196, 220, 0.03);
    border: 1.5px dashed rgba(171, 196, 220, 0.16);
  }

  /* ── Desktop: CSS grid layout ── */
  @media (min-width: 768px) {
    .graph-wrap {
      display: grid;
      grid-template-columns: 1fr 10rem 1fr;
      grid-template-rows: auto auto auto;
      grid-template-areas:
        "cockpit  center-col  substrate"
        "building center-col  sandbox"
        "workloop workloop    workloop";
      gap: 1rem;
      align-items: start;
    }

    .graph-center-col {
      grid-area: center-col;
      order: 0;
      padding: 1rem 0.5rem;
      justify-content: center;
      align-items: center;
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .node--center {
      width: 100%;
    }

    .node--host {
      width: 100%;
    }

    .section-nodes--row {
      gap: 0.75rem;
    }

    .section-nodes--row .node {
      flex: 1;
      min-width: 8rem;
    }
  }

  /* ── Components list ── */
  .factory-components {
    margin-bottom: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .components-title {
    margin: 0 0 2rem;
    font-size: clamp(1.25rem, 3vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--content-bright);
  }

  .comp-group {
    margin-bottom: 2.25rem;
  }

  .comp-group-label {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-content);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .comp-group-sub {
    font-weight: 400;
    letter-spacing: 0.03em;
    text-transform: none;
    font-size: 0.6875rem;
    color: rgba(171, 196, 220, 0.4);
  }

  .comp-group-label--building-toward {
    border-bottom-style: dashed;
    color: rgba(171, 196, 220, 0.5);
  }

  .comp-group--building-toward .comp-list {
    opacity: 0.8;
  }

  .comp-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .comp-item {
    font-size: 0.9375rem;
    line-height: var(--line-height-relaxed);
    color: var(--base-content);
    max-width: 62ch;
    transition: color 200ms ease;
    scroll-margin-top: 2rem;
  }

  .comp-item--building-toward {
    color: var(--muted-content);
  }

  .comp-name {
    color: var(--content-bright);
  }

  .comp-item.is-emphasized .comp-name {
    color: var(--primary);
  }

  .factory-link {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-color: rgba(255, 127, 80, 0.4);
    text-underline-offset: 2px;
    transition: color var(--transition-base), text-decoration-color var(--transition-base);
  }

  .factory-link:hover {
    color: var(--primary-focus);
    text-decoration-color: var(--primary-focus);
  }

  /* ── Closing ── */
  .factory-closing {
    max-width: 52rem;
    margin-bottom: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .factory-closing p {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.1rem);
    line-height: var(--line-height-relaxed);
    color: var(--muted-content);
    font-style: italic;
    max-width: 60ch;
  }
</style>

<script>
(function () {
  'use strict';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const resetBtn = document.getElementById('graph-reset') as HTMLButtonElement | null;
  const graphWrap = document.getElementById('graph-wrap') as HTMLElement | null;
  const svgOverlay = document.getElementById('graph-svg-overlay') as SVGElement | null;

  if (!graphWrap || !svgOverlay) return;

  // ── Edge definition ──
  // Each edge: [fromNodeId, toNodeId, edgeId, isBuilding]
  const EDGE_DEFS: [string, string, string, boolean][] = [
    ['node-pi',    'node-host',    'edge-pi-host',       false],
    ['node-pi',    'node-beads',   'edge-pi-beads',      false],
    ['node-pi',    'node-memory',  'edge-pi-memory',     false],
    ['node-pi',    'node-ripcage', 'edge-pi-ripcage',    false],
    ['node-pi',    'node-ironproxy','edge-pi-ironproxy', false],
    ['node-pi',    'node-herdr',   'edge-pi-herdr',      false],
    ['node-pi',    'node-cmux',    'edge-pi-cmux',       false],
    ['node-pi',    'node-orch',    'edge-pi-orch',       false],
    ['node-pi',    'node-drover',  'edge-pi-drover',     false],
    ['node-orch',  'node-beads',   'edge-orch-beads',    false],
    ['node-orch',  'node-memory',  'edge-orch-memory',   false],
    ['node-orch',  'node-ripcage', 'edge-orch-ripcage',  false],
    ['node-herdr', 'node-orch',    'edge-herdr-orch',    false],
    ['node-herdr', 'node-cmux',    'edge-herdr-cmux',    false],
    ['node-ripcage','node-ironproxy','edge-rc-ip',       false],
    ['node-drover','node-beads',   'edge-drover-beads',  false],
    ['node-drover','node-orch',    'edge-drover-orch',   false],
    // self-driving has no explicit edge in the spec (it's a direction, not a wired component yet)
    ['node-mail',  'node-orch',    'edge-mail-orch',     true],
  ];

  // Node → which edges involve it
  const nodeEdgeMap = new Map<string, Set<string>>();
  // Edge → which nodes it connects
  const edgeNodeMap = new Map<string, [string, string]>();

  EDGE_DEFS.forEach(([a, b, id]) => {
    edgeNodeMap.set(id, [a, b]);
    if (!nodeEdgeMap.has(a)) nodeEdgeMap.set(a, new Set());
    if (!nodeEdgeMap.has(b)) nodeEdgeMap.set(b, new Set());
    nodeEdgeMap.get(a)!.add(id);
    nodeEdgeMap.get(b)!.add(id);
  });

  // SVG line elements
  const edgeEls = new Map<string, SVGLineElement>();

  function getNodeCenter(nodeId: string): { x: number; y: number } | null {
    const el = document.getElementById(nodeId);
    if (!el || !graphWrap) return null;
    const wrapRect = graphWrap.getBoundingClientRect();
    const nodeRect = el.getBoundingClientRect();
    return {
      x: nodeRect.left - wrapRect.left + nodeRect.width / 2,
      y: nodeRect.top - wrapRect.top + nodeRect.height / 2,
    };
  }

  function drawEdges() {
    if (!svgOverlay) return;
    // Clear existing
    while (svgOverlay.firstChild) svgOverlay.removeChild(svgOverlay.firstChild);
    edgeEls.clear();

    const SVG_NS = 'http://www.w3.org/2000/svg';

    EDGE_DEFS.forEach(([a, b, id, isBuilding]) => {
      const ca = getNodeCenter(a);
      const cb = getNodeCenter(b);
      if (!ca || !cb) return;

      const line = document.createElementNS(SVG_NS, 'line');
      line.setAttribute('x1', String(ca.x));
      line.setAttribute('y1', String(ca.y));
      line.setAttribute('x2', String(cb.x));
      line.setAttribute('y2', String(cb.y));
      line.setAttribute('id', id);
      line.setAttribute('fill', 'none');
      line.setAttribute('stroke-width', '1.5');
      if (isBuilding) {
        line.setAttribute('stroke', 'rgba(171, 196, 220, 0.14)');
        line.setAttribute('stroke-dasharray', '5 4');
      } else {
        line.setAttribute('stroke', 'rgba(171, 196, 220, 0.28)');
      }
      line.classList.add('graph-edge');
      if (isBuilding) line.classList.add('graph-edge--building-toward');
      svgOverlay.appendChild(line);
      edgeEls.set(id, line);
    });
  }

  // Draw on load and resize
  drawEdges();
  window.addEventListener('resize', () => {
    drawEdges();
    // Re-apply selection state after redraw if a node is selected
    if (selectedNodeId) {
      applySelection(selectedNodeId);
    }
  });

  // ── Interaction ──
  const allNodes = Array.from(document.querySelectorAll<HTMLElement>('.node'));
  let selectedNodeId: string | null = null;

  function clearAll() {
    allNodes.forEach(n => {
      n.classList.remove('is-selected', 'is-connected', 'is-dimmed');
      n.setAttribute('aria-pressed', 'false');
    });
    edgeEls.forEach((e) => {
      e.classList.remove('is-highlighted', 'is-dimmed');
      // Restore original stroke
      const isBuilding = e.classList.contains('graph-edge--building-toward');
      e.setAttribute('stroke', isBuilding ? 'rgba(171, 196, 220, 0.14)' : 'rgba(171, 196, 220, 0.28)');
      if (isBuilding) {
        e.setAttribute('stroke-dasharray', '5 4');
      } else {
        e.removeAttribute('stroke-dasharray');
      }
    });
    document.querySelectorAll('.comp-item').forEach(c => c.classList.remove('is-emphasized'));
    selectedNodeId = null;
    if (resetBtn) resetBtn.hidden = true;
  }

  function applySelection(nodeId: string) {
    const nodeEl = document.getElementById(nodeId);
    if (!nodeEl) return;

    const connectsAttr = nodeEl.dataset.connects || '';
    const connectedIds = connectsAttr ? connectsAttr.split(',').map(s => s.trim()) : [];
    const activeNodeIds = new Set([nodeId, ...connectedIds]);

    // Determine active edges
    const activeEdgeIds = new Set<string>();
    nodeEdgeMap.get(nodeId)?.forEach(edgeId => {
      const [a, b] = edgeNodeMap.get(edgeId) || [];
      if (activeNodeIds.has(a) && activeNodeIds.has(b)) {
        activeEdgeIds.add(edgeId);
      }
    });

    // Apply node states
    allNodes.forEach(n => {
      if (activeNodeIds.has(n.id)) {
        if (n.id === nodeId) {
          n.classList.add('is-selected');
          n.setAttribute('aria-pressed', 'true');
        } else {
          n.classList.add('is-connected');
        }
      } else {
        n.classList.add('is-dimmed');
      }
    });

    // Apply edge states
    const isBuilding = (el: SVGLineElement) => el.classList.contains('graph-edge--building-toward');
    edgeEls.forEach((el, id) => {
      if (activeEdgeIds.has(id)) {
        el.classList.add('is-highlighted');
        el.setAttribute('stroke', 'rgba(255, 127, 80, 0.7)');
        el.setAttribute('stroke-dasharray', 'none');
      } else {
        el.classList.add('is-dimmed');
        // opacity handled by CSS class
      }
    });

    // Emphasize component list entry
    const dataNode = nodeEl.dataset.node || '';
    const compEl = document.getElementById('comp-' + dataNode);
    if (compEl) {
      compEl.classList.add('is-emphasized');
      if (!prefersReducedMotion) {
        compEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }
  }

  function selectNode(nodeEl: HTMLElement) {
    const nodeId = nodeEl.id;
    if (selectedNodeId === nodeId) {
      clearAll();
      return;
    }
    clearAll();
    selectedNodeId = nodeId;
    applySelection(nodeId);
    if (resetBtn) resetBtn.hidden = false;
  }

  allNodes.forEach(nodeEl => {
    nodeEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a')) return;
      selectNode(nodeEl);
    });

    nodeEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectNode(nodeEl);
      }
    });
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', clearAll);
  }
})();
</script>
