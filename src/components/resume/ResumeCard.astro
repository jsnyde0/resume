---
interface Props {
  title?: string;
  tooltip?: string;
}

const { title, tooltip } = Astro.props;
---

<section class="resume-card">
  {title && (
    <div class="resume-card__header">
      <h2 class:list={["resume-card__title", tooltip && 'has-tooltip']} data-tooltip={tooltip}>{title}</h2>
    </div>
  )}
  <slot />
</section>

<style>
  .resume-card {
    margin-bottom: var(--space-8);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    box-shadow: var(--card-shadow);
    padding: var(--card-padding);
  }

  .resume-card__header {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-5);
  }

  .resume-card__title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .resume-card__title.has-tooltip {
    position: relative;
    cursor: help;
  }

  .resume-card__title.has-tooltip::after {
    content: attr(data-tooltip);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%);
    width: max-content;
    max-width: min(18rem, 80vw);
    border-radius: var(--radius-md);
    background: var(--tooltip-bg);
    color: var(--tooltip-text);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.35;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-base);
    z-index: 2;
    text-align: center;
  }

  .resume-card__title.has-tooltip:hover::after,
  .resume-card__title.has-tooltip:focus-visible::after {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .resume-card {
      padding: var(--card-padding-compact);
    }
  }
</style>
