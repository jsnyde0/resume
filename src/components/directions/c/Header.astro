---
// PROTOTYPE (resume-soe.12) — direction C header: logo sticker + two nav stickers.
interface Props {
  page: 'home' | 'resume';
}
const { page } = Astro.props;
---
<a class="c-skip" href="#main">Skip to content</a>
<header class="hdr">
  <a class="logo" href="/directions/c/" aria-label="Jonatan Snyders, home" aria-current={page === 'home' ? 'page' : undefined}>
    <span aria-hidden="true">JS</span>
  </a>
  <nav aria-label="Main">
    <ul>
      <li>
        <a class="nav-sticker nav-resume" href="/directions/c/resume/" aria-current={page === 'resume' ? 'page' : undefined}>Resume</a>
      </li>
      <li>
        <a class="nav-sticker nav-factory" href="/factory/">Factory</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .hdr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem clamp(1rem, 4vw, 3rem);
    max-width: 1440px;
    margin: 0 auto;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--c-sun);
    border: var(--line);
    box-shadow: 4px 4px 0 var(--c-ink);
    font-weight: 900;
    font-variation-settings: 'wdth' 125;
    font-size: 1.35rem;
    text-decoration: none;
    transform: rotate(-8deg);
    transition: transform 220ms var(--ease);
  }
  .logo:hover {
    transform: rotate(6deg) scale(1.06);
  }
  ul {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-sticker {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border: var(--line-thin);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--c-ink);
    font-family: var(--f-mono);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }
  .nav-resume {
    background: var(--c-white);
    transform: rotate(-2deg);
  }
  .nav-factory {
    background: var(--c-tomato);
    transform: rotate(3deg);
  }
  .nav-sticker:hover {
    transform: translate(-2px, -2px) rotate(0deg);
    box-shadow: 5px 5px 0 var(--c-ink);
  }
  .nav-sticker[aria-current='page'] {
    background: var(--c-sun);
  }
</style>
