---
import type { ProjectEntry } from '../../data/projects';
import ProjectsCarousel from './ProjectsCarousel.astro';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
---

<section class="project-block">
  <h2 class="project-block__title">{project.title}</h2>
  <div class:list={['project-block__content', project.reverseOnDesktop && 'project-block__content--reverse']}>
    <div class="project-block__carousel">
      <ProjectsCarousel carouselId={project.slug} title={project.title} images={project.images} />
    </div>

    <article class="project-panel">
      <p class="project-panel__description">{project.description}</p>

      <div class="project-panel__section">
        <h3>Technology</h3>
        <div class="project-panel__badges">
          {project.technologies.map((technology) => <span class="project-badge">{technology}</span>)}
        </div>
      </div>

      <div class="project-panel__section">
        <h3>Key Learnings</h3>
        <p>{project.learnings}</p>
      </div>

      {project.sourceCodeHref && (
        <div class="project-panel__actions">
          <a href={project.sourceCodeHref} target="_blank" rel="noreferrer" class="project-link-button">Source Code</a>
        </div>
      )}
    </article>
  </div>
</section>

<style>
  .project-block {
    margin-top: 3.5rem;
  }

  .project-block:first-of-type {
    margin-top: 0;
  }

  .project-block__title {
    margin: 0 0 1.5rem;
    text-align: center;
    font-size: clamp(1.8rem, 4vw, 2rem);
    line-height: 1.15;
    color: #f2f7fb;
  }

  .project-block__content {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  .project-panel {
    border-radius: 1.25rem;
    background: var(--base-200);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28);
    padding: 1.5rem;
  }

  .project-panel__description,
  .project-panel__section p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .project-panel__section {
    margin-top: 1.25rem;
  }

  .project-panel__section h3 {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
    color: #f2f7fb;
  }

  .project-panel__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .project-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--base-300);
    color: var(--base-content);
    padding: 0.45rem 0.8rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
  }

  .project-panel__actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .project-link-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--base-300);
    border-radius: 0.8rem;
    padding: 0.75rem 1rem;
    font-weight: 600;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .project-link-button:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(255, 127, 80, 0.08);
  }

  @media (min-width: 1024px) {
    .project-block__content {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 1fr);
      gap: 2rem;
    }

    .project-block__content--reverse .project-block__carousel {
      order: 2;
    }

    .project-block__content--reverse .project-panel {
      order: 1;
    }
  }
</style>
