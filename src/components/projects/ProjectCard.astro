---
import type { ProjectEntry } from '../../data/projects';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;

const tagLabel: Record<string, string> = {
  built: 'built',
  company: 'company',
  'in-progress': 'in progress',
};
const tagClass: Record<string, string> = {
  built: 'project-tag--built',
  company: 'project-tag--company',
  'in-progress': 'project-tag--in-progress',
};
---

<article class="project-panel">
  <header class="project-panel__header">
    <h2 class="project-panel__title">{project.title}</h2>
    <span class:list={['project-tag', tagClass[project.tag]]}>{tagLabel[project.tag]}</span>
  </header>

  {project.image && (
    <div class="project-panel__image">
      <img src={project.image.src} alt={project.image.alt} loading="lazy" />
    </div>
  )}

  <p class="project-panel__description">{project.description}</p>

  {project.technologies && project.technologies.length > 0 && (
    <div class="project-panel__badges">
      {project.technologies.map((tech) => <span class="project-badge">{tech}</span>)}
    </div>
  )}

  <div class="project-panel__actions">
    {project.links.map((link) =>
      link.external ? (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="project-link-button">
          {link.label}
        </a>
      ) : (
        <a href={link.href} class="project-link-button">
          {link.label}
        </a>
      )
    )}
  </div>
</article>

<style>
  .project-panel {
    border-radius: var(--radius-xl);
    background: var(--base-200);
    box-shadow: var(--shadow-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-panel__title {
    margin: 0;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    line-height: 1.2;
    color: var(--content-bright);
    font-weight: 700;
  }

  .project-panel__image {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--base-300);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    max-height: 8rem;
  }

  .project-panel__image img {
    max-height: 6rem;
    max-width: 100%;
    object-fit: contain;
  }

  .project-panel__description {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--base-content);
  }

  .project-panel__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--base-300);
    color: var(--base-content);
    padding: 0.35rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
  }

  .project-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .project-link-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--base-300);
    border-radius: 0.8rem;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--base-content);
    transition: background var(--transition-base), border-color var(--transition-base), color var(--transition-base);
  }

  .project-link-button:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-tint);
  }

  /* Tag chip */
  .project-tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .project-tag--built {
    background: var(--primary-tint);
    color: var(--primary);
    border: 1px solid var(--primary);
  }

  .project-tag--company {
    background: rgba(56, 189, 248, 0.1);
    color: var(--info);
    border: 1px solid var(--info);
  }

  .project-tag--in-progress {
    background: transparent;
    color: var(--muted-content);
    border: 1px dashed var(--muted-content);
  }
</style>
