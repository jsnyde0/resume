---
import type { ProjectEntry } from '../../data/projects';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const tagLabel = project.kind === 'built' ? 'built' : 'build on';
const tagClass = project.kind === 'built' ? 'project-tag--built' : 'project-tag--build-on';
---

<div class="project-row">
  <div class="project-row__main">
    {project.href ? (
      <a href={project.href} target="_blank" rel="noreferrer" class="project-row__title">{project.title}</a>
    ) : (
      <span class="project-row__title project-row__title--no-link">{project.title}</span>
    )}
    {project.author && (
      <span class="project-row__author">by {project.author}</span>
    )}
    <p class="project-row__description">{project.description}</p>
  </div>
  <span class:list={['project-tag', tagClass]}>{tagLabel}</span>
</div>

<style>
  .project-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--base-200);
    box-shadow: var(--shadow-card);
  }

  .project-row__main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .project-row__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--content-bright);
    text-decoration: none;
    line-height: 1.2;
  }

  .project-row__title:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .project-row__title--no-link {
    cursor: default;
  }

  .project-row__author {
    font-size: 0.85rem;
    color: var(--base-content);
    opacity: 0.7;
  }

  .project-row__description {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--base-content);
  }

  .project-tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .project-tag--built {
    background: var(--primary-tint, rgba(var(--primary-rgb, 99 102 241) / 0.15));
    color: var(--primary);
    border: 1px solid var(--primary);
  }

  .project-tag--build-on {
    background: var(--base-300);
    color: var(--base-content);
    border: 1px solid transparent;
  }
</style>
